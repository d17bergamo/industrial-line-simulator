@* Configurazione completa (2026-11-18): tutti i componenti e tutte le proprietà del programma Windows, dalle stesse
   descrizioni dei campi (UiProperty), con "Avanzate", valori ereditati dalla famiglia bloccati e le stesse regole di
   modifica (ProjectEditing). *@
@using System.Globalization
@using System.Reflection
@using LineSimulator.Core
@using LineSimulator.Engine
@using LineSimulator.Models

<div class="riga-titolo">
    <label class="campo largo">Componente
        <select value="@_sel" @onchange="Select">
            @foreach (var g in Nodes().GroupBy(n => n.Group))
            {
                <optgroup label="@g.Key">
                    @foreach (var n in g)
                    {
                        <option value="@n.Key">@n.Label</option>
                    }
                </optgroup>
            }
        </select>
    </label>
</div>
<GestioneComponenti Project="Project" SelectedModel="Model" ShowExtra="true" Changed="OnManaged" />
<Proprieta Project="Project" Model="Model" Changed="OnPropChanged" @key="Model" />
@if (_messages.Count > 0)
{
    <ul class="elenco">
        @foreach (var x in _messages) { <li>@x</li> }
    </ul>
}

@code {
    [Parameter, EditorRequired] public LineProject Project { get; set; } = null!;
    /// <summary>Chiamato dopo ogni modifica del progetto.</summary>
    [Parameter] public EventCallback Changed { get; set; }

    private string _sel = "project";
    private List<string> _messages = new();
    private LineProject? _last;

    private sealed record Node(string Key, string Group, string Label, object Model);

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_last, Project)) { _sel = "project"; _messages.Clear(); _last = Project; }
    }

    /// <summary>Componenti del progetto, nello stesso ordine dell'albero del programma Windows.</summary>
    private List<Node> Nodes()
    {
        var p = Project;
        var l = new List<Node> { new("project", "Progetto", "Progetto: " + p.Name, p) };
        l.Add(new("sec-family", "Moduli via a rulli", "Famiglia moduli (valori comuni)", p.SectionDefaults));
        foreach (var s in p.Sections.OrderBy(s => s.StartMm)) l.Add(new("sec:" + s.Id, "Moduli via a rulli", $"{s.Id} · {s.Name}", s));
        l.Add(new("pc-family", "Fotocellule", "Famiglia fotocellule (valori comuni)", p.PhotocellDefaults));
        foreach (var s in p.Photocells.OrderBy(s => s.PositionMm)) l.Add(new("pc:" + s.Id, "Fotocellule", $"{s.Id} · {s.Name}", s));
        if (p.Rejector.IsEnabled) l.Add(new("rejector", "Stazione di legatura", "Rigettatrice", p.Rejector));
        l.Add(new("station", "Stazione di legatura", "Stazione di legatura", p.StrappingStation));
        if (p.BundleClamp.IsEnabled) l.Add(new("clamp", "Stazione di legatura", "Stringifascio", p.BundleClamp));
        if (p.Compactor.IsEnabled) l.Add(new("compactor", "Stazione di legatura", "Compattatore laterale", p.Compactor));
        l.Add(new("st-family", "Stazione di legatura", "Famiglia legatrici (valori comuni)", p.StrapperDefaults));
        foreach (var s in p.Strappers) l.Add(new("st:" + s.Id, "Stazione di legatura", $"{s.Id} · {s.Name}", s));
        foreach (var s in p.IntermediateStops.OrderBy(s => s.PositionMm)) l.Add(new("fm:" + s.Id, "Trasferitore", $"{s.Id} · {s.Name}", s));
        l.Add(new("stopper", "Trasferitore", "Fermo finale", p.Stopper));
        l.Add(new("transfer", "Trasferitore", "Trasferitore sollevabile", p.Transfer));
        l.Add(new("accum", "Trasferitore", "Trasferitore d'accumulo", p.AccumulationTransfer));
        l.Add(new("sc-family", "Trasferitore", "Famiglia bilici (valori comuni)", p.ScaleDefaults));
        foreach (var s in p.Scales.OrderBy(s => s.StartMm)) l.Add(new("sc:" + s.Id, "Trasferitore", $"{s.Id} · {s.Name}", s));
        foreach (var s in p.PackageTypes) l.Add(new("pk:" + s.Id, "Pacchi e ingresso", $"Pacco {s.Id}", s));
        l.Add(new("infeed", "Pacchi e ingresso", "Ingresso pacchi", p.Infeed));
        foreach (var s in p.Rules) l.Add(new("rule:" + s.Id, "Regole logiche", $"{s.Id} · {s.Name}", s));
        l.Add(new("sim", "Simulazione", "Impostazioni simulazione", p.Simulation));
        return l;
    }

    private object? Model => Nodes().FirstOrDefault(n => n.Key == _sel)?.Model ?? Project;

    private void Select(ChangeEventArgs e)
    {
        _sel = e.Value?.ToString() ?? "project";
    }

    private async Task OnPropChanged()
    {
        var m = Model;
        _messages = ProjectEditing.Normalize(Project);
        // nomi e Id possono cambiare: si ritrova il componente per riferimento
        _sel = Nodes().FirstOrDefault(n => ReferenceEquals(n.Model, m))?.Key ?? _sel;
        await Changed.InvokeAsync();
    }

    private async Task OnManaged(object? added)
    {
        _messages = ProjectEditing.Normalize(Project);
        _sel = added == null ? "project" : Nodes().FirstOrDefault(n => ReferenceEquals(n.Model, added))?.Key ?? "project";
        await Changed.InvokeAsync();
    }

}
