<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <!--
    Versione web del simulatore: gira nel browser (anche del telefono) senza installazione.
    Usa lo stesso motore del programma Windows (Models, Core, Optimization, Engine) e, dell'infrastruttura, solo i file
    che servono (controlli automatici e lettura dei progetti JSON): i PDF e l'Excel restano nel programma Windows.
    Non fa parte delle soluzioni: la compila il workflow "Versione web".
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LineSimulator.Web</RootNamespace>
    <AssemblyName>LineSimulator.Web</AssemblyName>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <CompressionEnabled>false</CompressionEnabled>
    <BlazorEnableTimeZoneSupport>false</BlazorEnableTimeZoneSupport>
    <!-- Senza i dati ICU: i file .dat non si possono pubblicare come pagina. I numeri li formatta la pagina (virgola decimale). -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <PredefinedCulturesOnly>false</PredefinedCulturesOnly>
    <!-- Compilazione anticipata: il motore gira molto più veloce sul telefono (serve il workload wasm-tools). -->
    <RunAOTCompilation>true</RunAOTCompilation>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\LineSimulator.Models\LineSimulator.Models.csproj" />
    <ProjectReference Include="..\LineSimulator.Core\LineSimulator.Core.csproj" />
    <ProjectReference Include="..\LineSimulator.Optimization\LineSimulator.Optimization.csproj" />
    <ProjectReference Include="..\LineSimulator.Engine\LineSimulator.Engine.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\LineSimulator.Infrastructure\ProjectAutoFix.cs" Link="Infrastructure\ProjectAutoFix.cs" />
    <Compile Include="..\LineSimulator.Infrastructure\ProjectSerializer.cs" Link="Infrastructure\ProjectSerializer.cs" />
    <Compile Include="..\LineSimulator.Infrastructure\ProjectUpgrade.cs" Link="Infrastructure\ProjectUpgrade.cs" />
  </ItemGroup>
</Project>
