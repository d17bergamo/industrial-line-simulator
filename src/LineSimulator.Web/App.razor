    protected override void OnAfterRender(bool firstRender)
    {
        if (!_init3d || !_view3d || _engine == null) return;
        _init3d = false;
        var e = _engine;
        var scene = new Scene3D
        {
            StartM = e.Topology.LineStartM, EndM = e.Topology.LineEndM,
            PitchM = (e.Project.Sections.FirstOrDefault()?.RollerPitchMm ?? RollerSection.DefaultPitchMm) / 1000.0,
            StrokeM = _strokeM, AccM = _accM,
            TransferStartM = e.Transfer.StartM, TransferEndM = e.Transfer.EndM, StopperM = e.Stopper.PositionM,
            Bands = _bands,
            Strappers = e.Strappers.Select(s => s.PositionM).ToArray(),
            StrapperIds = e.Strappers.Select(s => s.Id).ToArray(),
            Photocells = e.Photocells.Select(p => p.PositionM).ToArray(),
            Stops = e.IntermediateStops.Select(s => s.PositionM).ToArray()
        };
        bool ok = false;
        try { ok = ((IJSInProcessRuntime)JS).Invoke<bool>("scena3d.init", "c3d", scene); } catch (Exception) { }
        if (!ok) { _no3d = true; StateHasChanged(); return; }
        Push3D();
    }

    private static int StateCode(PackageState s) => s switch
    {
        PackageState.Transport => 0,
        PackageState.Positioning or PackageState.Strapping => 1,
        PackageState.Aligning or PackageState.Aligned => 2,
        PackageState.Accumulated => 3,
        _ => 4
    };

    private void Push3D()
    {
        if (!_view3d || _no3d || _frame == null || _engine == null) return;
        var f = _frame;
        var packs = new double[f.Packages.Length * 7];
        var ids = new string[f.Packages.Length];
        for (int i = 0; i < f.Packages.Length; i++)
        {
            var p = f.Packages[i];
            int k = i * 7;
            packs[k] = p.HeadM; packs[k + 1] = p.LengthM; packs[k + 2] = p.LateralM; packs[k + 3] = p.LiftM;
            packs[k + 4] = StateCode(p.State); packs[k + 5] = p.GraphicWidthMm / 1000.0; packs[k + 6] = p.GraphicHeightMm / 1000.0;
            ids[i] = p.Id;
        }
        Js("scena3d.frame", new Frame3D
        {
            Speeds = _bands.Select(Speed).ToArray(),
            Strappers = f.StrapperStates.Select(s => s != StrapperState.Idle).ToArray(),
            Photocells = f.PhotocellOutputs.ToArray(),
            Stops = f.StopRaised.ToArray(),
            Packs = packs, Ids = ids
        });
    }

    private static string F(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);
    private static string N(double? v, string format) => v.HasValue && !double.IsNaN(v.Value) && !double.IsInfinity(v.Value) ? v.Value.ToString(format, CultureInfo.InvariantCulture).Replace('.', ',') : "–";

    private double Y(double xM) => Top + (xM - _lineStart) * _ky;

    private double Speed(Band b) => _frame == null ? 0 : b.Valle ? _frame.ValleSpeed : b.Zone < _frame.ZoneSpeeds.Length ? _frame.ZoneSpeeds[b.Zone] : 0;

    private static string BandFill(double v) => v > 0.45 ? "var(--rulli-marcia)" : Math.Abs(v) > 0.005 ? "var(--rulli-lenta)" : "var(--rulli)";

    private static string PackFill(PackageState s) => s switch
    {
        PackageState.Positioning or PackageState.Strapping => "var(--lega)",
        PackageState.Aligning or PackageState.Aligned => "var(--intesta)",
        PackageState.Accumulated => "var(--attesa)",
        PackageState.Transport => "var(--pacco)",
        _ => "var(--trasf)"
    };

    private async Task OnFile(InputFileChangeEventArgs e)
    {
        _errors.Clear();
        try
        {
            using var reader = new StreamReader(e.File.OpenReadStream(8_000_000));
            string json = await reader.ReadToEndAsync();
            ProjectSerializer.Deserialize(json);   // verifica che si legga
            _uploaded = json;
            _uploadedName = e.File.Name;
            Model = -1;
        }
        catch (Exception ex)
        {
            _errors.Add("Il file non è un progetto del simulatore: " + ex.Message);
        }
    }

    private LineProject BuildProject()
    {
        var p = ProjectSerializer.Clone(Work);
        p.Infeed.TypeSequence = _type == "*" ? p.PackageTypes.Select(t => t.Id).ToList() : new List<string> { _type };
        p.Infeed.PackageCount = _count;
        p.Infeed.Continuous = false;
        p.Simulation.RecordWindowS = 0;
        if (_stop && !p.IntermediateStops.Any(s => s.IsEnabled))
            p.IntermediateStops.Add(new IntermediateStopConfig
            {
                Id = "FM1", Name = "Fermo scomparente", Placement = DevicePlacement.Center,
                PositionMm = StrappingAreaRules.StopPositionMm(p, DevicePlacement.Center), AlignmentTimeS = 2.0
            });
        if (_double) BankingOptions.SetBankingAll(p, AccumulationMode.DoubleBanking);
        return p;
    }

    private async Task Run()
    {
        if (_busy) return;
        StopPlay();
        Js("scena3d.dispose");
        _busy = true; _progress = 0; _errors.Clear();
        _engine = null; _res = null; _frame = null;
        StateHasChanged();
        await Task.Delay(30);
        try
        {
            var p = BuildProject();
            var fix = ProjectAutoFix.Run(p);
            var e = new SimulationEngine(p);
            _changes = fix.Messages.Concat(e.Preparation.Changes).Distinct().ToList();
            _errors.AddRange(fix.Errors);
            _errors.AddRange(e.Preparation.Errors);
            _errors.AddRange(e.Validation.Errors.Select(i => i.Message));
            if (_errors.Count > 0)
            {
                var distinct = _errors.Distinct().ToList();
                _errors.Clear(); _errors.AddRange(distinct);
                return;
            }
            int n = 0;
            while (e.Step())
            {
                if (++n % 2000 != 0) continue;
                _progress = Math.Min(0.98, e.Packages.Count(k => k.ExitTimeS.HasValue) / (double)Math.Max(1, _count));
                StateHasChanged();
                await Task.Delay(1);
            }
            _res = e.ComputeResults();
            _events = e.Events.Where(x => x.Severity != EventSeverity.Trace).ToList();
            _lineStart = e.Topology.LineStartM;
            _ky = (VH - Top - 16) / Math.Max(1, e.Topology.LineEndM - e.Topology.LineStartM);
            _strokeM = p.Transfer.TranslationStrokeMm / 1000.0;
            _accM = p.AccumulationTransfer.IsEnabled ? p.AccumulationTransfer.WidthMm / 1000.0 : 0;
            _split = e.TransferSplitM;
            _bands = new List<Band>();
            for (int i = 0; i < e.Zones.Count; i++)
            {
                var z = e.Zones[i];
                bool split = e.TransferSplitM is double sp && e.Topology.StopperZone != null && z.Id == e.Topology.StopperZone.Id && sp > z.Info.StartM && sp < z.Info.EndM;
                if (split)
                {
                    _bands.Add(new Band(e.MonteInverterId ?? z.Id + "a", i, z.Info.StartM, e.TransferSplitM!.Value, false));
                    _bands.Add(new Band(z.Id, i, e.TransferSplitM!.Value, z.Info.EndM, true));
                }
                else _bands.Add(new Band(z.Id, i, z.Info.StartM, z.Info.EndM, false));
            }
            _end = e.Recorder.Frames.Count > 0 ? e.Recorder.Frames[^1].TimeS : e.Time;
            _t = 0;
            _frame = e.Recorder.FrameAt(0);
            _engine = e;
            _init3d = _view3d;
            _no3d = false;
        }
        catch (Exception ex)
        {
            _errors.Add("Errore durante la simulazione: " + ex.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    private void TogglePlay()
    {
        if (_playing) { StopPlay(); return; }
        if (_engine == null) return;
        if (_t >= _end - 0.05) _t = 0;
        _playing = true;
        _playCts = new CancellationTokenSource();
        _ = PlayLoop(_playCts.Token);
    }

    private void StopPlay()
    {
        _playing = false;
        _playCts?.Cancel();
        _playCts = null;
    }

    private async Task PlayLoop(CancellationToken ct)
    {
        const int tickMs = 70;
        var last = DateTime.UtcNow;
        while (!ct.IsCancellationRequested && _engine != null)
        {
            try { await Task.Delay(tickMs, ct); } catch (TaskCanceledException) { return; }
            var now = DateTime.UtcNow;
            double dt = Math.Min(0.5, (now - last).TotalSeconds);
            last = now;
            _t = Math.Min(_end, _t + dt * _speed);
            _frame = _engine.Recorder.FrameAt(_t);
            Push3D();
            if (_t >= _end - 1e-6) { _playing = false; _playCts = null; StateHasChanged(); return; }
            StateHasChanged();
        }
    }

    private void OnSeek(ChangeEventArgs e)
    {
        if (_engine == null) return;
        if (double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out double v))
        {
            _t = Math.Clamp(v, 0, _end);
            _frame = _engine.Recorder.FrameAt(_t);
            Push3D();
        }
    }

    /// <summary>Ultimi eventi fino all'istante mostrato (ricerca binaria: l'elenco è in ordine di tempo).</summary>
    private IEnumerable<SimEvent> RecentEvents()
    {
        int lo = 0, hi = _events.Count;
        while (lo < hi)
        {
            int mid = (lo + hi) / 2;
            if (_events[mid].TimeS <= _t) lo = mid + 1; else hi = mid;
        }
        for (int i = Math.Max(0, lo - 4); i < lo; i++) yield return _events[i];
    }

    public void Dispose()
    {
        StopPlay();
        Js("scena3d.dispose");
    }
