@* Versione web del simulatore: una sola pagina, pensata per il telefono. Usa il motore condiviso, nessuna logica propria. *@
@implements IDisposable
@inject IJSRuntime JS

<main>
    <header class="testa">
        <div class="titolo"><h1>Simulatore Linea</h1><small>@Work.Name@(_edited ? " (modificato)" : "")</small></div>
        <nav class="passi" aria-label="Vai alla zona">
            <button class="passo" @onclick='() => Go("linea")'>Linea</button>
            <button class="passo" @onclick='() => Go("pacchi")'>Pacchi</button>
            <button class="passo" @onclick='() => Go("simulazione")'>Simulazione</button>
            <button class="passo" @onclick='() => Go("risultati")'>Risultati</button>
            <button class="passo" @onclick='() => Go("uscite")'>Documenti</button>
        </nav>
        <div class="azioni">
            <button class="piccolo solo-ampio" @onclick='() => Js("zone.tutte", false)' title="Chiude tutte le zone">Comprimi tutto</button>
            <button class="piccolo solo-ampio" @onclick='() => Js("zone.tutte", true)' title="Apre tutte le zone">Espandi tutto</button>
            <button class="piccolo primario-p solo-ampio" @onclick='() => Go("uscite")'>⬇ Documenti</button>
            <button id="pronto" class="piccolo" @onclick="NextTheme">@(_theme == "scuro" ? "☀ Tema: scuro" : _theme == "chiaro" ? "🌙 Tema: chiaro" : "◐ Tema: auto")</button>
        </div>
    </header>
    <div class="zone-telefono">
        <button class="piccolo" @onclick='() => Js("zone.tutte", false)'>Comprimi tutto</button>
        <button class="piccolo" @onclick='() => Js("zone.tutte", true)'>Espandi tutto</button>
        <button class="piccolo primario-p" @onclick='() => Go("uscite")'>⬇ Documenti</button>
    </div>

    <details class="zona" open id="linea"><summary>Linea e configurazione</summary><div class="corpo">
        <div class="affiancati">
        <label class="campo">Parti da
            <select id="esempio" @bind="Model" disabled="@_busy">
                @for (int i = 0; i < SampleProjects.All.Count; i++)
                {
                    <option value="@i">@SampleProjects.All[i].Name</option>
                }
                <option value="-2">Layout personalizzato (da zero)</option>
                @if (_uploaded != null)
                {
                    <option value="-1">File: @_uploadedName</option>
                }
            </select>
        </label>
        <label class="campo">Oppure apri un progetto salvato (.json)
            <InputFile OnChange="OnFile" accept=".json" disabled="@_busy" />
        </label>
        </div>
        @if (_model == -2)
        {
            <div class="griglia">
                <label class="campo">Legatrici<input type="number" min="1" max="6" @bind="_cStrappers" /></label>
                <label class="campo">Pacco più lungo (m)<input type="number" min="3" max="30" @bind="_cMaxM" /></label>
                <label class="campo">Misure dei pacchi (m)<input type="text" @bind="_cLengths" placeholder="6, 9, 12" /></label>
            </div>
            <label class="spunta"><input type="checkbox" @bind="_cStop" /> Con fermo scomparente</label>
            <button @onclick="CreateCustom" disabled="@_busy">Crea il layout</button>
        }
        <p class="nota">In modifica: <b>@Work.Name</b>@(_edited ? " (modificato)" : "")</p>
        <div class="config-vista">
            <h3 class="categoria">Vista della configurazione</h3>
            <div class="comandi strumenti">
                <select value="" @onchange="AddFromView" aria-label="Aggiungi un componente alla linea">
                    <option value="">Aggiungi alla linea…</option>
                    @foreach (var (k, l) in ProjectEditing.Addable.Where(x => ViewAddable.Contains(x.Key)))
                    {
                        <option value="@k">@l</option>
                    }
                </select>
                <button class="piccolo" @onclick="DeleteFromView" disabled="@(SelectedComp == null || !ProjectEditing.CanDelete(SelectedComp))">Elimina @(SelectedComp == null ? "selezionato" : _selId)</button>
                <span class="nota">@(SelectedComp == null ? "Tocca un componente nel disegno per selezionarlo." : $"Selezionato: {_selId}")</span>
            </div>
            @if (_viewMsg.Length > 0) { <p class="nota">@_viewMsg</p> }
            @((MarkupString)ConfigSvg())
            <p class="nota">Si aggiorna a ogni modifica. Quote in mm tra i componenti; sotto, la lunghezza di ciascun modulo in metri. Trascina legatrici, fermi, fotocellule, trasferitore e fermo finale per spostarli (passi di 50 mm, fotocellule 10 mm); trascina la maniglia blu a fine modulo per allungarlo o accorciarlo.</p>
        </div>
        <h3 class="categoria">Configurazione dei componenti</h3>

        <div class="schede">
            <button class="@(_tab == 1 ? "attivo" : "")" @onclick="() => _tab = 1">Vie a rulli</button>
            <button class="@(_tab == 2 ? "attivo" : "")" @onclick="() => _tab = 2">Componenti</button>
            <button class="@(_tab == 3 ? "attivo" : "")" @onclick="() => _tab = 3">Tutte le proprietà</button>
        </div>
        @if (_tab == 1)
        {
            @foreach (var m in Work.Sections.OrderBy(x => x.StartMm).ToList())
            {
                <div class="riga-mod">
                    <div class="riga-titolo"><b>@m.Id</b> <span class="nota">@m.Name · @F(m.StartMm)–@F(m.EndMm) mm · @Rollers(m) rulli da @F(m.RollerPitchMm) mm</span></div>
                    <div class="griglia">
                        <label class="campo">Lunghezza modulo (m)<input type="number" step="@Mt(m.RollerPitchMm)" value="@Mt(m.LengthMm)" @onchange="e => SetSectionLength(m, e)" /></label>
                    </div>
                </div>
            }
            <p class="nota">Le lunghezze vanno a rulli interi; la linea a valle si sposta di conseguenza.</p>
        }
        else if (_tab == 3)
        {
            <Configurazione Project="Work" Changed="OnConfigChanged" />
        }
        else
        {
            <h2>Legatrici</h2>
            @foreach (var st in Work.Strappers.ToList())
            {
                <div class="griglia riga-mod">
                    <label class="campo">@st.Id (mm)<input type="number" step="50" value="@F(st.PositionMm)" @onchange="e => Edit(() => st.PositionMm = Num(e, st.PositionMm, 0, 200000))" /></label>
                    <label class="spunta"><input type="checkbox" checked="@st.IsEnabled" @onchange="e => Edit(() => st.IsEnabled = e.Value is true)" /> Abilitata</label>
                    <button class="piccolo" @onclick="() => Edit(() => Work.Strappers.Remove(st))">Elimina</button>
                </div>
            }
            <button @onclick="AddStrapper">Aggiungi legatrice</button>
            <h2 class="sopra">Fotocellule</h2>
            @foreach (var pc in Work.Photocells.OrderBy(x => x.PositionMm).ToList())
            {
                <div class="griglia riga-mod">
                    <label class="campo">@pc.Id · @pc.Name (mm)<input type="number" step="50" value="@F(pc.PositionMm)" @onchange="e => Edit(() => pc.PositionMm = Num(e, pc.PositionMm, 0, 200000))" /></label>
                    <label class="spunta"><input type="checkbox" checked="@pc.IsEnabled" @onchange="e => Edit(() => pc.IsEnabled = e.Value is true)" /> Abilitata</label>
                </div>
            }
            <h2 class="sopra">Fermo scomparente</h2>
            <label class="campo">Posizione
                <select value="@StopChoice" @onchange="SetStopChoice">
                    <option value="none">Nessuno</option>
                    <option value="center">Al centro del trasferitore</option>
                    <option value="end">All'estremità a monte (intestatura di coda)</option>
                    <option value="manual">A mano</option>
                </select>
            </label>
            @foreach (var fm in Work.IntermediateStops.ToList())
            {
                <label class="campo">@fm.Id (mm)<input type="number" step="50" value="@F(fm.PositionMm)" @onchange="e => Edit(() => { fm.PositionMm = Num(e, fm.PositionMm, 0, 200000); fm.ManualPosition = true; })" /></label>
            }
            <h2 class="sopra">Trasferitore e bilici</h2>
            <div class="griglia">
                <label class="campo">Trasferitore (mm)<input type="number" step="1250" value="@F(Work.Transfer.LengthMm)" @onchange="SetTransferLength" /></label>
                <label class="campo">Bilici
                    <select value="@Work.Scales.Count" @onchange="SetScales">
                        <option value="1">1</option>
                        <option value="2">2</option>
                    </select>
                </label>
                <label class="campo">Pesatura (s)<input type="number" step="1" value="@F(Work.Scales.FirstOrDefault()?.StabilizationTimeS ?? 0)" @onchange="SetWeighing" /></label>
            </div>
        }
        @if (_check.Count > 0 || _checkErrors.Count > 0)
        {
            <details open class="controlli">
                <summary>Controlli: @(_checkErrors.Count > 0 ? $"{_checkErrors.Count} errori, " : "")@_check.Count correzioni da applicare</summary>
                <ul class="elenco">
                    @foreach (var m in _checkErrors) { <li class="grave">@m</li> }
                    @foreach (var m in _check) { <li>@m</li> }
                </ul>
                <button @onclick="ApplyFix">Applica le correzioni al layout</button>
            </details>
        }
        else
        {
            <p class="esito ok">Controlli: nessuna correzione da fare.</p>
        }
        <div class="comandi">
            <button id="scarica" @onclick="Download">Copia il progetto (.json)</button>
            <button @onclick="ResetWork" disabled="@(!_edited)">Annulla le modifiche</button>
        </div>
        @if (_json != null)
        {
            <p class="nota">@_jsonNote</p>
            <textarea class="json" readonly rows="6" @onfocus="SelectJson" id="json-progetto">@_json</textarea>
        }

        <h3 class="categoria">Dati area</h3>
        <h4 class="sotto">1 · Obiettivo di produttività</h4>
        <div class="griglia">
            <label class="campo">Obiettivo (t/h)<input type="number" step="1" value="@F(Work.Simulation.TargetTonnesPerHour)" @onchange="e => Edit(() => Work.Simulation.TargetTonnesPerHour = Num(e, Work.Simulation.TargetTonnesPerHour, 0, 10000))" /></label>
        </div>
        <h4 class="sotto">2 · Velocità e azionamenti delle vie a rulli</h4>
        @{ var ordinate = Work.Sections.OrderBy(x => x.StartMm).ToList(); var trfMod = LayoutRules.TransferModule(Work); }
        @for (int i = 0; i < ordinate.Count; i++)
        {
            var m = ordinate[i];
            string ruolo = i == 0 ? "via di legatura" : ReferenceEquals(m, trfMod) ? "fronte accumulo" : "svincolo";
            <div class="riga-mod">
                <div class="griglia">
                    <label class="campo">@m.Id · @ruolo: velocità alta (m/s)<input type="number" step="0.05" value="@F(m.HighSpeed)" @onchange="e => Edit(() => m.HighSpeed = Num(e, m.HighSpeed, 0.05, 3))" /></label>
                </div>
                <p class="nota">Azionamento (deciso dal software): @StrappingAreaRules.DescribeDrive(Work, m)</p>
            </div>
        }
        <h4 class="sotto">3 · Tempi delle macchine, per famiglia</h4>
        <p class="nota">Valgono per tutte le macchine della famiglia; le eccezioni si impostano dalla singola macchina (Tutte le proprietà).</p>
        @foreach (var (titolo, modello) in Families())
        {
            <details class="famiglia"><summary>@titolo</summary>
                <Proprieta Project="Work" Model="modello" EssentialsOnly="true" Changed="OnFamilyChanged" />
            </details>
        }
    </div></details>

    <details class="zona" open id="pacchi"><summary>Pacchi</summary><div class="corpo">
        <div class="pacco-vista">
            <div class="schede">
                @foreach (var pt in Work.PackageTypes)
                {
                    string pid = pt.Id;
                    <button class="@(SelectedPack?.Id == pid ? "attivo" : "")" @onclick="() => _selPack = pid">@pid</button>
                }
            </div>
            <div class="pacco3d"><canvas id="cpack"></canvas></div>
            <div id="rpack" class="righello"></div>
            <div class="comandi">
                <button class="piccolo" @onclick='() => Js("pacco3d.view", "3d")'>3D</button>
                <button class="piccolo" @onclick='() => Js("pacco3d.view", "lato")'>Di lato</button>
                <button class="piccolo" @onclick='() => Js("pacco3d.view", "alto")'>Dall'alto</button>
                <span class="nota">Trascina il pacco per ruotare, rotellina per ingrandire; trascina una legatura (sul pacco o sul righello) per spostarla a passi di 50 mm. Quote in mm tra le legature.</span>
            </div>
        </div>
        @foreach (var t in Work.PackageTypes.ToList())
        {
            string? why = BankingOptions.DoubleBankingBlockReason(Work, t);
            bool dbl = why == null;
            var chosenBanking = BankingOptions.Banking(Work, t);
            <details class="riga-mod pacco-scheda @(SelectedPack?.Id == t.Id ? "scelto" : "")">
                <summary @onclick="() => _selPack = t.Id"><b>@t.Id</b> <span class="nota">@N(t.LengthMm / 1000, "0.#") m · @t.StrapPositionsMm.Count legature</span></summary>
                <div class="griglia">
                    <label class="campo">Lunghezza (mm)<input type="number" step="100" value="@F(t.LengthMm)" @onchange="e => SetLength(t, e)" /></label>
                    <label class="campo">Peso (kg)<input type="number" step="10" value="@F(t.WeightKg)" @onchange="e => Edit(() => t.WeightKg = Num(e, t.WeightKg, 1, 100000))" /></label>
                    <label class="campo">Legature<input type="number" min="1" max="20" value="@t.StrapCount" @onchange="e => SetStraps(t, e)" /></label>
                    <label class="campo">Tipo
                        <select value="@t.BindingType" @onchange="e => SetBinding(t, e)">
                            <option value="@BindingType.Wire">Filo</option>
                            <option value="@BindingType.SteelStrap">Reggetta</option>
                        </select>
                    </label>
                    <label class="campo">Banking
                        <select value="@chosenBanking" @onchange="e => Edit(() => t.Banking = Enum.Parse<AccumulationMode>(e.Value!.ToString()!))">
                            <option value="@AccumulationMode.SingleBanking">Single</option>
                            @if (dbl) { <option value="@AccumulationMode.DoubleBanking">Double</option> }
                        </select>
                    </label>
                    <label class="campo">Intestatura
                        <select value="@BankingOptions.ChosenHeading(Work, t)" @onchange="e => Edit(() => t.Heading = Enum.Parse<StopReference>(e.Value!.ToString()!))">
                            @if (BankingOptions.HeadingAvailable(Work, t, chosenBanking, StopReference.Head)) { <option value="@StopReference.Head">Di testa</option> }
                            @if (BankingOptions.HeadingAvailable(Work, t, chosenBanking, StopReference.Tail)) { <option value="@StopReference.Tail">Di coda</option> }
                        </select>
                    </label>
                </div>
                <h4 class="sotto">Posizione delle legature (mm dalla testa)</h4>
                <div class="griglia">
                    @{ var ord = t.StrapPositionsMm.OrderBy(x => x).ToList(); }
                    @for (int k = 0; k < ord.Count; k++)
                    {
                        int idx = k;
                        <label class="campo">Legatura @(k + 1)<input type="number" step="50" value="@F(ord[k])" @onchange="e => Edit(() => MoveStrapTo(t, idx, Num(e, ord[idx], 0, t.LengthMm)))" /></label>
                    }
                </div>
                <p class="nota">Distanze: @Gaps(t) mm</p>
                <button class="piccolo" @onclick="() => RemoveType(t)" disabled="@(Work.PackageTypes.Count < 2)">Elimina questo pacco</button>
            </details>
        }
        <div class="comandi">
            <button @onclick="AddType">Aggiungi pacco</button>
            @if (Work.PackageTypes.Any(x => BankingOptions.DoubleBankingAvailable(Work, x))) { <button @onclick="() => AllBanking(AccumulationMode.DoubleBanking)">Tutti double</button> }
            <button @onclick="() => AllBanking(AccumulationMode.SingleBanking)">Tutti single</button>
        </div>
    </div></details>

    <details class="zona" open id="simulazione"><summary>Simulazione</summary><div class="corpo">
        <label class="campo">Misura dei pacchi (una alla volta)
            <select id="misura" @bind="SimType" disabled="@_busy">
                @foreach (var t in Work.PackageTypes)
                {
                    <option value="@t.Id">@N(t.LengthMm / 1000, "0.#") m (@t.Id)</option>
                }
            </select>
        </label>
        <p class="nota">I pacchi entrano senza fine finché non fermi la simulazione. Banking, intestatura e fermi si impostano nelle zone Pacchi e Linea.</p>
        <button id="simula" class="primario" @onclick="Run" disabled="@_busy">@(_busy ? "Simulazione in corso…" : "Simula")</button>
        @if (_busy)
        {
            <div class="barra"><div class="barra-valore" style="width:@F(_progress * 100)%"></div></div>
        }
    </div></details>

    @if (_errors.Count > 0)
    {
        <section class="errore" id="errori">
            <b>La simulazione non può partire</b>
            <ul class="elenco">
                @foreach (var m in _errors)
                {
                    <li>@m</li>
                }
            </ul>
        </section>
    }

    @if (_engine != null && _res != null)
    {
        <details class="zona" open id="risultati"><summary>Risultato</summary><div class="corpo">
            <div class="numeri">
                <div class="numero"><b>@N(_res.TonnesPerHour, "0.0")</b><span>t/h</span></div>
                <div class="numero"><b>@N(_res.PackagesPerHour, "0.0")</b><span>pacchi/h</span></div>
                <div class="numero"><b>@N(_res.CycleTimeMeanS, "0.0")</b><span>s per pacco</span></div>
                <div class="numero @(_res.SlipEvents == 0 ? "ok" : "male")"><b>@_res.SlipEvents</b><span>strisciamenti</span></div>
                <div class="numero @(_res.Collisions == 0 ? "ok" : "male")"><b>@_res.Collisions</b><span>collisioni</span></div>
                <div class="numero"><b>@_res.PackagesExited/@_res.PackagesRequested</b><span>pacchi usciti</span></div>
            </div>
            @if (_res.Completed && !_res.HasProblems && _res.SlipEvents == 0)
            {
                <p class="esito ok">Simulazione pulita, durata @N(_res.SimulatedTimeS, "0") s.</p>
            }
            else
            {
                <p class="esito male">@(_res.Completed ? "Simulazione finita con anomalie." : "Simulazione non completata: " + _res.FinishReason)</p>
            }
            @if (!string.IsNullOrWhiteSpace(_res.BottleneckName))
            {
                <p class="esito">Collo di bottiglia: <b>@_res.BottleneckName</b>. @_res.BottleneckExplanation</p>
            }
            @if (_split != null)
            {
                <p class="esito">Via del trasferitore su due inverter, divisa a @N(_split * 1000, "0") mm.</p>
            }
            @if (_res.Problems.Count > 0)
            {
                <details open>
                    <summary>Anomalie (@_res.Problems.Count)</summary>
                    <ul class="elenco">
                        @foreach (var x in _res.Problems.Take(12))
                        {
                            <li>@N(x.TimeS, "0.0") s: @x.Message</li>
                        }
                    </ul>
                </details>
            }
            @if (_changes.Count > 0)
            {
                <details>
                    <summary>Correzioni automatiche applicate (@_changes.Count)</summary>
                    <ul class="elenco">
                        @foreach (var m in _changes)
                        {
                            <li>@m</li>
                        }
                    </ul>
                </details>
            }
        </div></details>

        <details class="zona" open id="vista"><summary>Vista della linea</summary><div class="corpo">
            <div class="schede">
                <button id="vista2d" class="@(_view3d ? "" : "attivo")" @onclick="() => SetView(false)">Dall'alto</button>
                <button id="vista3d" class="@(_view3d ? "attivo" : "")" @onclick="() => SetView(true)">3D</button>
            </div>
            @if (_view3d)
            {
                <div class="vista3d"><canvas id="c3d"></canvas></div>
                @if (_no3d)
                {
                    <p class="esito male">Su questo dispositivo la grafica 3D non è disponibile.</p>
                }
                <div class="comandi viste">
                    <button @onclick="@(() => View3D("insieme"))">Insieme</button>
                    <button @onclick="@(() => View3D("legatura"))">Legatura</button>
                    <button @onclick="@(() => View3D("trasferitore"))">Trasferitore</button>
                    <button @onclick="@(() => View3D("alto"))">Alto</button>
                </div>
                <p class="nota">Un dito ruota, due dita avvicinano e spostano.</p>
            }
            <svg class="vista" style="@(_view3d ? "display:none" : "")" viewBox="0 0 @VW @VH" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Vista dall'alto della linea">
                @* aree del trasferitore e dell'accumulo *@
                <g>
                    <rect x="@F(BandX)" y="@F(Y(_engine.Transfer.StartM))" width="@F(BandW + _strokeM * KX)" height="@F((_engine.Transfer.EndM - _engine.Transfer.StartM) * _ky)"
                          fill="none" stroke="var(--bordo)" stroke-dasharray="6 5" stroke-width="2" rx="4" />
                    @if (_accM > 0)
                    {
                        <rect x="@F(BandX + _strokeM * KX)" y="@F(Y(_engine.Transfer.StartM))" width="@F(BandW + _accM * KX)" height="@F((_engine.Transfer.EndM - _engine.Transfer.StartM) * _ky)"
                              fill="none" stroke="var(--bordo)" stroke-width="2" rx="4" />
                    }
                </g>
                @* vie a rulli: un rettangolo per inverter, colore secondo la velocità *@
                @foreach (var b in _bands)
                {
                    <g>
                        <rect x="@F(BandX)" y="@F(Y(b.StartM) + 1)" width="@F(BandW)" height="@F(Math.Max(1, (b.EndM - b.StartM) * _ky - 2))" rx="3" fill="@BandFill(Speed(b))" />
                        <text x="4" y="@F(Y(b.StartM) + 22)" font-size="20">@b.Id</text>
                        <text x="4" y="@F(Y(b.StartM) + 44)" font-size="17">@N(Speed(b), "0.00")</text>
                    </g>
                }
                @* legatrici *@
                @for (int i = 0; i < _engine.Strappers.Count; i++)
                {
                    var s = _engine.Strappers[i];
                    bool work = _frame != null && i < _frame.StrapperStates.Length && _frame.StrapperStates[i] != StrapperState.Idle;
                    <g>
                        <rect x="@F(BandX - 10)" y="@F(Y(s.PositionM) - 5)" width="@F(BandW + 20)" height="10" rx="3" fill="@(work ? "var(--lega)" : "var(--macchina)")" opacity="@(work ? "1" : "0.75")" />
                        <text x="@F(BandX + BandW + 16)" y="@F(Y(s.PositionM) + 7)" font-size="19">@s.Id</text>
                    </g>
                }
                @* fotocellule *@
                @for (int i = 0; i < _engine.Photocells.Count; i++)
                {
                    bool on = _frame != null && i < _frame.PhotocellOutputs.Length && _frame.PhotocellOutputs[i];
                    <g><circle cx="@F(BandX - 9)" cy="@F(Y(_engine.Photocells[i].PositionM))" r="6" fill="@(on ? "var(--fc-on)" : "var(--fc)")" /></g>
                }
                @* fermi scomparenti e fermo finale *@
                @for (int i = 0; i < _engine.IntermediateStops.Count; i++)
                {
                    bool up = _frame != null && i < _frame.StopRaised.Length && _frame.StopRaised[i];
                    <g><rect x="@F(BandX - 4)" y="@F(Y(_engine.IntermediateStops[i].PositionM) - 2.5)" width="@F(BandW + 8)" height="5" fill="@(up ? "var(--errore)" : "var(--attesa)")" opacity="@(up ? "1" : "0.5")" /></g>
                }
                <g><rect x="@F(BandX - 6)" y="@F(Y(_engine.Stopper.PositionM))" width="@F(BandW + 12)" height="7" fill="var(--errore)" /></g>
                @* pacchi *@
                @if (_frame != null)
                {
                    @foreach (var p in _frame.Packages)
                    {
                        double h = Math.Max(8, p.LengthM * _ky);
                        <g>
                            <rect x="@F(BandX + 6 + p.LateralM * KX)" y="@F(Y(p.HeadM - p.LengthM))" width="@F(BandW - 12)" height="@F(h)" rx="5" fill="@PackFill(p.State)" />
                            <text class="et-pacco" x="@F(BandX + BandW / 2 + p.LateralM * KX)" y="@F(Y(p.HeadM - p.LengthM / 2) + 7)" font-size="19" text-anchor="middle">@p.Id</text>
                        </g>
                    }
                }
            </svg>

            <div class="comandi">
                <button id="play" @onclick="TogglePlay">@(_playing ? "Pausa" : "Avvia")</button>
                @foreach (var v in Speeds)
                {
                    <button class="@(v == _speed ? "attivo" : "")" @onclick="() => _speed = v">×@(v)</button>
                }
            </div>
            <div class="tempo">@N(_t, "0.0") s · in diretta @N(_end, "0") s</div>
            <input type="range" min="@F(_winStart)" max="@F(_end)" step="0.5" value="@F(_t)" @oninput="OnSeek" aria-label="Tempo della simulazione" />

            <div class="eventi">
                @foreach (var x in RecentEvents())
                {
                    <div class="@(x.Severity == EventSeverity.Error ? "grave" : x.Severity == EventSeverity.Warning ? "avviso" : "")">@N(x.TimeS, "0.0") s · @x.Message</div>
                }
            </div>
            <div class="legenda">
                <span><i style="background:var(--rulli-marcia)"></i>rulli in marcia</span>
                <span><i style="background:var(--rulli-lenta)"></i>rulli lenti</span>
                <span><i style="background:var(--lega)"></i>legatura</span>
                <span><i style="background:var(--intesta)"></i>intestatura</span>
                <span><i style="background:var(--trasf)"></i>sul trasferitore</span>
                <span><i style="background:var(--fc-on)"></i>fotocellula occupata</span>
            </div>
        </div></details>

        <details class="zona" open id="pacchisim"><summary>Ultimi pacchi simulati (di @_res.Packages.Count)</summary><div class="corpo">
            <div>
                <table class="pacchi">
                    <thead><tr><th>Pacco</th><th>m</th><th>ingresso s</th><th>uscita s</th><th>attesa s</th><th>legature</th></tr></thead>
                    <tbody>
