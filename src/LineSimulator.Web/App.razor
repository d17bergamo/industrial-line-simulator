    /// <summary>Chiamato da configvista.js al rilascio di un componente trascinato nella vista 2D (spostamento in mm).</summary>
    [JSInvokable]
    public void MoveComponent(string kind, string id, double deltaMm)
    {
        static double Snap(double v, double step) => Math.Max(0, Math.Round(v / step) * step);
        object? model = null;
        Edit(() =>
        {
            switch (kind)
            {
                case "strapper": { var c = Work.Strappers.FirstOrDefault(x => x.Id == id); if (c != null) { c.PositionMm = Snap(c.PositionMm + deltaMm, 50); model = c; } break; }
                case "stop": { var c = Work.IntermediateStops.FirstOrDefault(x => x.Id == id); if (c != null) { c.PositionMm = Snap(c.PositionMm + deltaMm, 50); model = c; } break; }
                case "photocell": { var c = Work.Photocells.FirstOrDefault(x => x.Id == id); if (c != null) { c.PositionMm = Snap(c.PositionMm + deltaMm, 10); model = c; } break; }
                case "clamp": if (!Work.BundleClamp.PerMachine) { Work.BundleClamp.PositionMm = Snap(Work.BundleClamp.PositionMm + deltaMm, 50); model = Work.BundleClamp; } break;
                case "compactor": Work.Compactor.PositionMm = Snap(Work.Compactor.PositionMm + deltaMm, 50); model = Work.Compactor; break;
                case "rejector": Work.Rejector.PositionMm = Snap(Work.Rejector.PositionMm + deltaMm, 50); model = Work.Rejector; break;
                case "stopper": Work.Stopper.PositionMm = Snap(Work.Stopper.PositionMm + deltaMm, 50); model = Work.Stopper; break;
                case "transfer": Work.Transfer.PositionMm = Snap(Work.Transfer.PositionMm + deltaMm, 50); model = Work.Transfer; break;
                case "sezione": { var c = Work.Sections.FirstOrDefault(x => x.Id == id); if (c != null) ResizeSection(c, c.LengthMm + deltaMm); break; }
            }
            if (model != null) ProjectEditing.AfterEdit(Work, model, model is WeighingScaleConfig ? "StartMm" : "PositionMm");
            ProjectEditing.Normalize(Work);
        });
        StateHasChanged();
    }

