@* Versione web del simulatore: quattro passi (Progetto, Pacchi, Linea, Simulazione) come nel mock-up. Usa il motore condiviso, nessuna logica propria. *@
@implements IDisposable
@inject IJSRuntime JS

<header class="testa">
    <div class="marca"><span class="logo">S</span><b>Simulatore Linea</b></div>
    <nav class="passi" aria-label="Passi">
        <button id="tab-progetto" class="passo @(_tab == 0 ? "attivo" : "")" @onclick="() => SetTab(0)">1 · Progetto</button>
        <button id="tab-pacchi" class="passo @(_tab == 1 ? "attivo" : "")" @onclick="() => SetTab(1)">2 · Pacchi</button>
        <button id="tab-linea" class="passo @(_tab == 2 ? "attivo" : "")" @onclick="() => SetTab(2)">3 · Linea</button>
        <button id="tab-simulazione" class="passo @(_tab == 3 ? "attivo" : "")" @onclick="() => SetTab(3)">4 · Simulazione</button>
    </nav>
    <button id="scarica" class="contorno" @onclick="SaveFile">Scarica progetto</button>
</header>

<main class="pagina">

    @* ================= PASSO 1: PROGETTO ================= *@
    <section class="scheda" id="scheda-0" hidden="@(_tab != 0)">
        <div class="titolo-pagina"><h1>Progetto</h1><p>Dai un nome al progetto e indica il risultato che la linea deve garantire.</p></div>

        <div class="blocco">
            <label class="etichetta" for="nome-progetto">Nome del progetto</label>
            <input id="nome-progetto" class="nome-grande" type="text" placeholder="Scrivi il nome del progetto" value="@(_nameTouched ? Work.Name : "")" @onchange='e => { _nameTouched = true; Edit(() => Work.Name = e.Value?.ToString() ?? ""); }' />
        </div>

        <div class="riga-blocchi">
            <div class="blocco largo-380">
                <div class="etichetta">Parti da</div>
                <div class="scelte">
                    @for (int i = 0; i < SampleProjects.All.Count; i++)
                    {
                        int k = i;
                        <button class="scelta @(_model == k ? "attiva" : "")" disabled="@_busy" @onclick="() => Model = k">@SampleProjects.All[k].Name</button>
                    }
                    <button class="scelta @(_model == -2 ? "attiva" : "")" disabled="@_busy" @onclick="() => Model = -2">Layout da zero</button>
                    <label class="scelta file @(_model == -1 ? "attiva" : "")">Apri un file .json<InputFile OnChange="OnFile" accept=".json" disabled="@_busy" /></label>
                </div>
                @if (_model == -1 && _openChanges.Count > 0)
                {
                    <p class="nota">Il progetto aperto è stato aggiornato alle regole attuali (@_openChanges.Count righe): il file originale non cambia.</p>
                }
                @if (_model == -2)
                {
                    <div class="griglia">
                        <label class="campo">Legatrici<input type="number" min="1" max="6" @bind="_cStrappers" /></label>
                        <label class="campo">Pacco più lungo (m)<input type="number" min="3" max="30" @bind="_cMaxM" /></label>
                        <label class="campo">Misure dei pacchi (m)<input type="text" @bind="_cLengths" placeholder="6, 9, 12" /></label>
                    </div>
                    <label class="spunta"><input type="checkbox" @bind="_cStop" /> Con fermo scomparente</label>
                    <button class="scuro" @onclick="CreateCustom" disabled="@_busy">Crea il layout</button>
                }
            </div>
            <div class="blocco largo-560">
                <div class="riga-obiettivo">
                    <div>
                        <label class="etichetta" for="obiettivo">Produttività</label>
                        <div class="grande-valore"><input id="obiettivo" inputmode="decimal" value="@F(Work.Simulation.TargetTonnesPerHour)" @onchange="e => Edit(() => Work.Simulation.TargetTonnesPerHour = Num(e, Work.Simulation.TargetTonnesPerHour, 0, 10000))" /><span>t/h</span></div>
                    </div>
                    <div>
                        <label class="etichetta" for="safety">Safety</label>
                        <div class="grande-valore"><input id="safety" inputmode="decimal" value="@F(Work.Simulation.SafetyPercent)" @onchange="e => Edit(() => Work.Simulation.SafetyPercent = Num(e, Work.Simulation.SafetyPercent, 0, 200))" /><span>%</span></div>
                    </div>
                </div>
                <p class="nota">Da garantire: @N(Work.Simulation.EffectiveTargetTonnesPerHour, "0.#") t/h</p>
            </div>
        </div>

        <div class="blocco">
            <div class="titolo-blocco"><h2>Layout</h2></div>
            <div class="config-vista bozza">@((MarkupString)ConfigSvg(true))</div>
        </div>

        <div class="avanti"><button class="scuro grande" @onclick="() => SetTab(1)">Pacchi →</button></div>
    </section>

    @* ================= PASSO 2: PACCHI ================= *@
    <section class="scheda" id="scheda-1" hidden="@(_tab != 1)">
        <div class="titolo-pagina"><h1>Pacchi</h1><p>Indica i tipi di pacco da legare: lunghezza, peso, legature e come devono essere lavorati.</p></div>

        <div class="blocco" id="pacchi">
            <div class="titolo-blocco"><h2>Tipologie di pacco</h2><button class="azzurro" @onclick="AddType">+ Aggiungi pacco</button></div>
            <div class="tabella-scroll">
                <table class="tabella configurazioni">
                    <thead><tr><th>Pacco</th><th>Lungh. (m)</th><th>Peso (kg)</th><th>Legature</th><th>Tipo</th><th>Banking</th><th>Intestatura</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var (t, ti) in Work.PackageTypes.ToList().Select((x, i) => (x, i)))
                        {
                            bool dbl = BankingOptions.DoubleBankingBlockReason(Work, t) == null;
                            var chosenBanking = BankingOptions.Banking(Work, t);
                            <tr class="@(SelectedPack?.Id == t.Id ? "scelto" : "")">
                                <td><button class="nome-pacco" @onclick="() => _selPack = t.Id"><span class="quadrato" style="background:@PackColor(ti)"></span>@t.Id</button></td>
                                <td><input class="cella" inputmode="decimal" value="@Mt(t.LengthMm)" @onchange="e => SetLengthM(t, e)" /></td>
                                <td><input class="cella" inputmode="decimal" value="@F(t.WeightKg)" @onchange="e => Edit(() => t.WeightKg = Math.Round(Num(e, t.WeightKg, 1, 100000), 1))" /></td>
                                <td><input class="cella stretta" type="number" min="1" max="20" value="@t.StrapCount" @onchange="e => SetStraps(t, e)" /></td>
                                <td>
                                    <select class="cella" value="@t.BindingType" @onchange="e => SetBinding(t, e)">
                                        <option value="@BindingType.Wire">Filo</option>
                                        <option value="@BindingType.SteelStrap">Reggetta</option>
                                    </select>
                                </td>
                                <td>
                                    <select class="cella" value="@chosenBanking" @onchange="e => Edit(() => t.Banking = Enum.Parse<AccumulationMode>(e.Value!.ToString()!))">
                                        <option value="@AccumulationMode.SingleBanking">Single</option>
                                        @if (dbl) { <option value="@AccumulationMode.DoubleBanking">Double</option> }
                                    </select>
                                </td>
                                <td>
                                    <select class="cella" value="@BankingOptions.ChosenHeading(Work, t)" @onchange="e => Edit(() => t.Heading = Enum.Parse<StopReference>(e.Value!.ToString()!))">
                                        @if (BankingOptions.HeadingAvailable(Work, t, chosenBanking, StopReference.Head)) { <option value="@StopReference.Head">Testa</option> }
                                        @if (BankingOptions.HeadingAvailable(Work, t, chosenBanking, StopReference.Tail)) { <option value="@StopReference.Tail">Coda</option> }
                                    </select>
                                </td>
                                <td><button class="elimina" @onclick="() => RemoveType(t)" disabled="@(Work.PackageTypes.Count < 2)" aria-label="Elimina @t.Id">×</button></td>
                            </tr>
                            @if (!dbl)
                            {
                                <tr class="riga-nota"><td colspan="8" class="nota piccola">@t.Id · double banking non ammesso: @BankingOptions.DoubleBankingBlockReason(Work, t)</td></tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <p class="nota">Le scelte non possibili non compaiono e la riga sotto spiega il motivo.</p>
        </div>

        @if (SelectedPack is { } sp)
        {
            var qs = Quotes(sp);
            <div class="blocco">
                <div class="titolo-blocco">
                    <h2>Anteprima: @sp.Id</h2>
                    <div class="commutatore">
                        <button class="@(_pv2d ? "attivo" : "")" @onclick="() => SetPackView(true)">2D</button>
                        <button class="@(_pv2d ? "" : "attivo")" @onclick="() => SetPackView(false)">3D</button>
                    </div>
                </div>
                <div class="pacco3d"><canvas id="cpack"></canvas></div>
                <div id="rpack" class="righello"></div>
                <div class="legature-ctrl">
                    <h3>Legature: @sp.StrapPositionsMm.Count</h3>
                    <button class="quadro" @onclick="() => StrapMinus(sp)" disabled="@(sp.StrapPositionsMm.Count < 2)" aria-label="Togli una legatura">−</button>
                    <button class="quadro azzurro" @onclick="() => StrapPlus(sp)" disabled="@(sp.StrapPositionsMm.Count >= 20)" aria-label="Aggiungi una legatura">+</button>
                </div>
                <p class="nota">Trascina le legature sul modello o sul righello. Il + inserisce una legatura nel tratto più lungo, il − toglie l'ultima.</p>
                <h3 class="sotto-titolo">Quote tra le legature</h3>
                <p class="nota">Scrivi un valore in mm e premi Invio: si sposta la legatura a destra della quota. L'ultima quota sposta l'ultima legatura. I valori si arrotondano a 50 mm.</p>
                <div class="quote-leg">
                    @for (int qi = 0; qi < qs.Count; qi++)
                    {
                        int q = qi;
                        <label class="campo">@QuoteLabel(qs.Count, q)
                            <span class="con-unita"><input type="number" step="50" value="@F(qs[q])" @onchange="e => SetQuote(sp, q, e)" /> mm</span>
                        </label>
                    }
                </div>
            </div>
        }

        <div class="avanti due">
            <button class="chiaro grande" @onclick="() => SetTab(0)">← Progetto</button>
            <button class="scuro grande" @onclick="() => SetTab(2)">Linea →</button>
        </div>
    </section>

    @* ================= PASSO 3: LINEA ================= *@
    <section class="scheda" id="scheda-2" hidden="@(_tab != 2)">
        <div class="titolo-pagina"><h1>Com'è fatta la linea</h1><p>Vista dall'alto. Tocca un componente per aprire le sue proprietà in una piccola finestra; trascina le macchine, allunga le vie con la maniglia a fine modulo.</p></div>

        <div class="riga-linea">
            <aside class="aggiungi-pannello">
                <div class="etichetta">Aggiungi</div>
                <button @onclick='() => AddComp("strapper")'>+ Legatrice</button>
                <button @onclick='() => AddComp("clamp")'>+ Stringifascio</button>
                <button @onclick='() => AddComp("compactor")'>+ Compattatore</button>
                <button @onclick='() => AddComp("section")'>+ Via a rulli</button>
                <button @onclick='() => AddComp("stop-center")'>+ Fermo scomparente</button>
                <button @onclick='() => AddComp("scale-center")'>+ Bilico</button>
                <button @onclick='() => AddComp("photocell")'>+ Fotocellula</button>
                @if (_msg.Length > 0) { <p class="nota">@_msg</p> }
            </aside>
            <div class="blocco disegno" id="linea">
                <div class="config-vista">@((MarkupString)ConfigSvg())</div>
            </div>
        </div>

        <div class="riga-blocchi">
            <div class="blocco largo-420">
                <h2>Controlli</h2>
                @if (_check.Count > 0 || _checkErrors.Count > 0)
                {
                    <div class="semaforo"><span class="pallino giallo"></span><b>@(_checkErrors.Count + _check.Count) @((_checkErrors.Count + _check.Count) == 1 ? "avviso" : "avvisi")</b></div>
                    <ul class="elenco">
                        @foreach (var m in _checkErrors) { <li class="grave">@m</li> }
                        @foreach (var m in _check) { <li>@m</li> }
                    </ul>
                    <button class="azzurro grande" @onclick="ApplyFix">Sistema automaticamente</button>
                    <p class="nota">Prima di cambiare qualcosa vedi l'elenco delle modifiche.</p>
                }
                else
                {
                    <div class="semaforo"><span class="pallino verde"></span><b>Linea a posto: 0 avvisi, 0 errori</b></div>
                    @if (_fixList.Count > 0)
                    {
                        <div class="sotto-titolo">Modifiche applicate</div>
                        <ul class="elenco">@foreach (var m in _fixList) { <li>@m</li> }</ul>
                        <button class="chiaro" @onclick="UndoFix">Annulla le modifiche</button>
                    }
                }
            </div>
            <div class="blocco largo-420">
                <h2>Fotocellule</h2>
                <table class="tabella">
                    <tbody>
                        @foreach (var pc in Work.Photocells.OrderBy(x => x.PositionMm))
                        {
                            <tr>
                                <td class="id">@pc.Id</td>
                                <td><span class="chip @(pc.IsAutoGenerated ? "chip-azzurro" : "chip-giallo")">@(pc.IsAutoGenerated ? "Automatica" : "Presenza")</span></td>
                                <td class="nota-cella">@PhotocellAudit.Role(pc)</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <p class="nota">Quelle automatiche le decide il programma in base ai pacchi. Tu aggiungi solo quelle di presenza.</p>
            </div>
        </div>

        <div class="avanti due">
            <button class="chiaro grande" @onclick="() => SetTab(1)">← Pacchi</button>
            <button class="scuro grande" @onclick="() => SetTab(3)">Simulazione →</button>
        </div>
    </section>

    @if (_tab == 2 && _propOpen && SelectedComp is { } sc)
    {
        <div class="velo" @onclick="CloseProp"></div>
        <aside class="modale" role="dialog" aria-label="Proprietà del componente">
            <div class="modale-testa"><h2>@CompTitle(sc)</h2><button class="chiudi" @onclick="CloseProp" aria-label="Chiudi">×</button></div>
            <div class="modale-corpo">
                @if (sc is PhotocellConfig { IsAutoGenerated: true }) { <p class="nota">Fotocellula automatica: la mette il programma in base ai pacchi. Si aggiungono solo fotocellule di presenza.</p> }
                @if (ProjectEditing.IsProtectedSection(Work, sc)) { <p class="nota">La via a rulli di legatura e quella davanti al trasferitore non si possono rimuovere.</p> }
                <Proprieta Project="Work" Model="sc" Changed="OnPropChanged" @key="sc" />
            </div>
            <div class="modale-pie">
                <button class="pericolo" @onclick="RemoveSel" disabled="@(!CanRemoveSel(sc))">Rimuovi</button>
                <button class="scuro" @onclick="CloseProp">Fatto</button>
            </div>
        </aside>
    }

    @* ================= PASSO 4: SIMULAZIONE ================= *@
    <section class="scheda" id="scheda-3" hidden="@(_tab != 3)">
        <div class="titolo-pagina"><h1>Simulazione e risultati</h1><p>Una misura alla volta. Scegli quanti pacchi simulare e premi Simula.</p></div>

        <div class="blocco barra-sim" id="simulazione">
            <div class="gruppo-sim">
                <span class="etichetta">Lunghezza pacco</span>
                @foreach (var t in Work.PackageTypes)
                {
                    string tid = t.Id;
                    <button class="scelta @(SimType == tid ? "attiva" : "")" disabled="@_busy" @onclick="() => SimType = tid">@N(t.LengthMm / 1000, "0.#") m</button>
                }
            </div>
            <div class="gruppo-sim">
                <span class="etichetta">Pacchi</span>
                @foreach (var (v, lbl) in new[] { ("10", "10"), ("20", "20"), ("50", "50"), ("continua", "Continua") })
                {
                    string vv = v;
                    <button class="scelta @(_simCount == vv ? "attiva" : "")" disabled="@_busy" @onclick="() => _simCount = vv">@lbl</button>
                }
            </div>
            <button id="simula" class="verde grande spinto" @onclick="Run" disabled="@_busy">@(_busy ? "Simulazione in corso…" : "Simula")</button>
        </div>
        @if (_busy)
        {
            <div class="barra"><div class="barra-valore" style="width:@F(_progress * 100)%"></div></div>
        }
        @if (_errors.Count > 0)
        {
            <section class="errore" id="errori">
                <b>La simulazione non può partire</b>
                <ul class="elenco">
                    @foreach (var m in _errors) { <li>@m</li> }
                </ul>
            </section>
        }

        @if (_engine != null && _res != null)
        {
            double goalEff = Work.Simulation.EffectiveTargetTonnesPerHour;
            bool reached = goalEff <= 0 || _res.TonnesPerHour >= goalEff;
            <div class="riga-risultati">
                <h3>Risultati della misura selezionata: @SelName</h3>
                <Uscite Mode="obiettivo" Project="Work" Engine="_engine" Results="_res" Replace="ReplaceWork" />
            </div>
            <div id="risultati" class="kpi">
                <div class="kpi-carta verde-b">
                    <div class="kpi-nome">Produttività</div>
                    <div class="kpi-valore">@N(_res.TonnesPerHour, "0.0") <small>t/h</small></div>
                    <div class="kpi-nota">@(goalEff > 0 ? $"obiettivo {N(goalEff, "0.#")} t/h: {(reached ? "raggiunto" : "non raggiunto")}" : "nessun obiettivo")</div>
                </div>
                <div class="kpi-carta blu-b">
                    <div class="kpi-nome">Tempo ciclo medio</div>
                    <div class="kpi-valore">@N(_res.CycleTimeMeanS, "0.0") <small>s</small></div>
                    <div class="kpi-nota">per pacco</div>
                </div>
                <div class="kpi-carta blu-b">
                    <div class="kpi-nome">Tempo di legatura</div>
                    <div class="kpi-valore">@N(StrapMeanS(), "0.0") <small>s</small></div>
                    <div class="kpi-nota">per pacco da @SelName</div>
                </div>
                <div class="kpi-carta giallo-b">
                    <div class="kpi-nome">Collo di bottiglia</div>
                    <div class="kpi-valore piccolo">@(string.IsNullOrWhiteSpace(_res.BottleneckName) ? "–" : _res.BottleneckName)</div>
                                    </div>
                <div class="kpi-carta @(_res.Collisions == 0 && _res.SlipEvents == 0 ? "verde-b" : "rosso-b")">
                    <div class="kpi-nome">Collisioni · strisciamenti</div>
                    <div class="kpi-valore">@_res.Collisions · @_res.SlipEvents</div>
                    <div class="kpi-nota">@(_res.Collisions == 0 && _res.SlipEvents == 0 ? "nessun problema trovato" : "vedi il registro eventi")</div>
                </div>
            </div>
            @if (!_res.Completed)
            {
                <p class="esito male">Simulazione non completata: @_res.FinishReason</p>
            }
            @if (_res.Problems.Count > 0)
            {
                <div class="blocco">
                    <h2>Anomalie (@_res.Problems.Count)</h2>
                    <ul class="elenco">
                        @foreach (var x in _res.Problems.Take(12)) { <li>@N(x.TimeS, "0.0") s: @x.Message</li> }
                    </ul>
                </div>
            }
            @if (_changes.Count > 0)
            {
                <div class="blocco">
                    <h2>Correzioni automatiche applicate (@_changes.Count)</h2>
                    <ul class="elenco">
                        @foreach (var m in _changes) { <li>@m</li> }
                    </ul>
                </div>
            }

            <div class="blocco" id="vista">
                <div class="titolo-blocco">
                    <h2>Vista della linea</h2>
                    <div class="commutatore">
                        <button id="vista2d" class="@(_view3d ? "" : "attivo")" @onclick="() => SetView(false)">Dall'alto</button>
                        <button id="vista3d" class="@(_view3d ? "attivo" : "")" @onclick="() => SetView(true)">3D</button>
                    </div>
                    <button id="inizio" class="quadro" @onclick="() => Seek(_t - 5)" aria-label="Indietro">«</button>
                    <button id="play" class="scuro" @onclick="TogglePlay">@(_playing ? "Pausa" : "Riproduci")</button>
                    <button class="quadro" @onclick="() => Seek(_t + 5)" aria-label="Avanti">»</button>
                    <label class="nota" for="velocita">Velocità</label>
                    <select id="velocita" class="cella" value="@_speed" @onchange='e => _speed = int.Parse(e.Value?.ToString() ?? "4")'>
                        @foreach (var v in Speeds) { <option value="@v">×@v</option> }
                    </select>
                </div>
                @if (_view3d)
                {
                    <div class="vista3d"><canvas id="c3d"></canvas></div>
                    @if (_no3d)
                    {
                        <p class="esito male">Su questo dispositivo la grafica 3D non è disponibile.</p>
                    }
                    <div class="comandi viste">
                        <button @onclick="@(() => View3D("insieme"))">Insieme</button>
                        <button @onclick="@(() => View3D("legatura"))">Legatura</button>
                        <button @onclick="@(() => View3D("trasferitore"))">Trasferitore</button>
                        <button @onclick="@(() => View3D("alto"))">Alto</button>
                    </div>
                    <p class="nota">Un dito ruota, due dita avvicinano e spostano.</p>
                }
                <svg class="vista" style="@(_view3d ? "display:none" : "")" viewBox="0 0 @VW @VH" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Vista dall'alto della linea">
                    <g>
                        <rect x="@F(BandX)" y="@F(Y(_engine.Transfer.StartM))" width="@F(BandW + _strokeM * KX)" height="@F((_engine.Transfer.EndM - _engine.Transfer.StartM) * _ky)"
                              fill="none" stroke="var(--bordo)" stroke-dasharray="6 5" stroke-width="2" rx="4" />
                        @if (_accM > 0)
                        {
                            <rect x="@F(BandX + _strokeM * KX)" y="@F(Y(_engine.Transfer.StartM))" width="@F(BandW + _accM * KX)" height="@F((_engine.Transfer.EndM - _engine.Transfer.StartM) * _ky)"
                                  fill="none" stroke="var(--bordo)" stroke-width="2" rx="4" />
                        }
                    </g>
                    @foreach (var b in _bands)
                    {
                        <g>
                            <rect x="@F(BandX)" y="@F(Y(b.StartM) + 1)" width="@F(BandW)" height="@F(Math.Max(1, (b.EndM - b.StartM) * _ky - 2))" rx="3" fill="@BandFill(Speed(b))" />
                            <text x="4" y="@F(Y(b.StartM) + 22)" font-size="20">@b.Id</text>
                            <text x="4" y="@F(Y(b.StartM) + 44)" font-size="17">@N(Speed(b), "0.00")</text>
                        </g>
                    }
                    @for (int i = 0; i < _engine.Strappers.Count; i++)
                    {
                        var s = _engine.Strappers[i];
                        bool work = _frame != null && i < _frame.StrapperStates.Length && _frame.StrapperStates[i] != StrapperState.Idle;
                        <g>
                            <rect x="@F(BandX - 10)" y="@F(Y(s.PositionM) - 5)" width="@F(BandW + 20)" height="10" rx="3" fill="@(work ? "var(--lega)" : "var(--macchina)")" opacity="@(work ? "1" : "0.75")" />
                            <text x="@F(BandX + BandW + 16)" y="@F(Y(s.PositionM) + 7)" font-size="19">@s.Id</text>
                        </g>
                    }
                    @for (int i = 0; i < _engine.Photocells.Count; i++)
                    {
                        bool on = _frame != null && i < _frame.PhotocellOutputs.Length && _frame.PhotocellOutputs[i];
                        <g><circle cx="@F(BandX - 9)" cy="@F(Y(_engine.Photocells[i].PositionM))" r="6" fill="@(on ? "var(--fc-on)" : "var(--fc)")" /></g>
                    }
                    @for (int i = 0; i < _engine.IntermediateStops.Count; i++)
                    {
                        bool up = _frame != null && i < _frame.StopRaised.Length && _frame.StopRaised[i];
                        <g><rect x="@F(BandX - 4)" y="@F(Y(_engine.IntermediateStops[i].PositionM) - 2.5)" width="@F(BandW + 8)" height="5" fill="@(up ? "var(--errore)" : "var(--attesa)")" opacity="@(up ? "1" : "0.5")" /></g>
                    }
                    <g><rect x="@F(BandX - 6)" y="@F(Y(_engine.Stopper.PositionM))" width="@F(BandW + 12)" height="7" fill="var(--errore)" /></g>
                    @if (_frame != null)
                    {
                        @foreach (var p in _frame.Packages)
                        {
                            double h = Math.Max(8, p.LengthM * _ky);
                            <g>
                                <rect x="@F(BandX + 6 + p.LateralM * KX)" y="@F(Y(p.HeadM - p.LengthM))" width="@F(BandW - 12)" height="@F(h)" rx="5" fill="@PackFill(p.State)" />
                                <text class="et-pacco" x="@F(BandX + BandW / 2 + p.LateralM * KX)" y="@F(Y(p.HeadM - p.LengthM / 2) + 7)" font-size="19" text-anchor="middle">@p.Id</text>
                            </g>
                        }
                    }
                </svg>
                <div class="riga-tempo">
                    <label for="tempo" class="nota">Tempo</label>
                    <input id="tempo" type="range" min="@F(_winStart)" max="@F(_end)" step="0.5" value="@F(_t)" @oninput="OnSeek" aria-label="Tempo della simulazione" />
                    <b>@N(_t, "0.0") s</b>
                </div>
                <div class="legenda">
                    <span><i style="background:var(--rulli-marcia)"></i>rulli in marcia</span>
                    <span><i style="background:var(--rulli-lenta)"></i>rulli lenti</span>
                    <span><i style="background:var(--lega)"></i>legatura</span>
                    <span><i style="background:var(--intesta)"></i>intestatura</span>
                    <span><i style="background:var(--trasf)"></i>sul trasferitore</span>
                    <span><i style="background:var(--fc-on)"></i>fotocellula occupata</span>
                </div>
            </div>
        }

        <div class="blocco" id="recap-blocco">
            <div class="titolo-blocco">
                <h2>Recap della simulazione</h2>
                <span>20 pacchi per ogni misura · obiettivo @N(Work.Simulation.TargetTonnesPerHour, "0.#") t/h + @N(Work.Simulation.SafetyPercent, "0.#")% di safety = @N(Work.Simulation.EffectiveTargetTonnesPerHour, "0.#") t/h</span>
                <span class="spinto"></span>
                <button class="chiaro" @onclick="RunRecap" disabled="@(_recapBusy || _busy)">@(_recapBusy ? "Calcolo in corso…" : "Simula tutte le misure")</button>
                <button class="chiaro" @onclick="DownloadRecap" disabled="@(_recap.Count == 0)">Scarica recap (Excel)</button>
            </div>
            @if (_recap.Count > 0)
            {
                <div class="tabella-scroll"><table class="tabella" id="recap">
                    <thead><tr><th>Misura</th><th>Pacchi</th><th>Peso totale</th><th>Tempo totale</th><th>Ciclo medio</th><th>Produttività</th><th>Rispetto all'obiettivo</th><th>Collo di bottiglia</th></tr></thead>
                    <tbody>
                        @foreach (var r in _recap)
                        {
                            <tr>
                                <td><b>@N(r.LengthMm / 1000, "0.#") m</b></td><td>@r.Exited</td><td>@N(r.TonnesTotal, "0.0") t</td><td>@N(r.TimeS, "0") s</td><td>@N(r.CycleS, "0.0") s</td>
                                <td><b>@N(r.Tph, "0.0") t/h</b></td>
                                <td><span class="chip @(r.Tph >= Work.Simulation.EffectiveTargetTonnesPerHour ? "chip-verde" : "chip-giallo")">@Gap(r.Tph)</span></td>
                                <td>@(r.Problem ?? r.Bottleneck)</td>
                            </tr>
                        }
                    </tbody>
                </table></div>
            }
            else
            {
                <p class="nota">Premi «Simula tutte le misure» per confrontare i pacchi con l'obiettivo.</p>
            }
        </div>

        @if (_engine != null && _res != null)
        {
            <div class="blocco" id="ciclogramma">
                <div class="titolo-blocco">
                    <h2>Gantt dei pacchi</h2>
                    <span>La linea rossa è l'istante mostrato nella vista.</span>
                    <span class="spinto"></span>
                    <label class="nota" for="finestra">Finestra</label>
                    <select id="finestra" class="cella" value="@_cySpan" @onchange='e => _cySpan = int.Parse(e.Value?.ToString() ?? "60")'>
                        @foreach (var v in new[] { 30, 60, 120, 300 }) { <option value="@v">@v s</option> }
                    </select>
                </div>
                @((MarkupString)GanttSvg())
                <p class="nota">Verde = pacco in movimento sui rulli; gli altri colori sono lo stato (legatura, intestatura, trasferitore, accumulo…).</p>
            </div>

            <div class="blocco" id="pacchisim">
                <h2>Tutti i pacchi da @SelName</h2>
                <p class="nota alto">Tempi in secondi dall'inizio della simulazione.</p>
                <div class="tabella-alta">
                    <table class="tabella">
                        <thead><tr><th>N°</th><th>Ingresso</th><th>Uscita</th><th>Totale</th><th>Attesa</th><th>Netto</th><th>Legature</th></tr></thead>
                        <tbody>
                            @foreach (var k in _res.Packages)
                            {
                                <tr>
                                    <td><b>@k.Id</b></td>
                                    <td>@N(k.EntryTimeS, "0")</td>
                                    <td>@N(k.ExitTimeS, "0")</td>
                                    <td>@N(k.ExitTimeS - k.EntryTimeS, "0.0")</td>
                                    <td>@N(k.WaitingTimeS, "0.0")</td>
                                    <td>@N(k.ExitTimeS - k.EntryTimeS - k.WaitingTimeS, "0.0")</td>
                                    <td>@k.StrapsDone/@k.StrapsTotal</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <div class="riga-blocchi">
            <div class="blocco largo-420" id="uscite">
                <h2>Documenti</h2>
                <Uscite Mode="documenti" Project="Work" Engine="_engine" Results="_res" Replace="ReplaceWork" />
                <p class="nota">Se l'obiettivo non è raggiunto compare «Raggiungi l'obiettivo»: il programma propone le modifiche, con il guadagno in t/h, e tu le applichi o le rifiuti.</p>
            </div>
        </div>

        <div class="avanti"><button class="chiaro grande" @onclick="() => SetTab(2)">← Linea</button></div>
    </section>
</main>

@code {
    // Vista 2D della configurazione (orizzontale, da monte a valle): si ridisegna dal progetto a ogni modifica.
    private string ConfigSvg(bool readOnly = false)
    {
        var w = Work;
        var secs = w.Sections.Where(x => x.IsEnabled).OrderBy(x => x.StartMm).ToList();
        double x0 = secs.Count > 0 ? secs.Min(x => x.StartMm) : 0;
        double x1 = new[] { secs.Count > 0 ? secs.Max(x => x.EndMm) : 0, w.Transfer.PositionMm + w.Transfer.LengthMm, w.Stopper.PositionMm }.Max();
        if (x1 - x0 < 1000) x1 = x0 + 1000;
        const double W = 1000, M = 20, base0 = 70;
        double k = (W - 2 * M) / (x1 - x0);
        string X(double mm) => ((mm - x0) * k + M).ToString("0.#", CultureInfo.InvariantCulture);
        string Wd(double mm) => Math.Max(2, mm * k).ToString("0.#", CultureInfo.InvariantCulture);
        var sb = new System.Text.StringBuilder();
        sb.Append($"<svg class=\"vista-config\" data-k=\"{k.ToString("0.#####", CultureInfo.InvariantCulture)}\" viewBox=\"0 0 {W} @@H@@\" preserveAspectRatio=\"xMidYMid meet\" role=\"img\" aria-label=\"Configurazione della linea\">");
        // vie a rulli
        foreach (var s in secs)
        {
            // tutta la fascia della via si tocca per aprirne le proprietà (solo selezione; la maniglia in fondo la allunga)
            sb.Append($"<g class=\"trascina fisso{Sel("sezione", s.Id)}\" data-k=\"sezione\" data-id=\"{System.Net.WebUtility.HtmlEncode(s.Id)}\">");
            sb.Append($"<rect x=\"{X(s.StartMm)}\" y=\"{base0}\" width=\"{Wd(s.LengthMm)}\" height=\"28\" rx=\"3\" fill=\"var(--bordo)\" stroke=\"var(--tenue)\"/>");
            sb.Append($"<text x=\"{X(s.StartMm + s.LengthMm / 2)}\" y=\"{base0 + 18}\" text-anchor=\"middle\" font-size=\"11\" fill=\"var(--testo)\">{System.Net.WebUtility.HtmlEncode(s.Id)}</text></g>");
        }
        // trasferitore e fermo finale
        sb.Append($"<g class=\"trascina{Sel("transfer", "")}\" data-k=\"transfer\" data-id=\"\">");
        sb.Append($"<rect x=\"{X(w.Transfer.PositionMm)}\" y=\"{base0 - 8}\" width=\"{Wd(w.Transfer.LengthMm)}\" height=\"44\" rx=\"4\" fill=\"none\" stroke=\"var(--accento)\" stroke-dasharray=\"6 4\" stroke-width=\"2\"/>");
        sb.Append($"<text x=\"{X(w.Transfer.PositionMm + w.Transfer.LengthMm / 2)}\" y=\"{base0 - 13}\" text-anchor=\"middle\" font-size=\"11\" fill=\"var(--accento)\">Trasferitore</text>");
        sb.Append("</g>");
        sb.Append($"<g class=\"trascina{Sel("stopper", "")}\" data-k=\"stopper\" data-id=\"\"><rect x=\"{X(w.Stopper.PositionMm) }\" y=\"{base0 - 6}\" width=\"5\" height=\"40\" fill=\"var(--testo)\"/><rect x=\"{X(w.Stopper.PositionMm - 60)}\" y=\"{base0 - 10}\" width=\"{Wd(120)}\" height=\"48\" fill=\"transparent\"/></g>");
        // legatrici
        var marks = new List<(double Mm, string Name)>();
        foreach (var st in w.Strappers.Where(x => x.IsEnabled))
        {
            sb.Append($"<g class=\"trascina{Sel("strapper", st.Id)}\" data-k=\"strapper\" data-id=\"{System.Net.WebUtility.HtmlEncode(st.Id)}\">");
            sb.Append($"<rect x=\"{X(st.PositionMm - 250)}\" y=\"{base0 - 26}\" width=\"{Wd(500)}\" height=\"80\" rx=\"3\" fill=\"var(--lega)\" opacity=\".85\"/>");
            sb.Append($"<text x=\"{X(st.PositionMm)}\" y=\"{base0 + 66}\" text-anchor=\"middle\" font-size=\"11\" fill=\"var(--testo)\">{System.Net.WebUtility.HtmlEncode(st.Id)}</text>");
            sb.Append("</g>");
            marks.Add((st.PositionMm, st.Id));
        }
        // fermi scomparenti
        foreach (var fs in w.IntermediateStops.Where(x => x.IsEnabled))
        {
            sb.Append($"<g class=\"trascina{Sel("stop", fs.Id)}\" data-k=\"stop\" data-id=\"{System.Net.WebUtility.HtmlEncode(fs.Id)}\"><rect x=\"{(((fs.PositionMm - x0) * k + M) - 18).ToString("0.#", CultureInfo.InvariantCulture)}\" y=\"{base0 - 26}\" width=\"36\" height=\"26\" fill=\"transparent\"/><polygon points=\"{X(fs.PositionMm)},{base0 - 4} {X(fs.PositionMm - 150)},{base0 - 22} {X(fs.PositionMm + 150)},{base0 - 22}\" fill=\"var(--intesta)\"/></g>");
            marks.Add((fs.PositionMm, "fermo"));
        }
        // bilici (selezionabili e spostabili)
        foreach (var sc in w.Scales.Where(x => x.IsEnabled))
        {
            sb.Append($"<g class=\"trascina fisso{Sel("scale", sc.Id)}\" data-k=\"scale\" data-id=\"{System.Net.WebUtility.HtmlEncode(sc.Id)}\">");
            sb.Append($"<rect x=\"{X(sc.StartMm)}\" y=\"{base0 + 32}\" width=\"{Wd(sc.LengthMm)}\" height=\"14\" fill=\"transparent\"/><rect x=\"{X(sc.StartMm)}\" y=\"{base0 + 34}\" width=\"{Wd(sc.LengthMm)}\" height=\"6\" fill=\"var(--trasf)\"/>");
            sb.Append($"<text x=\"{X(sc.StartMm + sc.LengthMm / 2)}\" y=\"{base0 + 52}\" text-anchor=\"middle\" font-size=\"10\" fill=\"var(--testo)\">{System.Net.WebUtility.HtmlEncode(sc.Id)}</text></g>");
        }
        // stringifascio, compattatore e rigettatrice
        foreach (var (cid, cpos) in LayoutRules.BundleClampPositions(w))
        {
            if (cpos <= 0) continue;
            sb.Append($"<g class=\"trascina{Sel("clamp", w.BundleClamp.Id)}\" data-k=\"clamp\" data-id=\"{System.Net.WebUtility.HtmlEncode(w.BundleClamp.Id)}\"><rect x=\"{X(cpos - 150)}\" y=\"{base0 - 18}\" width=\"{Wd(300)}\" height=\"64\" rx=\"3\" fill=\"var(--macchina)\" opacity=\".8\"/>");
            sb.Append($"<text x=\"{X(cpos)}\" y=\"{base0 - 22}\" text-anchor=\"middle\" font-size=\"9\" fill=\"var(--testo)\">{System.Net.WebUtility.HtmlEncode(cid)}</text></g>");
        }
        if (w.Compactor.IsEnabled && w.Compactor.PositionMm > 0)
        {
            double jl = Math.Max(300, w.Compactor.JawLengthMm);
            sb.Append($"<g class=\"trascina{Sel("compactor", w.Compactor.Id)}\" data-k=\"compactor\" data-id=\"{System.Net.WebUtility.HtmlEncode(w.Compactor.Id)}\"><rect x=\"{X(w.Compactor.PositionMm - jl / 2)}\" y=\"{base0 - 12}\" width=\"{Wd(jl)}\" height=\"6\" fill=\"var(--intesta)\"/><rect x=\"{X(w.Compactor.PositionMm - jl / 2)}\" y=\"{base0 + 34}\" width=\"{Wd(jl)}\" height=\"6\" fill=\"var(--intesta)\"/>");
            sb.Append($"<text x=\"{X(w.Compactor.PositionMm)}\" y=\"{base0 - 16}\" text-anchor=\"middle\" font-size=\"9\" fill=\"var(--testo)\">{System.Net.WebUtility.HtmlEncode(w.Compactor.Id)}</text></g>");
        }
        if (w.Rejector.IsEnabled)
        {
            sb.Append($"<g class=\"trascina{Sel("rejector", w.Rejector.Id)}\" data-k=\"rejector\" data-id=\"{System.Net.WebUtility.HtmlEncode(w.Rejector.Id)}\"><rect x=\"{X(w.Rejector.PositionMm)}\" y=\"{base0 + 40}\" width=\"{Wd(w.Rejector.LengthMm)}\" height=\"10\" fill=\"var(--errore)\" opacity=\".35\"/>");
            sb.Append($"<text x=\"{X(w.Rejector.PositionMm + w.Rejector.LengthMm / 2)}\" y=\"{base0 + 49}\" text-anchor=\"middle\" font-size=\"9\" fill=\"var(--testo)\">{System.Net.WebUtility.HtmlEncode(w.Rejector.Id)}</text></g>");
        }
        // fotocellule: numero FC sopra la via
        foreach (var pc in w.Photocells.Where(x => x.IsEnabled))
        {
            string fc = (pc.Name ?? "").Split(' ')[0];
            sb.Append($"<g class=\"trascina{(pc.IsAutoGenerated ? " fisso" : "")}{Sel("photocell", pc.Id)}\" data-k=\"photocell\" data-id=\"{System.Net.WebUtility.HtmlEncode(pc.Id)}\"><rect x=\"{(((pc.PositionMm - x0) * k + M) - 18).ToString("0.#", CultureInfo.InvariantCulture)}\" y=\"{base0 - 46}\" width=\"36\" height=\"46\" fill=\"transparent\"/><line x1=\"{X(pc.PositionMm)}\" y1=\"{base0 - 2}\" x2=\"{X(pc.PositionMm)}\" y2=\"{base0 - 30}\" stroke=\"var(--fc-on)\" stroke-width=\"1.5\"/><circle cx=\"{X(pc.PositionMm)}\" cy=\"{base0 - 32}\" r=\"4\" fill=\"var(--fc-on)\"/>");
            sb.Append($"<text x=\"{X(pc.PositionMm)}\" y=\"{base0 - 40}\" text-anchor=\"middle\" font-size=\"9\" fill=\"var(--tenue)\">{System.Net.WebUtility.HtmlEncode(fc)}</text></g>");
        }
        // maniglia di fine modulo: trascinandola si allunga o accorcia il modulo (a rulli interi)
        foreach (var s in secs)
            sb.Append($"<g class=\"trascina{Sel("sezione", s.Id)}\" data-k=\"sezione\" data-id=\"{System.Net.WebUtility.HtmlEncode(s.Id)}\"><rect x=\"{((s.EndMm - x0) * k + M - 10).ToString("0.#", CultureInfo.InvariantCulture)}\" y=\"{base0 + 4}\" width=\"20\" height=\"20\" rx=\"3\" fill=\"var(--accento)\" opacity=\".85\"/></g>");
        // catena di quote: inizio via → legatrici e fermi → inizio trasferitore → fermo finale
        marks.Add((x0, "")); marks.Add((w.Transfer.PositionMm, "")); marks.Add((w.Stopper.PositionMm, ""));
        var xs = marks.Select(m => m.Mm).Distinct().OrderBy(v => v).ToList();
        double yq = 175;
        sb.Append($"<line x1=\"{X(xs[0])}\" y1=\"{yq}\" x2=\"{X(xs[^1])}\" y2=\"{yq}\" stroke=\"var(--tenue)\"/>");
        for (int i = 0; i < xs.Count; i++)
        {
            sb.Append($"<line x1=\"{X(xs[i])}\" y1=\"{base0 + 30}\" x2=\"{X(xs[i])}\" y2=\"{yq + 6}\" stroke=\"var(--bordo)\" stroke-dasharray=\"2 3\"/><line x1=\"{X(xs[i])}\" y1=\"{yq - 6}\" x2=\"{X(xs[i])}\" y2=\"{yq + 6}\" stroke=\"var(--tenue)\"/>");
            if (i == 0) continue;
            double d = xs[i] - xs[i - 1];
            if (d < 1) continue;
            sb.Append($"<text x=\"{X((xs[i] + xs[i - 1]) / 2)}\" y=\"{yq + 18}\" text-anchor=\"middle\" font-size=\"11\" fill=\"var(--testo)\">{d:0}</text>");
        }
        // lunghezza di ciascun modulo della via a rulli, in metri
        double y2 = 218;
        sb.Append($"<line x1=\"{X(x0)}\" y1=\"{y2}\" x2=\"{X(secs.Count > 0 ? secs.Max(x => x.EndMm) : x1)}\" y2=\"{y2}\" stroke=\"var(--tenue)\"/>");
        foreach (var s in secs)
        {
            sb.Append($"<line x1=\"{X(s.StartMm)}\" y1=\"{y2 - 6}\" x2=\"{X(s.StartMm)}\" y2=\"{y2 + 6}\" stroke=\"var(--tenue)\"/><line x1=\"{X(s.EndMm)}\" y1=\"{y2 - 6}\" x2=\"{X(s.EndMm)}\" y2=\"{y2 + 6}\" stroke=\"var(--tenue)\"/>");
            sb.Append($"<text x=\"{X(s.StartMm + s.LengthMm / 2)}\" y=\"{y2 + 20}\" text-anchor=\"middle\" font-size=\"11\" fill=\"var(--testo)\">{System.Net.WebUtility.HtmlEncode(s.Id)} · {N(s.LengthMm / 1000, "0.##")} m</text>");
        }
        // lunghezza totale della linea (dall'inizio al fermo finale)
        double y3 = 252;
        sb.Append($"<line x1=\"{X(x0)}\" y1=\"{y3}\" x2=\"{X(x1)}\" y2=\"{y3}\" stroke=\"var(--testo)\" stroke-width=\"1.5\"/><line x1=\"{X(x0)}\" y1=\"{y3 - 7}\" x2=\"{X(x0)}\" y2=\"{y3 + 7}\" stroke=\"var(--testo)\" stroke-width=\"1.5\"/><line x1=\"{X(x1)}\" y1=\"{y3 - 7}\" x2=\"{X(x1)}\" y2=\"{y3 + 7}\" stroke=\"var(--testo)\" stroke-width=\"1.5\"/>");
        sb.Append($"<text x=\"{X((x0 + x1) / 2)}\" y=\"{y3 + 20}\" text-anchor=\"middle\" font-size=\"12\" font-weight=\"bold\" fill=\"var(--testo)\">Lunghezza totale {x1 - x0:0} mm</text>");
        // distanze delle fotocellule: inizio legatura dalla prima legatrice, uscita legatura dall'ultima, le altre dal fermo o dalla fine modulo più vicini
        var strs = w.Strappers.Where(x => x.IsEnabled).OrderBy(x => x.PositionMm).ToList();
        var refs = new List<(double Mm, string Name)>();
        foreach (var fs in w.IntermediateStops.Where(x => x.IsEnabled)) refs.Add((fs.PositionMm, fs.Id));
        refs.Add((w.Stopper.PositionMm, "fermo finale"));
        foreach (var s in secs) refs.Add((s.EndMm, "fine " + s.Id));
        double yr = 292; int row = 0;
        foreach (var pc in w.Photocells.Where(x => x.IsEnabled).OrderBy(x => x.PositionMm).Skip(1))
        {
            (double Mm, string Name)? rf = null;
            if (pc.Purpose == PhotocellPurpose.StrappingReference && strs.Count > 0) rf = (strs[0].PositionMm, strs[0].Id);
            else if (pc.Purpose == PhotocellPurpose.StrappingExit && strs.Count > 0) rf = (strs[^1].PositionMm, strs[^1].Id);
            else if (refs.Count > 0) { var n = refs.OrderBy(r => Math.Abs(r.Mm - pc.PositionMm)).First(); rf = n; }
            if (rf == null) continue;
            double d = Math.Abs(rf.Value.Mm - pc.PositionMm);
            if (d < 1) continue;
            string fc = (pc.Name ?? pc.Id).Split(' ')[0];
            double ya = yr + (row % 4) * 20;
            row++;
            double xa = Math.Min(pc.PositionMm, rf.Value.Mm), xb = Math.Max(pc.PositionMm, rf.Value.Mm);
            sb.Append($"<line x1=\"{X(pc.PositionMm)}\" y1=\"{base0 - 30}\" x2=\"{X(pc.PositionMm)}\" y2=\"{ya + 5}\" stroke=\"var(--fc-on)\" stroke-dasharray=\"2 3\" opacity=\".6\"/>");
            sb.Append($"<line x1=\"{X(rf.Value.Mm)}\" y1=\"{base0 + 34}\" x2=\"{X(rf.Value.Mm)}\" y2=\"{ya + 5}\" stroke=\"var(--fc-on)\" stroke-dasharray=\"2 3\" opacity=\".6\"/>");
            sb.Append($"<line x1=\"{X(xa)}\" y1=\"{ya}\" x2=\"{X(xb)}\" y2=\"{ya}\" stroke=\"var(--fc-on)\"/>");
            sb.Append($"<text x=\"{X((xa + xb) / 2)}\" y=\"{ya - 3}\" text-anchor=\"middle\" font-size=\"10\" fill=\"var(--testo)\">{System.Net.WebUtility.HtmlEncode(fc)} ↔ {System.Net.WebUtility.HtmlEncode(rf.Value.Name)}: {d:0}</text>");
        }
        double H = Math.Max(300, yr + Math.Min(row, 4) * 20 + 14);
        sb.Append("</svg>");
        var svg = sb.ToString().Replace("@@H@@", H.ToString("0", CultureInfo.InvariantCulture));
        return readOnly ? svg.Replace("class=\"trascina", "class=\"ro") : svg;
    }

    // ---- schede (passi) della pagina
    private int _tab;
    private void SetTab(int t) { _tab = t; _packKey = null; Js("schede.mostra"); }
    private async Task GoDocs() { _tab = 3; StateHasChanged(); await Task.Delay(60); Go("uscite"); }

    // ---- legature del pacco: + / − e quote tra le legature
    private static List<double> Quotes(PackageType t)
    {
        var pos = t.StrapPositionsMm.OrderBy(x => x).ToList();
        var q = new List<double>();
        double prev = 0;
        foreach (var p in pos) { q.Add(p - prev); prev = p; }
        q.Add(t.LengthMm - prev);
        return q;
    }

    private static string QuoteLabel(int count, int i) =>
        count == 1 ? "Testa → coda" : i == 0 ? "Testa → L1" : i == count - 1 ? $"L{i} → coda" : $"L{i} → L{i + 1}";

    private void StrapPlus(PackageType t) => Edit(() =>
    {
        var marks = new List<double> { 0 }; marks.AddRange(t.StrapPositionsMm.OrderBy(x => x)); marks.Add(t.LengthMm);
        int best = 0;
        for (int i = 1; i < marks.Count; i++) if (marks[i] - marks[i - 1] > marks[best + 1] - marks[best]) best = i - 1;
        double mid = StrapEditing.Snap((marks[best] + marks[best + 1]) / 2);
        var pos = t.StrapPositionsMm.OrderBy(x => x).ToList();
        if (mid <= marks[best] || mid >= marks[best + 1] || pos.Contains(mid)) return;
        pos.Add(mid);
        t.StrapPositionsMm = pos.OrderBy(x => x).ToList();
        _packKey = null;
    });

    private void StrapMinus(PackageType t) => Edit(() =>
    {
        var pos = t.StrapPositionsMm.OrderBy(x => x).ToList();
        if (pos.Count < 2) return;
        pos.RemoveAt(pos.Count - 1);
        t.StrapPositionsMm = pos;
        _packKey = null;
    });

    private void SetQuote(PackageType t, int i, ChangeEventArgs e) => Edit(() =>
    {
        var pos = t.StrapPositionsMm.OrderBy(x => x).ToList();
        if (!double.TryParse(e.Value?.ToString()?.Replace(',', '.'), NumberStyles.Float, CultureInfo.InvariantCulture, out var v) || v <= 0) { _packKey = null; return; }
        if (i < pos.Count)
            MoveStrapTo(t, i, (i == 0 ? 0 : pos[i - 1]) + v);
        else if (pos.Count > 0)
            MoveStrapTo(t, pos.Count - 1, t.LengthMm - v);
        _packKey = null;
    });

    // ---- recap della simulazione: una riga per misura (20 pacchi ciascuna)
    private sealed record RecapRow(string TypeId, double LengthMm, int Exited, double TonnesTotal, double TimeS, double? CycleS, double? Tph, string Bottleneck, string? Problem);
    private readonly List<RecapRow> _recap = new();
    private bool _recapBusy;

    private async Task RunRecap()
    {
        if (_recapBusy || _busy) return;
        _recapBusy = true; _recap.Clear();
        StateHasChanged();
        await Task.Delay(30);
        foreach (var t in Work.PackageTypes.ToList())
        {
            try
            {
                var p = PackageProductivity.PrepareFor(Work, t.Id, 20);
                var e = new SimulationEngine(p);
                while (e.Step()) { }
                var r = e.ComputeResults();
                string? problem = r.Collisions > 0 ? "collisioni" : r.Deadlock ? "blocco" : r.PackagesExited == 0 ? "nessun pacco uscito" : null;
                double tons = r.Packages.Where(k => k.ExitTimeS.HasValue).Sum(k => k.WeightKg) / 1000.0;
                _recap.Add(new RecapRow(t.Id, t.LengthMm, r.PackagesExited, tons, r.SimulatedTimeS, r.CycleTimeMeanS, r.TonnesPerHour, r.BottleneckName, problem));
            }
            catch (Exception ex) { _recap.Add(new RecapRow(t.Id, t.LengthMm, 0, 0, 0, null, null, "", ex.Message)); }
            StateHasChanged();
            await Task.Delay(1);
        }
        _recapBusy = false;
    }

    private string Gap(double? tph)
    {
        double goal = Work.Simulation.EffectiveTargetTonnesPerHour;
        if (goal <= 0 || tph == null) return "–";
        double d = tph.Value - goal;
        return (d >= 0 ? "+" : "") + N(d, "0.0") + " t/h " + (d >= 0 ? "(ok)" : "(sotto)");
    }

    private void DownloadRecap()
    {
        if (_recap.Count == 0) return;
        using var wb = new ClosedXML.Excel.XLWorkbook();
        var ws = wb.AddWorksheet("Recap");
        string[] h = { "Pacco", "Lunghezza (m)", "Pacchi usciti", "Peso totale (t)", "Tempo totale (s)", "Ciclo medio (s)", "Produttività (t/h)", "Obiettivo con safety (t/h)", "Scarto (t/h)", "Collo di bottiglia", "Note" };
        for (int c = 0; c < h.Length; c++) { ws.Cell(1, c + 1).Value = h[c]; ws.Cell(1, c + 1).Style.Font.Bold = true; }
        double goal = Work.Simulation.EffectiveTargetTonnesPerHour;
        for (int i = 0; i < _recap.Count; i++)
        {
            var r = _recap[i]; int row = i + 2;
            ws.Cell(row, 1).Value = r.TypeId; ws.Cell(row, 2).Value = r.LengthMm / 1000.0; ws.Cell(row, 3).Value = r.Exited;
            ws.Cell(row, 4).Value = Math.Round(r.TonnesTotal, 3); ws.Cell(row, 5).Value = Math.Round(r.TimeS, 1);
            if (r.CycleS is double cs) ws.Cell(row, 6).Value = Math.Round(cs, 2);
            if (r.Tph is double tp) { ws.Cell(row, 7).Value = Math.Round(tp, 2); if (goal > 0) ws.Cell(row, 9).Value = Math.Round(tp - goal, 2); }
            if (goal > 0) ws.Cell(row, 8).Value = Math.Round(goal, 2);
            ws.Cell(row, 10).Value = r.Bottleneck; ws.Cell(row, 11).Value = r.Problem ?? "";
        }
        ws.Columns().AdjustToContents();
        using var ms = new MemoryStream();
        wb.SaveAs(ms);
        Js("salva.file", "recap_simulazione.xlsx", Convert.ToBase64String(ms.ToArray()), "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
    }

    /// <summary>Tempo medio di legatura per pacco (dal Gantt registrato).</summary>
    private double? StrapMeanS()
    {
        if (_engine == null) return null;
        var v = PackageGantt.Build(_engine.Recorder)
            .Select(r => r.Segments.Where(g => g.State == PackageState.Strapping).Sum(g => g.EndS - g.StartS))
            .Where(x => x > 0).ToList();
        return v.Count == 0 ? null : v.Average();
    }

    // ---- ciclogramma e Gantt a schermo
    private int _cySpan = 60;
    private double? _cyStart;
    private double CyStart => Math.Clamp(_cyStart ?? _winStart, _winStart, Math.Max(_winStart, _end - _cySpan));

    private static string CyClass(TrackGroup g, CycleState st)
    {
        if (g == TrackGroup.Photocell) return st == CycleState.On ? "cy-occ" : "";
        return st switch
        {
            CycleState.Working or CycleState.Closed or CycleState.Translating or CycleState.Depositing or CycleState.InPosition
                or CycleState.Aligned or CycleState.On or CycleState.Positioning or CycleState.Fault => "cy-work",
            CycleState.Preparing or CycleState.Aligning => "cy-prep",
            CycleState.Lifting or CycleState.Lowering or CycleState.Returning or CycleState.Closing or CycleState.Opening or CycleState.Unloading => "cy-move",
            CycleState.Waiting or CycleState.WaitConsent or CycleState.Consent or CycleState.Interlock => "cy-wait",
            _ => ""
        };
    }

    private string CyclogramSvg()
    {
        if (_engine == null) return "";
        var ci = CultureInfo.InvariantCulture;
        string F2(double v) => v.ToString("0.#", ci);
        double t0 = CyStart, t1 = t0 + _cySpan;
        const double W = 1000, LW = 150, RH = 16;
        var tracks = _engine.Recorder.Tracks.Where(t => t.Segments.Any(x => x.EndS > t0 && x.StartS < t1 && CyClass(t.Group, x.State) != "")).ToList();
        double H = 24 + tracks.Count * RH + 6;
        double X(double t) => LW + (W - LW - 6) * (t - t0) / (t1 - t0);
        var sb = new System.Text.StringBuilder();
        sb.Append($"<svg class=\"ciclogramma\" viewBox=\"0 0 {W} {F2(H)}\" preserveAspectRatio=\"xMidYMid meet\" role=\"img\" aria-label=\"Ciclogramma dei dispositivi\">");
        double step = _cySpan <= 30 ? 5 : _cySpan <= 120 ? 10 : 30;
        for (double t = Math.Ceiling(t0 / step) * step; t <= t1; t += step)
            sb.Append($"<line x1=\"{F2(X(t))}\" y1=\"16\" x2=\"{F2(X(t))}\" y2=\"{F2(H)}\" stroke=\"var(--bordo)\"/><text x=\"{F2(X(t))}\" y=\"11\" text-anchor=\"middle\" font-size=\"9\" fill=\"var(--tenue)\">{t:0}</text>");
        for (int i = 0; i < tracks.Count; i++)
        {
            double y = 20 + i * RH;
            sb.Append($"<text x=\"{LW - 4}\" y=\"{F2(y + 11)}\" text-anchor=\"end\" font-size=\"9\" fill=\"var(--testo)\">{System.Net.WebUtility.HtmlEncode(tracks[i].Label)}</text>");
            foreach (var sg in tracks[i].Segments)
            {
                if (sg.EndS <= t0 || sg.StartS >= t1) continue;
                string cl = CyClass(tracks[i].Group, sg.State);
                if (cl == "") continue;
                double xa = X(Math.Max(sg.StartS, t0)), xb = X(Math.Min(sg.EndS, t1));
                sb.Append($"<rect class=\"{cl}\" x=\"{F2(xa)}\" y=\"{F2(y + 1)}\" width=\"{F2(Math.Max(1, xb - xa))}\" height=\"{RH - 3}\" rx=\"2\"><title>{System.Net.WebUtility.HtmlEncode(tracks[i].Label)}: {sg.State} {sg.StartS:0.0}–{sg.EndS:0.0} s</title></rect>");
            }
        }
        if (_t >= t0 && _t <= t1) sb.Append($"<line x1=\"{F2(X(_t))}\" y1=\"14\" x2=\"{F2(X(_t))}\" y2=\"{F2(H)}\" stroke=\"var(--errore)\" stroke-width=\"1.5\"/>");
        sb.Append("</svg>");
        return sb.ToString();
    }

    private string GanttSvg()
    {
        if (_engine == null) return "";
        var ci = CultureInfo.InvariantCulture;
        string F2(double v) => v.ToString("0.#", ci);
        double t0 = CyStart, t1 = t0 + _cySpan;
        const double W = 1000, LW = 70, RH = 18;
        var rows = PackageGantt.Build(_engine.Recorder).Where(r => r.EndS > t0 && r.StartS < t1).ToList();
        double H = 24 + rows.Count * RH + 6;
        double X(double t) => LW + (W - LW - 6) * (t - t0) / (t1 - t0);
        var sb = new System.Text.StringBuilder();
        sb.Append($"<svg class=\"ciclogramma\" viewBox=\"0 0 {W} {F2(H)}\" preserveAspectRatio=\"xMidYMid meet\" role=\"img\" aria-label=\"Gantt dei pacchi\">");
        double step = _cySpan <= 30 ? 5 : _cySpan <= 120 ? 10 : 30;
        for (double t = Math.Ceiling(t0 / step) * step; t <= t1; t += step)
            sb.Append($"<line x1=\"{F2(X(t))}\" y1=\"16\" x2=\"{F2(X(t))}\" y2=\"{F2(H)}\" stroke=\"var(--bordo)\"/><text x=\"{F2(X(t))}\" y=\"11\" text-anchor=\"middle\" font-size=\"9\" fill=\"var(--tenue)\">{t:0}</text>");
        for (int i = 0; i < rows.Count; i++)
        {
            double y = 20 + i * RH;
            sb.Append($"<text x=\"{LW - 4}\" y=\"{F2(y + 12)}\" text-anchor=\"end\" font-size=\"9\" fill=\"var(--testo)\">{System.Net.WebUtility.HtmlEncode(rows[i].PackageId)} · {rows[i].LengthM:0.#} m</text>");
            foreach (var sg in rows[i].Segments)
            {
                if (sg.EndS <= t0 || sg.StartS >= t1) continue;
                double xa = X(Math.Max(sg.StartS, t0)), xb = X(Math.Min(sg.EndS, t1));
                string fill = sg.Moving ? "var(--rulli-marcia)" : PackFill(sg.State);
                string tip = $"{sg.Label}: {sg.StartS:0.0}–{sg.EndS:0.0} s" + (sg.Moving ? $", {sg.DistanceM:0.0} m, vmax {sg.MaxSpeed:0.00} m/s" : "");
                sb.Append($"<rect x=\"{F2(xa)}\" y=\"{F2(y + 1)}\" width=\"{F2(Math.Max(1, xb - xa))}\" height=\"{RH - 3}\" fill=\"{fill}\" rx=\"2\"><title>{System.Net.WebUtility.HtmlEncode(tip)}</title></rect>");
            }
        }
        if (_t >= t0 && _t <= t1) sb.Append($"<line x1=\"{F2(X(_t))}\" y1=\"14\" x2=\"{F2(X(_t))}\" y2=\"{F2(H)}\" stroke=\"var(--errore)\" stroke-width=\"1.5\"/>");
        sb.Append("</svg>");
        return sb.ToString();
    }

