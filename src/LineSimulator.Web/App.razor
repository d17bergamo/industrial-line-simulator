    {
        public double StartM { get; set; }
        public double EndM { get; set; }
        public double PitchM { get; set; }
        public double StrokeM { get; set; }
        public double AccM { get; set; }
        public double TransferStartM { get; set; }
        public double TransferEndM { get; set; }
        public double StopperM { get; set; }
        public List<Band> Bands { get; set; } = new();
        public double[] Strappers { get; set; } = Array.Empty<double>();
        public string[] StrapperIds { get; set; } = Array.Empty<string>();
        public double[] Photocells { get; set; } = Array.Empty<double>();
        public double[] Stops { get; set; } = Array.Empty<double>();
    }

    private sealed class Frame3D
    {
        public double[] Speeds { get; set; } = Array.Empty<double>();
        public bool[] Strappers { get; set; } = Array.Empty<bool>();
        public bool[] Photocells { get; set; } = Array.Empty<bool>();
        public bool[] Stops { get; set; } = Array.Empty<bool>();
        public double[] Packs { get; set; } = Array.Empty<double>();
        public string[] Ids { get; set; } = Array.Empty<string>();
    }

