    private static int Rollers(RollerSection m) => m.RollerPitchMm > 0 ? (int)Math.Round(m.LengthMm / m.RollerPitchMm) : 0;

    private void SetSectionLength(RollerSection m, ChangeEventArgs e) =>
        Edit(() => ResizeSection(m, Num(e, m.LengthMm / 1000.0, m.RollerPitchMm / 1000.0, 200) * 1000.0));

    private void ResizeSection(RollerSection m, double lenMm)
    {
        double pitch = m.RollerPitchMm > 0 ? m.RollerPitchMm : RollerSection.DefaultPitchMm;
        double len = Math.Max(2 * pitch, Math.Round(lenMm / pitch) * pitch);
        double oldEnd = m.EndMm;
        LineReflow.Fit(m, m.StartMm, m.StartMm + len);
        LineReflow.AfterResize(Work, m, oldEnd);
        if (ReferenceEquals(m, LayoutRules.TransferModule(Work))) Work.Transfer.LengthMm = m.LengthMm;
    }

