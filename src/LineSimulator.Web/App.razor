    private LineProject BuildProject()
    {
        var p = ProjectSerializer.Clone(Work);
        p.Infeed.TypeSequence = new List<string> { SimType };
        // simulazione continua: i pacchi entrano senza fine; il ciclogramma tiene gli ultimi 5 minuti
        p.Infeed.PackageCount = 1_000_000;
        p.Infeed.Continuous = true;
        p.Simulation.MaxSimulationTimeS = 1e9;
        p.Simulation.RecordWindowS = RecordWindowS;
        return p;
    }

    private async Task Run()
    {
        if (_busy) return;
        StopPlay();
        Js("scena3d.dispose");
        _busy = true; _progress = 0; _errors.Clear();
        _engine = null; _res = null; _frame = null;
        StateHasChanged();
        await Task.Delay(30);
        try
        {
            var p = BuildProject();
            var fix = ProjectAutoFix.Run(p);
            var e = new SimulationEngine(p);
            _changes = fix.Messages.Concat(e.Preparation.Changes).Distinct().ToList();
            _errors.AddRange(fix.Errors);
            _errors.AddRange(e.Preparation.Errors);
            _errors.AddRange(e.Validation.Errors.Select(i => i.Message));
            if (_errors.Count > 0)
            {
                var distinct = _errors.Distinct().ToList();
                _errors.Clear(); _errors.AddRange(distinct);
                return;
            }
            int n = 0;
            while (e.Time < WarmupS && e.Step())
            {
                if (++n % 2000 != 0) continue;
                _progress = Math.Min(0.98, e.Time / WarmupS);
                StateHasChanged();
                await Task.Delay(1);
            }
            _res = e.ComputeResults();
            _events = e.Events.Where(x => x.Severity != EventSeverity.Trace).ToList();
            _evIdx = e.Events.Count;
            _lastRes = DateTime.UtcNow;
            _lineStart = e.Topology.LineStartM;
            _ky = (VH - Top - 16) / Math.Max(1, e.Topology.LineEndM - e.Topology.LineStartM);
            _strokeM = p.Transfer.TranslationStrokeMm / 1000.0;
            _accM = p.AccumulationTransfer.IsEnabled ? p.AccumulationTransfer.WidthMm / 1000.0 : 0;
            _split = e.TransferSplitM;
            _bands = new List<Band>();
            for (int i = 0; i < e.Zones.Count; i++)
            {
                var z = e.Zones[i];
                bool split = e.TransferSplitM is double sp && e.Topology.StopperZone != null && z.Id == e.Topology.StopperZone.Id && sp > z.Info.StartM && sp < z.Info.EndM;
                if (split)
                {
                    _bands.Add(new Band(e.MonteInverterId ?? z.Id + "a", i, z.Info.StartM, e.TransferSplitM!.Value, false));
                    _bands.Add(new Band(z.Id, i, e.TransferSplitM!.Value, z.Info.EndM, true));
                }
                else _bands.Add(new Band(z.Id, i, z.Info.StartM, z.Info.EndM, false));
            }
            _end = e.Recorder.Frames.Count > 0 ? e.Recorder.Frames[^1].TimeS : e.Time;
            _winStart = e.Recorder.Frames.Count > 0 ? e.Recorder.Frames[0].TimeS : 0;
            _t = _winStart;
            _frame = e.Recorder.FrameAt(_t);
            _engine = e;
            _init3d = _view3d;
            _no3d = false;
        }
        catch (Exception ex)
        {
            _errors.Add("Errore durante la simulazione: " + ex.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    private void TogglePlay()
    {
        if (_playing) { StopPlay(); return; }
        if (_engine == null) return;
        _playing = true;
        _playCts = new CancellationTokenSource();
        _ = PlayLoop(_playCts.Token);
    }

    private void StopPlay()
    {
        _playing = false;
        _playCts?.Cancel();
        _playCts = null;
    }

    private async Task PlayLoop(CancellationToken ct)
    {
        const int tickMs = 70;
        var last = DateTime.UtcNow;
        while (!ct.IsCancellationRequested && _engine != null)
        {
            try { await Task.Delay(tickMs, ct); } catch (TaskCanceledException) { return; }
            var now = DateTime.UtcNow;
            double dt = Math.Min(0.5, (now - last).TotalSeconds);
            last = now;
            double target = _t + dt * _speed;
            if (target > _end) AdvanceEngine(target);
            _t = Math.Min(_end, target);
            _frame = _engine.Recorder.FrameAt(_t);
            Push3D();
            if (_engine.IsFinished && _t >= _end - 1e-6) { _playing = false; _playCts = null; StateHasChanged(); return; }
            StateHasChanged();
        }
    }

    /// <summary>Simulazione continua: fa avanzare il motore fino all'istante richiesto (al più ~30 ms per giro) e aggiorna eventi e risultati.</summary>
    private void AdvanceEngine(double target)
    {
        var e = _engine!;
        var sw = System.Diagnostics.Stopwatch.StartNew();
        int n = 0;
        while (e.Time < target && !e.IsFinished)
        {
            if (!e.Step()) break;
            if ((++n & 63) == 0 && sw.ElapsedMilliseconds > 30) break;
        }
        for (; _evIdx < e.Events.Count; _evIdx++)
            if (e.Events[_evIdx].Severity != EventSeverity.Trace) _events.Add(e.Events[_evIdx]);
        if (_events.Count > 6000) _events.RemoveRange(0, 2000);
        _end = e.Recorder.Frames.Count > 0 ? e.Recorder.Frames[^1].TimeS : e.Time;
        _winStart = e.Recorder.Frames.Count > 0 ? e.Recorder.Frames[0].TimeS : 0;
        if ((DateTime.UtcNow - _lastRes).TotalSeconds > 8 || e.IsFinished)
        {
            _res = e.ComputeResults();
            _lastRes = DateTime.UtcNow;
        }
    }

    private void OnSeek(ChangeEventArgs e)
    {
        if (_engine == null) return;
        if (double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out double v))
        {
            _t = Math.Clamp(v, _winStart, _end);
            _frame = _engine.Recorder.FrameAt(_t);
            Push3D();
        }
    }

    /// <summary>Ultimi eventi fino all'istante mostrato (ricerca binaria: l'elenco è in ordine di tempo).</summary>
    private IEnumerable<SimEvent> RecentEvents()
    {
        int lo = 0, hi = _events.Count;
        while (lo < hi)
        {
            int mid = (lo + hi) / 2;
            if (_events[mid].TimeS <= _t) lo = mid + 1; else hi = mid;
        }
        for (int i = Math.Max(0, lo - 4); i < lo; i++) yield return _events[i];
    }

    public void Dispose()
    {
        StopPlay();
        Js("scena3d.dispose");
        _self?.Dispose();
    }
