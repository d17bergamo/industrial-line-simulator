    private async Task CalcProd()
    {
        _prodBusy = true; _prod.Clear();
        StateHasChanged();
        await Task.Delay(30);
        var snap = ProjectSerializer.Clone(Work);
        foreach (var t in snap.PackageTypes.ToList())
        {
            _prod[t.Id] = PackageProductivity.Evaluate(snap, t.Id);
            StateHasChanged();
            await Task.Delay(1);
        }
        _prodBusy = false;
    }

