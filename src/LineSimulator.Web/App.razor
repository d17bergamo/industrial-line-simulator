@code {
    // Vista 2D della configurazione (orizzontale, da monte a valle): si ridisegna dal progetto a ogni modifica.
    private string ConfigSvg()
    {
        var w = Work;
        var secs = w.Sections.Where(x => x.IsEnabled).OrderBy(x => x.StartMm).ToList();
        double x0 = secs.Count > 0 ? secs.Min(x => x.StartMm) : 0;
        double x1 = new[] { secs.Count > 0 ? secs.Max(x => x.EndMm) : 0, w.Transfer.PositionMm + w.Transfer.LengthMm, w.Stopper.PositionMm }.Max();
        if (x1 - x0 < 1000) x1 = x0 + 1000;
        const double W = 1000, M = 20, base0 = 70;
        double k = (W - 2 * M) / (x1 - x0);
        string X(double mm) => ((mm - x0) * k + M).ToString("0.#", CultureInfo.InvariantCulture);
        string Wd(double mm) => Math.Max(2, mm * k).ToString("0.#", CultureInfo.InvariantCulture);
        var sb = new System.Text.StringBuilder();
        sb.Append($"<svg class=\"vista-config\" data-k=\"{k.ToString("0.#####", CultureInfo.InvariantCulture)}\" viewBox=\"0 0 {W} 255\" preserveAspectRatio=\"xMidYMid meet\" role=\"img\" aria-label=\"Configurazione della linea\">");
        // vie a rulli
        foreach (var s in secs)
        {
            sb.Append($"<rect x=\"{X(s.StartMm)}\" y=\"{base0}\" width=\"{Wd(s.LengthMm)}\" height=\"28\" rx=\"3\" fill=\"var(--bordo)\" stroke=\"var(--tenue)\"/>");
            sb.Append($"<text x=\"{X(s.StartMm + s.LengthMm / 2)}\" y=\"{base0 + 18}\" text-anchor=\"middle\" font-size=\"11\" fill=\"var(--testo)\">{System.Net.WebUtility.HtmlEncode(s.Id)}</text>");
        }
        // trasferitore e fermo finale
        sb.Append($"<g class=\"trascina{Sel("transfer", "")}\" data-k=\"transfer\" data-id=\"\">");
        sb.Append($"<rect x=\"{X(w.Transfer.PositionMm)}\" y=\"{base0 - 8}\" width=\"{Wd(w.Transfer.LengthMm)}\" height=\"44\" rx=\"4\" fill=\"none\" stroke=\"var(--accento)\" stroke-dasharray=\"6 4\" stroke-width=\"2\"/>");
        sb.Append($"<text x=\"{X(w.Transfer.PositionMm + w.Transfer.LengthMm / 2)}\" y=\"{base0 - 13}\" text-anchor=\"middle\" font-size=\"11\" fill=\"var(--accento)\">Trasferitore</text>");
        sb.Append("</g>");
        sb.Append($"<g class=\"trascina{Sel("stopper", "")}\" data-k=\"stopper\" data-id=\"\"><rect x=\"{X(w.Stopper.PositionMm) }\" y=\"{base0 - 6}\" width=\"5\" height=\"40\" fill=\"var(--testo)\"/><rect x=\"{X(w.Stopper.PositionMm - 60)}\" y=\"{base0 - 10}\" width=\"{Wd(120)}\" height=\"48\" fill=\"transparent\"/></g>");
        // legatrici
        var marks = new List<(double Mm, string Name)>();
        foreach (var st in w.Strappers.Where(x => x.IsEnabled))
        {
            sb.Append($"<g class=\"trascina{Sel("strapper", st.Id)}\" data-k=\"strapper\" data-id=\"{System.Net.WebUtility.HtmlEncode(st.Id)}\">");
            sb.Append($"<rect x=\"{X(st.PositionMm - 250)}\" y=\"{base0 - 26}\" width=\"{Wd(500)}\" height=\"80\" rx=\"3\" fill=\"var(--lega)\" opacity=\".85\"/>");
            sb.Append($"<text x=\"{X(st.PositionMm)}\" y=\"{base0 + 66}\" text-anchor=\"middle\" font-size=\"11\" fill=\"var(--testo)\">{System.Net.WebUtility.HtmlEncode(st.Id)}</text>");
            sb.Append("</g>");
            marks.Add((st.PositionMm, st.Id));
        }
        // fermi scomparenti
        foreach (var fs in w.IntermediateStops.Where(x => x.IsEnabled))
        {
            sb.Append($"<g class=\"trascina{Sel("stop", fs.Id)}\" data-k=\"stop\" data-id=\"{System.Net.WebUtility.HtmlEncode(fs.Id)}\"><polygon points=\"{X(fs.PositionMm)},{base0 - 4} {X(fs.PositionMm - 150)},{base0 - 22} {X(fs.PositionMm + 150)},{base0 - 22}\" fill=\"var(--intesta)\"/></g>");
            marks.Add((fs.PositionMm, "fermo"));
        }
        // bilici
        foreach (var sc in w.Scales.Where(x => x.IsEnabled))
            sb.Append($"<rect x=\"{X(sc.StartMm)}\" y=\"{base0 + 34}\" width=\"{Wd(sc.LengthMm)}\" height=\"6\" fill=\"var(--trasf)\"/>");
        // fotocellule: numero FC sopra la via
        foreach (var pc in w.Photocells.Where(x => x.IsEnabled))
        {
            string fc = (pc.Name ?? "").Split(' ')[0];
            sb.Append($"<g class=\"trascina{Sel("photocell", pc.Id)}\" data-k=\"photocell\" data-id=\"{System.Net.WebUtility.HtmlEncode(pc.Id)}\"><rect x=\"{X(pc.PositionMm - 60)}\" y=\"{base0 - 46}\" width=\"{Wd(120)}\" height=\"46\" fill=\"transparent\"/><line x1=\"{X(pc.PositionMm)}\" y1=\"{base0 - 2}\" x2=\"{X(pc.PositionMm)}\" y2=\"{base0 - 30}\" stroke=\"var(--fc-on)\" stroke-width=\"1.5\"/><circle cx=\"{X(pc.PositionMm)}\" cy=\"{base0 - 32}\" r=\"4\" fill=\"var(--fc-on)\"/>");
            sb.Append($"<text x=\"{X(pc.PositionMm)}\" y=\"{base0 - 40}\" text-anchor=\"middle\" font-size=\"9\" fill=\"var(--tenue)\">{System.Net.WebUtility.HtmlEncode(fc)}</text></g>");
        }
        // maniglia di fine modulo: trascinandola si allunga o accorcia il modulo (a rulli interi)
        foreach (var s in secs)
            sb.Append($"<g class=\"trascina{Sel("sezione", s.Id)}\" data-k=\"sezione\" data-id=\"{System.Net.WebUtility.HtmlEncode(s.Id)}\"><rect x=\"{((s.EndMm - x0) * k + M - 6).ToString("0.#", CultureInfo.InvariantCulture)}\" y=\"{base0 + 4}\" width=\"12\" height=\"20\" rx=\"3\" fill=\"var(--accento)\" opacity=\".85\"/></g>");
        // catena di quote: inizio via → legatrici e fermi → inizio trasferitore → fermo finale
        marks.Add((x0, "")); marks.Add((w.Transfer.PositionMm, "")); marks.Add((w.Stopper.PositionMm, ""));
        var xs = marks.Select(m => m.Mm).Distinct().OrderBy(v => v).ToList();
        double yq = 175;
        sb.Append($"<line x1=\"{X(xs[0])}\" y1=\"{yq}\" x2=\"{X(xs[^1])}\" y2=\"{yq}\" stroke=\"var(--tenue)\"/>");
        for (int i = 0; i < xs.Count; i++)
        {
            sb.Append($"<line x1=\"{X(xs[i])}\" y1=\"{base0 + 30}\" x2=\"{X(xs[i])}\" y2=\"{yq + 6}\" stroke=\"var(--bordo)\" stroke-dasharray=\"2 3\"/><line x1=\"{X(xs[i])}\" y1=\"{yq - 6}\" x2=\"{X(xs[i])}\" y2=\"{yq + 6}\" stroke=\"var(--tenue)\"/>");
            if (i == 0) continue;
            double d = xs[i] - xs[i - 1];
            if (d < 1) continue;
            sb.Append($"<text x=\"{X((xs[i] + xs[i - 1]) / 2)}\" y=\"{yq + 18}\" text-anchor=\"middle\" font-size=\"11\" fill=\"var(--testo)\">{d:0}</text>");
        }
        // lunghezza di ciascun modulo della via a rulli, in metri
        double y2 = 218;
        sb.Append($"<line x1=\"{X(x0)}\" y1=\"{y2}\" x2=\"{X(secs.Count > 0 ? secs.Max(x => x.EndMm) : x1)}\" y2=\"{y2}\" stroke=\"var(--tenue)\"/>");
        foreach (var s in secs)
        {
            sb.Append($"<line x1=\"{X(s.StartMm)}\" y1=\"{y2 - 6}\" x2=\"{X(s.StartMm)}\" y2=\"{y2 + 6}\" stroke=\"var(--tenue)\"/><line x1=\"{X(s.EndMm)}\" y1=\"{y2 - 6}\" x2=\"{X(s.EndMm)}\" y2=\"{y2 + 6}\" stroke=\"var(--tenue)\"/>");
            sb.Append($"<text x=\"{X(s.StartMm + s.LengthMm / 2)}\" y=\"{y2 + 20}\" text-anchor=\"middle\" font-size=\"11\" fill=\"var(--testo)\">{System.Net.WebUtility.HtmlEncode(s.Id)} · {N(s.LengthMm / 1000, "0.##")} m</text>");
        }
        sb.Append("</svg>");
        return sb.ToString();
    }

    private static readonly int[] Speeds = { 1, 4, 10, 30 };

    // Disegno: la linea scorre dall'alto verso il basso (sul telefono c'è più spazio in altezza), il trasferitore porta a destra.
    private const double VW = 460, VH = 1000, BandX = 80, BandW = 70, KX = 34, Top = 24;

    private sealed record Band(string Id, int Zone, double StartM, double EndM, bool Valle);

    private int _model;
    private string _type = "*";
    /// <summary>Misura simulata (una alla volta): la scelta se valida, altrimenti la prima.</summary>
    private string SimType
    {
        get => Work.PackageTypes.Any(t => t.Id == _type) ? _type : (Work.PackageTypes.FirstOrDefault()?.Id ?? "");
        set => _type = value;
    }
    private LineProject? _work;
    private bool _edited;
    private int _tab = 1;
    private List<string> _check = new(), _checkErrors = new();
    private int _cStrappers = 2, _cMaxM = 12;
    private string _cLengths = "6, 9, 12";
    private bool _cStop;

    private int Model
    {
        get => _model;
        set { _model = value; _type = "*"; if (value != -2) LoadWork(); }
    }

    /// <summary>Progetto in modifica: parte dall'esempio, dal file o dal layout personalizzato e si cambia pezzo per pezzo.</summary>
    private LineProject Work
    {
        get { if (_work == null) LoadWork(); return _work!; }
    }

    private void LoadWork()
    {
        try { _work = Source(); }
        catch (Exception ex) { _errors.Add("Progetto non leggibile: " + ex.Message); _work = SampleProjects.All[0].Factory(); }
        _edited = false;
        Check();
    }

    private void ResetWork()
    {
        if (_model == -2) CreateCustom(); else LoadWork();
    }

    private LineProject Source() =>
        _model == -1 && _uploaded != null ? ProjectSerializer.Deserialize(_uploaded) : SampleProjects.All[Math.Clamp(_model, 0, SampleProjects.All.Count - 1)].Factory();

    private void CreateCustom()
    {
        var lengths = _cLengths.Split(new[] { ',', ';', ' ', '/' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(x => int.TryParse(x, out int v) ? v : 0).Where(v => v >= 2 && v <= 30).ToList();
        _work = SampleProjects.CreateCustom(_cStrappers, _cMaxM, lengths, _cStop);
        ProjectAutoFix.Run(_work);
        _edited = false;
        _type = "*";
        Check();
    }

    /// <summary>Dopo ogni modifica: controlli automatici in anteprima (le correzioni si applicano con il pulsante o alla simulazione).</summary>
    private void Check()
    {
        _check = new(); _checkErrors = new();
        if (_work == null) return;
        try
        {
            var r = ProjectAutoFix.Preview(_work);
            _check = r.Messages.Distinct().ToList();
            _checkErrors = r.Errors.Distinct().ToList();
        }
        catch (Exception ex) { _checkErrors.Add("Controllo non riuscito: " + ex.Message); }
    }

    private void Edit(Action change)
    {
        change();
        _edited = true;
        Check();
    }

    private void OnFamilyChanged()
    {
        ProjectEditing.Normalize(Work);
        OnConfigChanged();
    }

    private IEnumerable<(string, object)> Families()
    {
        var st = Work.Strappers.Where(x => x.IsEnabled).ToList();
        if (st.Count > 0) yield return ($"Legatrici e reggettatrici ({st.Count})", Work.StrapperDefaults);
        yield return ($"Vie a rulli ({Work.Sections.Count})", Work.SectionDefaults);
        if (Work.Scales.Any(x => x.IsEnabled)) yield return ($"Bilici ({Work.Scales.Count})", Work.ScaleDefaults);
        yield return ("Trasferitore sollevabile a catene", Work.Transfer);
        yield return ("Trasferitore d'accumulo", Work.AccumulationTransfer);
        if (Work.BundleClamp.IsEnabled && st.Count > 0) yield return ("Stringifascio", Work.BundleClamp);
        if (Work.Compactor.IsEnabled) yield return ("Compattatore laterale", Work.Compactor);
    }

    private void OnConfigChanged()
    {
        _edited = true;
        Check();
    }

    /// <summary>Progetto sostituito dagli strumenti (proposte dell'ottimizzatore, correzioni del controllo).</summary>
    private void ReplaceWork(LineProject p)
    {
        _work = p;
        _edited = true;
        _type = "*";
        Check();
    }

    private void ApplyFix()
    {
        ProjectAutoFix.Run(Work);
        _edited = true;
        Check();
    }

    private static double Num(ChangeEventArgs e, double old, double min, double max) =>
        double.TryParse(e.Value?.ToString()?.Replace(',', '.'), NumberStyles.Float, CultureInfo.InvariantCulture, out double v) ? Math.Clamp(v, min, max) : old;

    private void SetLength(PackageType t, ChangeEventArgs e) => Edit(() =>
    {
        t.LengthMm = Math.Round(Num(e, t.LengthMm, 1000, 40000) / 100) * 100;
        t.StrapPositionsMm = PackageNaming.DefaultStraps(t.LengthMm, Math.Max(1, t.StrapCount));
        t.Name = $"Pacco {t.LengthMm / 1000:0.#} m";
        PackageNaming.Refresh(Work, t);
        _type = "*";
    });

    private void SetStraps(PackageType t, ChangeEventArgs e) => Edit(() =>
        t.StrapPositionsMm = PackageNaming.DefaultStraps(t.LengthMm, (int)Num(e, t.StrapCount, 1, 20)));

    private void SetBinding(PackageType t, ChangeEventArgs e) => Edit(() =>
    {
        t.BindingType = Enum.Parse<BindingType>(e.Value!.ToString()!);
        PackageNaming.Refresh(Work, t);
        _type = "*";
    });

    private void AddType() => Edit(() =>
    {
        var last = Work.PackageTypes.OrderBy(x => x.LengthMm).LastOrDefault();
        int m = last == null ? 6 : (int)Math.Min(30, Math.Round(last.LengthMm / 1000) + 3);
        var t = SampleProjects.Package(m);
        t.Id = PackageNaming.UniqueId(Work, t);
        Work.PackageTypes.Add(t);
        Work.Infeed.TypeSequence = Work.PackageTypes.Select(x => x.Id).ToList();
    });

    private void RemoveType(PackageType t) => Edit(() =>
    {
        Work.PackageTypes.Remove(t);
        Work.Infeed.TypeSequence = Work.Infeed.TypeSequence.Where(x => x != t.Id).ToList();
        _type = "*";
    });

    private void AllBanking(AccumulationMode b) => Edit(() => BankingOptions.SetBankingAll(Work, b));

    private static int Rollers(RollerSection m) => m.RollerPitchMm > 0 ? (int)Math.Round(m.LengthMm / m.RollerPitchMm) : 0;

    private void SetSectionLength(RollerSection m, ChangeEventArgs e) =>
        Edit(() => ResizeSection(m, Num(e, m.LengthMm / 1000.0, m.RollerPitchMm / 1000.0, 200) * 1000.0));

    private void ResizeSection(RollerSection m, double lenMm)
    {
        double pitch = m.RollerPitchMm > 0 ? m.RollerPitchMm : RollerSection.DefaultPitchMm;
        double len = Math.Max(2 * pitch, Math.Round(lenMm / pitch) * pitch);
        double oldEnd = m.EndMm;
        LineReflow.Fit(m, m.StartMm, m.StartMm + len);
        LineReflow.AfterResize(Work, m, oldEnd);
        if (ReferenceEquals(m, LayoutRules.TransferModule(Work))) Work.Transfer.LengthMm = m.LengthMm;
    }

    // Selezione, aggiunta ed eliminazione dalla vista 2D
    private static readonly string[] ViewAddable = { "section", "photocell", "strapper", "stop-center", "stop-end", "scale-center", "scale-end", "clamp", "compactor", "rejector" };
    private string _selK = "", _selId = "", _viewMsg = "";

    private string Sel(string kind, string id) => _selK == kind && _selId == id ? " sel" : "";

    private object? SelectedComp => _selK switch
    {
        "strapper" => Work.Strappers.FirstOrDefault(x => x.Id == _selId),
        "stop" => Work.IntermediateStops.FirstOrDefault(x => x.Id == _selId),
        "photocell" => Work.Photocells.FirstOrDefault(x => x.Id == _selId),
        "sezione" => Work.Sections.FirstOrDefault(x => x.Id == _selId),
        _ => null
    };

    private bool SelectKind(object m)
    {
        (string k, string id)? r = m switch
        {
            StrapperConfig c => ("strapper", c.Id),
            IntermediateStopConfig c => ("stop", c.Id),
            PhotocellConfig c => ("photocell", c.Id),
            RollerSection c => ("sezione", c.Id),
            _ => null
        };
        if (r == null) return false;
        (_selK, _selId) = r.Value;
        return true;
    }

    private void AddFromView(ChangeEventArgs e)
    {
        string key = e.Value?.ToString() ?? "";
        if (key.Length == 0) return;
        _viewMsg = "";
        object? added = null;
        Edit(() =>
        {
            added = ProjectEditing.Add(Work, key);
            if (added != null) ProjectEditing.Normalize(Work);
        });
        if (added == null) { _viewMsg = key == "strapper" ? $"Al massimo {LineProject.MaxStrappers} legatrici." : "Componente non aggiunto."; return; }
        if (!SelectKind(added)) { _selK = ""; _selId = ""; _viewMsg = "Componente aggiunto: si configura in Configurazione dei componenti."; }
    }

    private void DeleteFromView()
    {
        var m = SelectedComp;
        if (m == null || !ProjectEditing.CanDelete(m)) return;
        Edit(() => { ProjectEditing.Delete(Work, new[] { m }); ProjectEditing.Normalize(Work); });
        _selK = ""; _selId = ""; _viewMsg = "";
    }

    /// <summary>Chiamato da configvista.js quando si tocca un componente senza trascinarlo.</summary>
    [JSInvokable]
    public void SelectComponent(string kind, string id)
    {
        _selK = kind; _selId = id; _viewMsg = "";
        StateHasChanged();
    }

    /// <summary>Chiamato da configvista.js al rilascio di un componente trascinato nella vista 2D (spostamento in mm).</summary>
    [JSInvokable]
    public void MoveComponent(string kind, string id, double deltaMm)
    {
        static double Snap(double v, double step) => Math.Max(0, Math.Round(v / step) * step);
        object? model = null;
        Edit(() =>
        {
            switch (kind)
            {
                case "strapper": { var c = Work.Strappers.FirstOrDefault(x => x.Id == id); if (c != null) { c.PositionMm = Snap(c.PositionMm + deltaMm, 50); model = c; } break; }
                case "stop": { var c = Work.IntermediateStops.FirstOrDefault(x => x.Id == id); if (c != null) { c.PositionMm = Snap(c.PositionMm + deltaMm, 50); model = c; } break; }
                case "photocell": { var c = Work.Photocells.FirstOrDefault(x => x.Id == id); if (c != null) { c.PositionMm = Snap(c.PositionMm + deltaMm, 10); model = c; } break; }
                case "stopper": Work.Stopper.PositionMm = Snap(Work.Stopper.PositionMm + deltaMm, 50); model = Work.Stopper; break;
                case "transfer": Work.Transfer.PositionMm = Snap(Work.Transfer.PositionMm + deltaMm, 50); model = Work.Transfer; break;
                case "sezione": { var c = Work.Sections.FirstOrDefault(x => x.Id == id); if (c != null) ResizeSection(c, c.LengthMm + deltaMm); break; }
            }
            if (model != null) ProjectEditing.AfterEdit(Work, model, "PositionMm");
            ProjectEditing.Normalize(Work);
        });
        StateHasChanged();
    }

    private void SetTransferLength(ChangeEventArgs e)
    {
        var m = LayoutRules.TransferModule(Work);
        if (m == null) return;
        SetSectionLength(m, e);
    }

    private void AddStrapper() => Edit(() =>
    {
        var last = Work.Strappers.OrderBy(x => x.PositionMm).LastOrDefault();
        var s = new StrapperConfig
        {
            Id = $"L{Work.Strappers.Count + 1}", Name = $"Legatrice {Work.Strappers.Count + 1}",
            PositionMm = (last?.PositionMm ?? SampleProjects.FirstStrapperPositionMm(1, 12) - SampleProjects.StrapperSpacingMm) + SampleProjects.StrapperSpacingMm
        };
        if (last != null) { s.Model = last.Model; s.FootprintLengthMm = last.FootprintLengthMm; }
        Work.Strappers.Add(s);
    });

    private string StopChoice => Work.IntermediateStops.FirstOrDefault() is not { } f ? "none"
        : f.ManualPosition ? "manual" : f.Placement == DevicePlacement.End ? "end" : "center";

    private void SetStopChoice(ChangeEventArgs e) => Edit(() =>
    {
        string v = e.Value?.ToString() ?? "none";
        if (v == "none") { Work.IntermediateStops.Clear(); return; }
        var place = v == "end" ? DevicePlacement.End : DevicePlacement.Center;
        var f = Work.IntermediateStops.FirstOrDefault();
        if (f == null)
        {
            f = new IntermediateStopConfig { Id = "FM1", Name = "Fermo scomparente", AlignmentTimeS = 2.0 };
            Work.IntermediateStops.Add(f);
        }
        f.IsEnabled = true;
        f.ManualPosition = v == "manual";
        if (v != "manual") { f.Placement = place; f.PositionMm = StrappingAreaRules.StopPositionMm(Work, place); }
        // con il fermo all'estremità a monte l'intestatura dei pacchi è di coda
        if (v == "end") foreach (var t in Work.PackageTypes) t.Heading = StopReference.Tail;
    });

    private void SetScales(ChangeEventArgs e) => Edit(() =>
    {
        int n = (int)Num(e, Work.Scales.Count, 1, 2);
        var proto = Work.Scales.FirstOrDefault() ?? new WeighingScaleConfig();
        while (Work.Scales.Count > n) Work.Scales.RemoveAt(Work.Scales.Count - 1);
        while (Work.Scales.Count < n)
        {
            var sc = ProjectSerializer.Clone(new LineProject { Scales = { proto } }).Scales[0];
            sc.Id = $"B{Work.Scales.Count + 1}"; sc.Name = $"Bilico {Work.Scales.Count + 1}";
            sc.Placement = Work.Scales.Count == 0 ? DevicePlacement.Center : DevicePlacement.End;
            sc.ManualPosition = false;
            Work.Scales.Add(sc);
        }
        foreach (var sc in Work.Scales) sc.ManualPosition = false;
        StrappingAreaRules.LayoutScales(Work);
    });

    private void SetWeighing(ChangeEventArgs e) => Edit(() =>
    {
        foreach (var b in Work.Scales)
        {
            b.StabilizationTimeS = Num(e, b.StabilizationTimeS, 0, 600);
            b.ConfirmTimeoutS = Math.Max(b.ConfirmTimeoutS, b.StabilizationTimeS + 30);
        }
    });

