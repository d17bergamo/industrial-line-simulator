<Window x:Class="LineSimulator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="http://helix-toolkit.org/wpf"
        xmlns:vm="clr-namespace:LineSimulator.App.ViewModels"
        xmlns:mvvm="clr-namespace:LineSimulator.App.Mvvm"
        xmlns:ctl="clr-namespace:LineSimulator.App.Controls"
        Icon="Assets/app.ico" Title="{Binding Title}" Height="900" Width="1500" WindowState="Maximized"
        FontFamily="Segoe UI" FontSize="12" Background="{StaticResource PanelBg}">
    <Window.Resources>
        <mvvm:EqualsToVisibilityConverter x:Key="EqVis"/>
        <mvvm:NullToCollapsedConverter x:Key="NullVis"/>
        <mvvm:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>
        <mvvm:RatioToWidthConverter x:Key="RatioWidth"/>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
                                    <DataTemplate x:Key="PropEditor" DataType="{x:Type vm:PropertyItemViewModel}">
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.55*"/>
                                            <ColumnDefinition Width="0.45*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="{Binding Name}"/>
                                        <TextBox Grid.Column="1" Text="{Binding TextValue, UpdateSourceTrigger=LostFocus}" IsReadOnly="{Binding IsReadOnly}"
                                                 Visibility="{Binding Kind, Converter={StaticResource EqVis}, ConverterParameter=Text}" KeyDown="PropertyBox_KeyDown">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsInherited}" Value="True">
                                                            <Setter Property="Background" Value="#F4F5F7"/>
                                                            <Setter Property="Foreground" Value="#5B6673"/>
                                                            <Setter Property="ToolTip" Value="Valore della famiglia: spunta «Personalizza» per cambiarlo solo qui"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsCalculated}" Value="True">
                                                            <Setter Property="BorderThickness" Value="0"/>
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="Foreground" Value="#5B6673"/>
                                                            <Setter Property="ToolTip" Value="Calcolato automaticamente"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding BoolValue}" IsEnabled="{Binding IsEditable}" VerticalAlignment="Center"
                                                  Visibility="{Binding Kind, Converter={StaticResource EqVis}, ConverterParameter=Bool}"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedItem="{Binding ChoiceValue}" IsEnabled="{Binding IsEditable}"
                                                  Visibility="{Binding Kind, Converter={StaticResource EqVis}, ConverterParameter=Choice}"/>
                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Error}" Foreground="#C0392B" TextWrapping="Wrap"
                                                   Visibility="{Binding Error, Converter={StaticResource NullVis}}"/>
                                    </Grid>
                                </DataTemplate>
        <Style x:Key="HomeTile" TargetType="Button">
            <Setter Property="Width" Value="330"/>
            <Setter Property="Height" Value="250"/>
            <Setter Property="Margin" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Tile" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="2" CornerRadius="10" Padding="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Tile" Property="Background" Value="#F0F6FC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Menu -->
        <Menu DockPanel.Dock="Top" Background="White">
            <MenuItem Header="_Home" Command="{Binding GoHomeCommand}"/>
            <MenuItem Header="_File">
                <MenuItem Header="_Nuovo progetto" Command="{Binding NewCommand}"/>
                <MenuItem Header="_Apri..." Command="{Binding OpenCommand}" InputGestureText="Ctrl+O"/>
                <MenuItem Header="_Salva" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S"/>
                <MenuItem Header="Salva _con nome..." Command="{Binding SaveAsCommand}"/>
                <MenuItem Header="_Duplica progetto" Command="{Binding DuplicateCommand}"/>
                <Separator/>
                <MenuItem Header="Salva _layout..." Command="{Binding SaveLayoutCommand}"/>
                <MenuItem Header="Apri l_ayout..." Command="{Binding OpenLayoutCommand}"/>
                <MenuItem Header="Salva tipologie _pacchi..." Command="{Binding SavePackagesCommand}"/>
                <MenuItem Header="Apri tipologie pa_cchi..." Command="{Binding OpenPackagesCommand}"/>
                <Separator/>
                <MenuItem Header="_Esempi" ItemsSource="{Binding Examples}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding Name}"/>
                            <Setter Property="Command" Value="{Binding DataContext.LoadExampleCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <Setter Property="CommandParameter" Value="{Binding}"/>
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Esporta risultati _CSV..." Command="{Binding ExportCsvCommand}"/>
                <MenuItem Header="Esporta risultati _Excel..." Command="{Binding ExportExcelCommand}"/>
                <MenuItem Header="Esporta _logica di controllo (JSON/CSV)..." Command="{Binding ExportControlLogicCommand}"/>
                <MenuItem Header="Esporta specifica _funzionale (Word)..." Command="{Binding ExportFunctionalSpecCommand}"/>
                <MenuItem Header="Esporta _vista dall'alto (PDF)..." Command="{Binding ExportTopViewPdfCommand}"/>
                <Separator/>
                <MenuItem Header="_Esci" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Vista">
                <MenuItem Header="Dall'_alto" Click="ViewTop_Click"/>
                <MenuItem Header="_Laterale" Click="ViewSide_Click"/>
                <MenuItem Header="_Isometrica" Click="ViewIso_Click"/>
                <MenuItem Header="_Adatta alla linea" Click="ViewFit_Click"/>
            </MenuItem>
            <MenuItem Header="_Simulazione">
                <MenuItem Header="Avvia" Command="{Binding PlayCommand}" InputGestureText="F5"/>
                <MenuItem Header="Pausa" Command="{Binding PauseCommand}"/>
                <MenuItem Header="Stop (risultati parziali)" Command="{Binding StopCommand}"/>
                <MenuItem Header="Reset" Command="{Binding ResetCommand}"/>
                <Separator/>
                <MenuItem Header="Passo singolo" Command="{Binding StepCommand}" InputGestureText="F10"/>
                <MenuItem Header="Evento successivo" Command="{Binding NextEventCommand}" InputGestureText="F11"/>
                <MenuItem Header="Esegui fino al termine" Command="{Binding RunToEndCommand}"/>
            </MenuItem>
            <MenuItem Header="_Ottimizzazione">
                <MenuItem Header="Ottimizza zone di comando (minimo numero di inverter)..." Command="{Binding OptimizeCommandZonesCommand}"/>
                <MenuItem Header="Raggiungi l'obiettivo di produttività..." Command="{Binding ReachTargetCommand}"/>
            </MenuItem>
        </Menu>
        <!-- Barra di stato -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource HeaderBg}">
            <DockPanel Margin="8,3">
                <TextBlock DockPanel.Dock="Right" Foreground="#BDC3C7" Text="Strumento di progettazione - non è un sistema di sicurezza certificato"/>
                <TextBlock Foreground="White" Text="{Binding Status}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
        <Grid>
            <!-- Avvio guidato: da un esempio pronto o da un layout nuovo -->
            <ScrollViewer Background="{StaticResource PanelBg}" VerticalScrollBarVisibility="Auto" Visibility="{Binding CurrentSection, Converter={StaticResource EqVis}, ConverterParameter=Home}">
                <StackPanel Margin="32,28" MaxWidth="1200">
                    <TextBlock Text="Cosa vuoi fare?" FontSize="30" FontWeight="SemiBold" Foreground="#1B2430"/>
                    <TextBlock Text="Parti da un esempio già pronto e adattalo, oppure costruisci un layout nuovo partendo dai pacchi." Foreground="#5B6673" FontSize="14" Margin="0,4,0,20"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="PARTI DA UN ESEMPIO" Style="{StaticResource KpiLabel}" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding StartOptions}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,12,12">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Bottom" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Content="Apri questo esempio"
                                                        Command="{Binding DataContext.StartFromExampleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Summary}" Foreground="#5B6673" Margin="0,2,0,8" TextWrapping="Wrap"/>
                                                    <ItemsControl ItemsSource="{Binding Features}">
                                                        <ItemsControl.ItemTemplate><DataTemplate>
                                                            <TextBlock TextWrapping="Wrap" Margin="0,2"><Run Text="•  " Foreground="{StaticResource Accent}"/><Run Text="{Binding Mode=OneWay}"/></TextBlock>
                                                        </DataTemplate></ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="PARTI DA ZERO" Style="{StaticResource KpiLabel}" Margin="0,0,0,8"/>
                            <Border Background="White" BorderBrush="#B9D4F5" BorderThickness="1" CornerRadius="12" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Layout nuovo" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="#34465C" Margin="0,6,0,0" Text="Ti guido in tre passi:"/>
                                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Text="1  Pacchi: le tipologie da legare (lunghezza, legature)."/>
                                    <TextBlock TextWrapping="Wrap" Margin="0,2,0,0" Text="2  Dati area: obiettivo t/h e tempi delle macchine."/>
                                    <TextBlock TextWrapping="Wrap" Margin="0,2,0,0" Text="3  Layout e simulazione: aggiungi legatrici e macchine dalla libreria e simula."/>
                                    <TextBlock TextWrapping="Wrap" Foreground="#5B6673" Margin="0,8,0,0" Text="Si parte da una linea base (via rulli, trasferitore a catene, bilico) senza legatrici."/>
                                    <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Content="Inizia dai pacchi" Command="{Binding StartFromScratchCommand}"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="OPPURE" Style="{StaticResource KpiLabel}" Margin="0,20,0,8"/>
                            <Button Style="{StaticResource ToolButton}" HorizontalAlignment="Left" Content="📂  Apri un progetto salvato" Command="{Binding OpenCommand}"/>
                            <Button Style="{StaticResource ToolButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Content="Continua con il progetto aperto" Command="{Binding GoStepCommand}" CommandParameter="Layout"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
            <DockPanel Visibility="{Binding CurrentSection, Converter={StaticResource EqVis}, ConverterParameter=Layout}">
        <!-- Barra superiore -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Height="56">
            <DockPanel Margin="12,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="💾  Salva" Command="{Binding SaveCommand}" Margin="8,0,0,0"/>
                <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="⌂" FontSize="18" Command="{Binding GoHomeCommand}" ToolTip="Torna alla schermata iniziale"/>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="8,0,16,0">
                    <TextBlock Text="{Binding Project.Name}" FontWeight="Bold" FontSize="14" Foreground="#1B2430"/>
                    <TextBlock Text="Dati area, layout e simulazione" Foreground="#5B6673"/>
                </StackPanel>
                <Border DockPanel.Dock="Left" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource StepButton}" Content="1  Pacchi" Command="{Binding GoStepCommand}" CommandParameter="Packages"/><TextBlock Text="›" Foreground="#B6BEC8" FontSize="16" VerticalAlignment="Center"/><Button Style="{StaticResource StepButton}" Content="2  Dati area" Command="{Binding GoStepCommand}" CommandParameter="Area" Tag="{Binding IsStepCycle}"/><TextBlock Text="›" Foreground="#B6BEC8" FontSize="16" VerticalAlignment="Center"/><Button Style="{StaticResource StepButton}" Content="3  Layout e simulazione" Command="{Binding GoStepCommand}" CommandParameter="Layout" Tag="{Binding IsStepLayout}"/></StackPanel></Border>
                <Button DockPanel.Dock="Left" x:Name="AddMenuButton" Style="{StaticResource ToolButton}" Content="＋  Aggiungi  ▾" Margin="16,0,0,0" Visibility="{Binding IsStepLayout, Converter={StaticResource BoolVis}}" Click="AddMenu_Click" ToolTip="Aggiunge un componente al progetto (le macchine si trascinano anche dalla libreria)">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Modulo via a rulli" Command="{Binding AddSectionCommand}"/>
                            <MenuItem Header="Fotocellula" Command="{Binding AddPhotocellCommand}"/>
                            <MenuItem Header="Legatrice" Command="{Binding AddStrapperCommand}"/>
                            <MenuItem Header="Fermo scomparente" Command="{Binding AddStopCommand}"/>
                            <MenuItem Header="Bilico" Command="{Binding AddScaleCommand}"/>
                            <Separator/>
                            <MenuItem Header="Tipologia di pacco" Command="{Binding AddPackageTypeCommand}"/>
                            <MenuItem Header="Regola" Command="{Binding AddRuleCommand}"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </DockPanel>
        </Border>
        <!-- Passo 4: risultati sempre in vista -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="16,8"
                Visibility="{Binding IsStepLayout, Converter={StaticResource BoolVis}}">
            <UniformGrid Rows="1" Columns="6">
                <StackPanel Margin="0,0,12,0"><TextBlock Style="{StaticResource KpiLabel}" Text="COSA SIMULO"/>
                    <ComboBox ItemsSource="{Binding PackageTypes}" SelectedItem="{Binding SimPackageType, Mode=TwoWay}" ToolTip="Tipologia di pacco da vedere nella simulazione" Margin="0,2"/>
                    <DockPanel Margin="0,2">
                        <ComboBox DockPanel.Dock="Right" Width="80" ItemsSource="{Binding HeadingModes}" SelectedItem="{Binding SimHeading, Mode=TwoWay}" ToolTip="Battuta: di testa o di coda (di coda solo con fermo scomparente)" Margin="4,0,0,0"/>
                        <ComboBox ItemsSource="{Binding BankingModes}" SelectedItem="{Binding SimBanking, Mode=TwoWay}" ToolTip="Come si carica il trasferitore: un pacco (single) o due (double)"/>
                    </DockPanel>
                    <CheckBox Content="Pacchi senza fine (fino a Stop)" IsChecked="{Binding SimContinuous, Mode=TwoWay}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel><TextBlock Style="{StaticResource KpiLabel}" Text="PRODUTTIVITÀ"/><TextBlock FontSize="20" FontWeight="Bold" Text="{Binding Results.TonnesPerHour, StringFormat='{}{0:0.0} t/h', FallbackValue='—'}"/>
                    <TextBlock Foreground="#9A5A0E" Text="{Binding TargetProgress}"/></StackPanel>
                <StackPanel><TextBlock Style="{StaticResource KpiLabel}" Text="PACCHI ALL'ORA"/><TextBlock FontSize="20" FontWeight="Bold" Text="{Binding Results.PackagesPerHour, StringFormat={}{0:0.0}, FallbackValue='—'}"/></StackPanel>
                <StackPanel><TextBlock Style="{StaticResource KpiLabel}" Text="CICLO MEDIO"/><TextBlock FontSize="20" FontWeight="Bold" Text="{Binding Results.CycleTimeMeanS, StringFormat='{}{0:0.0} s', FallbackValue='—'}"/></StackPanel>
                <StackPanel><TextBlock Style="{StaticResource KpiLabel}" Text="COLLO DI BOTTIGLIA"/><TextBlock FontSize="16" FontWeight="Bold" Text="{Binding Results.BottleneckName, FallbackValue='—'}"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource ToolButton}" Content="Vai al punto nel ciclo" Command="{Binding GoToBottleneckCommand}" ToolTip="Ferma la simulazione dove il collo di bottiglia aspetta di più"/>
                        <Button Style="{StaticResource ToolButton}" Content="Proponi modifiche" Command="{Binding ReachTargetCommand}"/>
                    </StackPanel></StackPanel>
                <StackPanel><TextBlock Style="{StaticResource KpiLabel}" Text="PACCHI (COLORE PER TIPOLOGIA)"/>
                    <ItemsControl ItemsSource="{Binding PackageLegend}" Margin="0,4,0,0">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="0,2,12,2">
                            <Border Width="12" Height="12" CornerRadius="3" Background="{Binding Brush}" Margin="0,0,5,0"/><TextBlock Text="{Binding Name}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0"><Border Width="12" Height="12" CornerRadius="3" Background="#F2A900" Margin="0,0,5,0"/><TextBlock Text="macchina in attesa di consenso" Foreground="#5B6673"/></StackPanel>
                </StackPanel>
            </UniformGrid>
        </Border>
        <!-- Passo 2: problemi del layout sempre in vista, con la correzione automatica -->
        <Border DockPanel.Dock="Bottom" Background="#FFF8EE" BorderBrush="#F2C27C" BorderThickness="0,1,0,0" Padding="16,8">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsStepLayout}" Value="True"/>
                                <Condition Binding="{Binding HasCheckProblems}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <Border DockPanel.Dock="Left" Background="#E08A1E" CornerRadius="10" MinWidth="22" Height="22" Padding="6,0" Margin="0,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CheckProblems}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Sistema automaticamente" Command="{Binding CheckEquipmentCommand}" Margin="6,0,0,0"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="Mostra" Command="{Binding ShowCheckCommand}"/>
                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis"><Run Text="{Binding CheckSummary, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  ·  "/><Run Text="{Binding CheckProblemsLine, Mode=OneWay}"/></TextBlock>
            </DockPanel>
        </Border>
        <Grid>
        <!-- Passo 3: tutto il ciclo in una pagina -->
        <ScrollViewer Visibility="{Binding IsStepCycle, Converter={StaticResource BoolVis}}" Background="#F4F5F7" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,18" MaxWidth="1100">
                <UniformGrid Columns="2">
                    <Border Background="White" BorderBrush="#B9D4F5" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,8,16">
                        <StackPanel>
                            <TextBlock Text="1 · Obiettivo" FontSize="16" FontWeight="Bold"/>
                            <DockPanel Margin="0,10,0,0">
                                <TextBox DockPanel.Dock="Left" Width="90" FontSize="18" FontWeight="Bold" Text="{Binding SimTargetTph, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.#}}"/>
                                <TextBlock DockPanel.Dock="Left" Text="t/h" Margin="6,0,12,0" VerticalAlignment="Center"/>
                                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Raggiungi l'obiettivo" Command="{Binding ReachTargetCommand}"/>
                                <TextBlock Foreground="#5B6673" TextWrapping="Wrap" VerticalAlignment="Center" Text="Il software simula e propone modifiche al layout e alle logiche per arrivarci."/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <Border Background="White" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="8,0,0,16">
                        <StackPanel>
                            <TextBlock Text="2 · Azionamenti (decisi dal software)" FontSize="16" FontWeight="Bold"/>
                            <ItemsControl ItemsSource="{Binding DriveRows}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock FontWeight="SemiBold"><Run Text="{Binding Module, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Role, Mode=OneWay}"/></TextBlock>
                                            <TextBlock Grid.Column="1" Text="{Binding Drive}" Foreground="#34465C" TextWrapping="Wrap"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </UniformGrid>
                <Border Background="White" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="3 · Tempi delle macchine, per famiglia" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="Valgono per tutte le macchine della famiglia; le eccezioni si sbloccano dalla singola macchina (Personalizza) nel passo Layout e simulazione." Foreground="#5B6673" TextWrapping="Wrap" Margin="0,2,0,8"/>
                        <ItemsControl ItemsSource="{Binding CycleFamilies}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,6,16,10">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,0,0,4"/>
                                        <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource PropEditor}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Style="{StaticResource ToolButton}" Content="Indietro: Pacchi" Command="{Binding GoStepCommand}" CommandParameter="Packages"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="Avanti: Layout e simulazione" Margin="8,2,2,2" Command="{Binding GoStepCommand}" CommandParameter="Layout"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <Grid Visibility="{Binding IsStepCycle, Converter={StaticResource InvBoolVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- Binario icone: mostra / nasconde i pannelli -->
            <Border Grid.Column="0" Width="60" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
                <StackPanel Margin="0,10" HorizontalAlignment="Center">
                    <ToggleButton Style="{StaticResource RailToggle}" Content="▦" IsChecked="{Binding ShowLibrary, Mode=TwoWay}" ToolTip="Libreria macchine: mostra / nascondi"/>
                    <ToggleButton Style="{StaticResource RailToggle}" Content="☰" IsChecked="{Binding ShowInspector, Mode=TwoWay}" ToolTip="Proprietà e struttura: mostra / nascondi"/>
                    <ToggleButton Style="{StaticResource RailToggle}" Content="∿" IsChecked="{Binding ShowCyclogram, Mode=TwoWay}" ToolTip="Ciclogramma: mostra / nascondi"/>
                </StackPanel>
            </Border>
            <!-- Libreria (sinistra) -->
            <Border Grid.Column="1" Width="{Binding LibraryWidth}" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0"
                    Visibility="{Binding ShowLibrary, Converter={StaticResource BoolVis}}">
                <DockPanel Background="White">
                        <DockPanel DockPanel.Dock="Top" Margin="12,12,8,4">
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="✕" ToolTip="Nascondi la libreria" Command="{Binding ToggleLibraryCommand}"/>
                            <TextBlock Text="Libreria macchine" FontSize="15" FontWeight="Bold" Foreground="#1B2430" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Top" Foreground="#5A6672" Margin="6,0,6,6" TextWrapping="Wrap" Text="Trascina una macchina nell'area 3D per inserirla."/>
                        <ListBox x:Name="LibraryList" ItemsSource="{Binding LibraryView}" BorderThickness="0" HorizontalContentAlignment="Stretch"
                                 PreviewMouseLeftButtonDown="Library_PreviewMouseLeftButtonDown" PreviewMouseMove="Library_PreviewMouseMove"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="2,8,0,2"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2" ToolTip="{Binding Description}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#F0F3F6" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="3" Width="38" Height="32">
                                            <Path Data="{Binding Icon}" Stroke="#4A5560" StrokeThickness="1.6" Stretch="Uniform" Margin="4"/>
                                        </Border>
