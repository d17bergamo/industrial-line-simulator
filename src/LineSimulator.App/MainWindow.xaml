<Window x:Class="LineSimulator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="http://helix-toolkit.org/wpf"
        xmlns:vm="clr-namespace:LineSimulator.App.ViewModels"
        xmlns:mvvm="clr-namespace:LineSimulator.App.Mvvm"
        xmlns:ctl="clr-namespace:LineSimulator.App.Controls"
        Icon="Assets/app.ico" Title="{Binding Title}" Height="900" Width="1500" WindowState="Maximized"
        FontFamily="Segoe UI" FontSize="12" Background="{StaticResource PanelBg}">
    <Window.Resources>
        <mvvm:EqualsToVisibilityConverter x:Key="EqVis"/>
        <mvvm:NullToCollapsedConverter x:Key="NullVis"/>
        <mvvm:RatioToWidthConverter x:Key="RatioWidth"/>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
                                    <DataTemplate x:Key="PropEditor" DataType="{x:Type vm:PropertyItemViewModel}">
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.55*"/>
                                            <ColumnDefinition Width="0.45*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="{Binding Name}"/>
                                        <TextBox Grid.Column="1" Text="{Binding TextValue, UpdateSourceTrigger=LostFocus}" IsReadOnly="{Binding IsReadOnly}"
                                                 Visibility="{Binding Kind, Converter={StaticResource EqVis}, ConverterParameter=Text}" KeyDown="PropertyBox_KeyDown"/>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding BoolValue}" IsEnabled="{Binding IsEditable}" VerticalAlignment="Center"
                                                  Visibility="{Binding Kind, Converter={StaticResource EqVis}, ConverterParameter=Bool}"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedItem="{Binding ChoiceValue}" IsEnabled="{Binding IsEditable}"
                                                  Visibility="{Binding Kind, Converter={StaticResource EqVis}, ConverterParameter=Choice}"/>
                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Error}" Foreground="#C0392B" TextWrapping="Wrap"
                                                   Visibility="{Binding Error, Converter={StaticResource NullVis}}"/>
                                    </Grid>
                                </DataTemplate>
        <Style x:Key="HomeTile" TargetType="Button">
            <Setter Property="Width" Value="330"/>
            <Setter Property="Height" Value="250"/>
            <Setter Property="Margin" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Tile" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="2" CornerRadius="10" Padding="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Tile" Property="Background" Value="#F0F6FC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Menu -->
        <Menu DockPanel.Dock="Top" Background="White">
            <MenuItem Header="_Home" Command="{Binding GoHomeCommand}"/>
            <MenuItem Header="_File">
                <MenuItem Header="_Nuovo progetto" Command="{Binding NewCommand}"/>
                <MenuItem Header="_Apri..." Command="{Binding OpenCommand}" InputGestureText="Ctrl+O"/>
                <MenuItem Header="_Salva" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S"/>
                <MenuItem Header="Salva _con nome..." Command="{Binding SaveAsCommand}"/>
                <MenuItem Header="_Duplica progetto" Command="{Binding DuplicateCommand}"/>
                <Separator/>
                <MenuItem Header="Salva _layout..." Command="{Binding SaveLayoutCommand}"/>
                <MenuItem Header="Apri l_ayout..." Command="{Binding OpenLayoutCommand}"/>
                <MenuItem Header="Salva tipologie _pacchi..." Command="{Binding SavePackagesCommand}"/>
                <MenuItem Header="Apri tipologie pa_cchi..." Command="{Binding OpenPackagesCommand}"/>
                <Separator/>
                <MenuItem Header="_Esempi" ItemsSource="{Binding Examples}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding Name}"/>
                            <Setter Property="Command" Value="{Binding DataContext.LoadExampleCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <Setter Property="CommandParameter" Value="{Binding}"/>
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Esporta risultati _CSV..." Command="{Binding ExportCsvCommand}"/>
                <MenuItem Header="Esporta risultati _Excel..." Command="{Binding ExportExcelCommand}"/>
                <MenuItem Header="Esporta _logica di controllo (JSON/CSV)..." Command="{Binding ExportControlLogicCommand}"/>
                <MenuItem Header="Esporta specifica _funzionale (Word)..." Command="{Binding ExportFunctionalSpecCommand}"/>
                <Separator/>
                <MenuItem Header="_Esci" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Vista">
                <MenuItem Header="Dall'_alto" Click="ViewTop_Click"/>
                <MenuItem Header="_Laterale" Click="ViewSide_Click"/>
                <MenuItem Header="_Isometrica" Click="ViewIso_Click"/>
                <MenuItem Header="_Adatta alla linea" Click="ViewFit_Click"/>
            </MenuItem>
            <MenuItem Header="_Simulazione">
                <MenuItem Header="Avvia" Command="{Binding PlayCommand}" InputGestureText="F5"/>
                <MenuItem Header="Pausa" Command="{Binding PauseCommand}"/>
                <MenuItem Header="Stop (risultati parziali)" Command="{Binding StopCommand}"/>
                <MenuItem Header="Reset" Command="{Binding ResetCommand}"/>
                <Separator/>
                <MenuItem Header="Passo singolo" Command="{Binding StepCommand}" InputGestureText="F10"/>
                <MenuItem Header="Evento successivo" Command="{Binding NextEventCommand}" InputGestureText="F11"/>
                <MenuItem Header="Esegui fino al termine" Command="{Binding RunToEndCommand}"/>
            </MenuItem>
            <MenuItem Header="_Ottimizzazione">
                <MenuItem Header="Ottimizza zone di comando (minimo numero di inverter)..." Command="{Binding OptimizeCommandZonesCommand}"/>
            </MenuItem>
        </Menu>
        <!-- Barra di stato -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource HeaderBg}">
            <DockPanel Margin="8,3">
                <TextBlock DockPanel.Dock="Right" Foreground="#BDC3C7" Text="Strumento di progettazione - non è un sistema di sicurezza certificato"/>
                <TextBlock Foreground="White" Text="{Binding Status}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
        <Grid>
            <Grid Background="{StaticResource PanelBg}" Visibility="{Binding CurrentSection, Converter={StaticResource EqVis}, ConverterParameter=Home}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Industrial Line Simulator" FontSize="34" FontWeight="SemiBold" Foreground="#26323D" HorizontalAlignment="Center"/>
                    <Border Height="24"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource HomeTile}" Command="{Binding GoSectionCommand}" CommandParameter="Layout">
                        <StackPanel>
                            <Path Data="M4,52 L92,52 L92,64 L4,64 Z M18,52 L18,64 M34,52 L34,64 M50,52 L50,64 M66,52 L66,64 M80,52 L80,64 M28,10 L68,10 L68,44 L28,44 Z" Stroke="{StaticResource Accent}" StrokeThickness="3" StrokeLineJoin="Round" Width="96" Height="72" Stretch="Uniform" HorizontalAlignment="Center"/>
                            <TextBlock Text="LAYOUT E SIMULAZIONE" FontSize="22" FontWeight="SemiBold" Foreground="#26323D" HorizontalAlignment="Center" Margin="0,16,0,6"/>
                            <TextBlock Text="Imposta il layout 3D, modifica le macchine ed esegui le simulazioni." TextWrapping="Wrap" TextAlignment="Center" Foreground="#5A6672" FontSize="14" MaxWidth="260"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource HomeTile}" Command="{Binding GoSectionCommand}" CommandParameter="Packages">
                        <StackPanel>
                            <Path Data="M8,20 L48,4 L88,20 L88,52 L48,68 L8,52 Z M8,20 L48,36 L88,20 M48,36 L48,68" Stroke="{StaticResource Accent}" StrokeThickness="3" StrokeLineJoin="Round" Width="96" Height="72" Stretch="Uniform" HorizontalAlignment="Center"/>
                            <TextBlock Text="CARATTERISTICHE PACCHI" FontSize="22" FontWeight="SemiBold" Foreground="#26323D" HorizontalAlignment="Center" Margin="0,16,0,6"/>
                            <TextBlock Text="Definizione delle tipologie di pacchi da utilizzare nelle simulazioni." TextWrapping="Wrap" TextAlignment="Center" Foreground="#5A6672" FontSize="14" MaxWidth="260"/>
                        </StackPanel>
                    </Button>
                    
                    </StackPanel>
                </StackPanel>
            </Grid>
            <DockPanel Visibility="{Binding CurrentSection, Converter={StaticResource EqVis}, ConverterParameter=Layout}">
        <!-- Barra superiore -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Height="56">
            <DockPanel Margin="12,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="💾  Salva" Command="{Binding SaveCommand}" Margin="8,0,0,0"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="✔  Controlla equipaggiamenti" Command="{Binding CheckEquipmentCommand}" ToolTip="Controlla con regole gli equipaggiamenti (prima fotocellula presente, nella posizione giusta e rinominata) e applica le correzioni"/>
                <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="⌂" FontSize="18" Command="{Binding GoHomeCommand}" ToolTip="Torna alla schermata iniziale"/>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="8,0,16,0">
                    <TextBlock Text="{Binding Project.Name}" FontWeight="Bold" FontSize="14" Foreground="#1B2430"/>
                    <TextBlock Text="Layout e simulazione" Foreground="#5B6673"/>
                </StackPanel>
                <Border DockPanel.Dock="Left" Background="#EEF0F3" CornerRadius="10" Padding="3" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="White" CornerRadius="7" Padding="14,6"><TextBlock Text="Layout e simulazione" FontWeight="SemiBold"/></Border>
                        <Button Style="{StaticResource SegmentButton}" Content="Pacchi" Command="{Binding GoSectionCommand}" CommandParameter="Packages"/>
                    </StackPanel>
                </Border>
                <Button DockPanel.Dock="Left" x:Name="AddMenuButton" Style="{StaticResource ToolButton}" Content="＋  Aggiungi  ▾" Margin="16,0,0,0" Click="AddMenu_Click" ToolTip="Aggiunge un componente al progetto (le macchine si trascinano anche dalla libreria)">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Modulo via a rulli" Command="{Binding AddSectionCommand}"/>
                            <MenuItem Header="Fotocellula" Command="{Binding AddPhotocellCommand}"/>
                            <MenuItem Header="Legatrice" Command="{Binding AddStrapperCommand}"/>
                            <MenuItem Header="Fermo intermedio" Command="{Binding AddStopCommand}"/>
                            <MenuItem Header="Bilico" Command="{Binding AddScaleCommand}"/>
                            <Separator/>
                            <MenuItem Header="Tipologia di pacco" Command="{Binding AddPackageTypeCommand}"/>
                            <MenuItem Header="Regola" Command="{Binding AddRuleCommand}"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
<TextBlock Text="Tipologia di pacco:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Width="260" ItemsSource="{Binding PackageTypes}" SelectedItem="{Binding SimPackageType, Mode=TwoWay}" VerticalAlignment="Center"/>
                        <TextBlock Text="Banking:" VerticalAlignment="Center" Margin="12,0,6,0"/>
                        <ComboBox Width="130" ItemsSource="{Binding BankingModes}" SelectedItem="{Binding SimBanking, Mode=TwoWay}" VerticalAlignment="Center" ToolTip="Single banking: un pacco per sezione. Double banking: due pacchi."/>
                        <TextBlock Text="Intestatura:" VerticalAlignment="Center" Margin="12,0,6,0"/>
                        <ComboBox Width="90" ItemsSource="{Binding HeadingModes}" SelectedItem="{Binding SimHeading, Mode=TwoWay}" VerticalAlignment="Center" ToolTip="Head = di testa, Tail = di coda (solo con un fermo intermedio scomparente: il pacco lo supera, il fermo si solleva e il pacco torna indietro)"/>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Style="{StaticResource KpiLabel}" Text="Pacchi/ora"/><TextBlock FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource Accent}" Text="{Binding Results.PackagesPerHour, StringFormat={}{0:0.0}, FallbackValue=-, TargetNullValue=-}"/></StackPanel>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Style="{StaticResource KpiLabel}" Text="Tonnellate/ora"/><TextBlock FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource Accent}" Text="{Binding Results.TonnesPerHour, StringFormat={}{0:0.0}, FallbackValue=-, TargetNullValue=-}"/></StackPanel>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Style="{StaticResource KpiLabel}" Text="Tempo ciclo medio [s]"/><TextBlock FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource Accent}" Text="{Binding Results.CycleTimeMeanS, StringFormat={}{0:0.0}, FallbackValue=-, TargetNullValue=-}"/></StackPanel>
            
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- Binario icone: mostra / nasconde i pannelli -->
            <Border Grid.Column="0" Width="60" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
                <StackPanel Margin="0,10" HorizontalAlignment="Center">
                    <ToggleButton Style="{StaticResource RailToggle}" Content="▦" IsChecked="{Binding ShowLibrary, Mode=TwoWay}" ToolTip="Libreria macchine: mostra / nascondi"/>
                    <ToggleButton Style="{StaticResource RailToggle}" Content="☰" IsChecked="{Binding ShowInspector, Mode=TwoWay}" ToolTip="Proprietà e struttura: mostra / nascondi"/>
                    <ToggleButton Style="{StaticResource RailToggle}" Content="∿" IsChecked="{Binding ShowCyclogram, Mode=TwoWay}" ToolTip="Ciclogramma: mostra / nascondi"/>
                </StackPanel>
            </Border>
            <!-- Libreria (sinistra) -->
            <Border Grid.Column="1" Width="264" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0"
                    Visibility="{Binding ShowLibrary, Converter={StaticResource BoolVis}}">
                <DockPanel Background="White">
                        <DockPanel DockPanel.Dock="Top" Margin="12,12,8,4">
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="✕" ToolTip="Nascondi la libreria" Command="{Binding ToggleLibraryCommand}"/>
                            <TextBlock Text="Libreria macchine" FontSize="15" FontWeight="Bold" Foreground="#1B2430" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Top" Foreground="#5A6672" Margin="6,0,6,6" TextWrapping="Wrap" Text="Trascina una macchina nell'area 3D per inserirla."/>
                        <ListBox x:Name="LibraryList" ItemsSource="{Binding LibraryView}" BorderThickness="0" HorizontalContentAlignment="Stretch"
                                 PreviewMouseLeftButtonDown="Library_PreviewMouseLeftButtonDown" PreviewMouseMove="Library_PreviewMouseMove"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="2,8,0,2"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2" ToolTip="{Binding Description}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#F0F3F6" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="3" Width="38" Height="32">
                                            <Path Data="{Binding Icon}" Stroke="#4A5560" StrokeThickness="1.6" Stretch="Uniform" Margin="4"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Category}" Foreground="#5A6672" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
            </Border>
            <TabControl Grid.Column="2" Style="{StaticResource FlatTabs}">
<TabItem Header="Layout e simulazione 3D"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="1">
                        <Grid>
                            <h:HelixViewport3D x:Name="LayoutViewport" ShowCoordinateSystem="True" ShowViewCube="True" ZoomExtentsWhenLoaded="True"
                                               PreviewMouseLeftButtonDown="LayoutViewport_PreviewMouseLeftButtonDown" PreviewMouseMove="MoveViewport_PreviewMouseMove"
                                               PreviewMouseLeftButtonUp="MoveViewport_PreviewMouseLeftButtonUp"
                                               AllowDrop="True" DragEnter="LayoutViewport_DragOver" DragOver="LayoutViewport_DragOver"
                                               DragLeave="LayoutViewport_DragLeave" Drop="LayoutViewport_Drop" Background="White">
                                <h:DefaultLights/>
                            </h:HelixViewport3D>
                        <Border VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="4">
                            <StackPanel>
                                <Button Style="{StaticResource IconButton}" Content="⧉" FontSize="16" Command="{Binding DuplicateSelectedCommand}" ToolTip="Duplica i componenti selezionati"/>
                                <Button Style="{StaticResource IconButton}" Content="↻" FontSize="18" Command="{Binding RotateSelectedCommand}" ToolTip="Ruota di 180°: porta il dispositivo sul lato opposto"/>
                                <ToggleButton Style="{StaticResource IconToggle}" Content="⟷" FontSize="16" IsChecked="{Binding ShowDistances}" ToolTip="Mostra le quote dall'origine"/>
                                <Button Style="{StaticResource IconButton}" Content="🗑" FontSize="15" Foreground="#B42318" Command="{Binding DeleteCommand}" ToolTip="Elimina i componenti selezionati"/>
                            </StackPanel>
                        </Border>
                        <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="8,34,0,0" Background="#E6FFFFFF" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="3">
<WrapPanel>
                <Button Style="{StaticResource ToolButton}" Content="▶ Play" Command="{Binding PlayCommand}" Click="Play_Click" FontWeight="SemiBold" Foreground="#1E8449"/>
                <Button Style="{StaticResource ToolButton}" Content="❚❚ Pausa" Command="{Binding PauseCommand}"/>
                <Button Style="{StaticResource ToolButton}" Content="■ Stop" Command="{Binding StopCommand}"/>
                <Button Style="{StaticResource ToolButton}" Content="⟲ Reset" Command="{Binding ResetCommand}"/>
                <Button Style="{StaticResource ToolButton}" Content="Passo" Command="{Binding StepCommand}" ToolTip="Avanza di un passo di integrazione"/>
                <Button Style="{StaticResource ToolButton}" Content="Evento ▸" Command="{Binding NextEventCommand}" ToolTip="Avanza fino al prossimo evento"/>
                <Button Style="{StaticResource ToolButton}" Content="Fino al termine ▸▸" Command="{Binding RunToEndCommand}"/>
                <TextBlock Text="Velocità:" VerticalAlignment="Center" Margin="10,0,4,0"/>
                <ComboBox Width="70" ItemsSource="{Binding Speeds}" SelectedItem="{Binding SpeedFactor}" VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StringFormat={}{0}x}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Style="{StaticResource ToolButton}" Content="Velocità linea…" Click="OpenSpeed_Click" ToolTip="Velocità di trasporto 0,5-1,5 m/s e produttività oraria"/>
                
</WrapPanel>
                        </Border>
                        <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,8,70,0" Background="#E6FFFFFF" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="3">
                            <WrapPanel>
                                <Button Style="{StaticResource ToolButton}" Content="Alto" Click="ViewTop_Click"/>
                                <Button Style="{StaticResource ToolButton}" Content="Frontale" Click="ViewFront_Click"/>
                                <Button Style="{StaticResource ToolButton}" Content="Laterale" Click="ViewSide_Click"/>
                                <Button Style="{StaticResource ToolButton}" Content="Isometrica" Click="ViewIso_Click"/>
                                <Button Style="{StaticResource ToolButton}" Content="Adatta" Click="ViewFit_Click"/>
                            </WrapPanel>
                        </Border>
                        </Grid>
                    </Border>
                <!-- Timeline -->
                <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="1,0,1,1" Padding="6,4">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="Timeline" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding DisplayTimeText}" Width="80" VerticalAlignment="Center" TextAlignment="Right" FontFamily="Consolas"/>
                        <Slider Minimum="0" Maximum="{Binding MaxTime}" Value="{Binding DisplayTime, Mode=TwoWay}" VerticalAlignment="Center" IsMoveToPointEnabled="True"/>
                    </DockPanel>
                </Border>
<Border Grid.Row="2" Height="240" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="1,1,1,0"
        Visibility="{Binding ShowCyclogram, Converter={StaticResource BoolVis}}">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="8,4,4,2">
            <Button DockPanel.Dock="Right" Content="✕" Padding="8,0" ToolTip="Nascondi il ciclogramma" Command="{Binding ToggleCyclogramCommand}" BorderThickness="0" Background="Transparent"/>
            <TextBlock Text="Ciclogramma" FontWeight="SemiBold" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
            <TextBlock Text="  Clic sul diagramma: porta il 3D a quell'istante" Foreground="#5A6672" VerticalAlignment="Center"/>
        </DockPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ctl:CyclogramControl x:Name="DockedCyclogram" Recorder="{Binding Recorder}" CursorTime="{Binding DisplayTime, Mode=TwoWay}"
                                  MaxTime="{Binding MaxTime}" Version="{Binding CyclogramVersion}"/>
        </ScrollViewer>
    </DockPanel>
</Border>
</Grid></TabItem>
                    <TabItem Header="Ciclogramma a gradini">
                        <DockPanel Background="White">
                            <Border DockPanel.Dock="Top" Padding="6,4" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                                <WrapPanel>
                                    <Button Style="{StaticResource ToolButton}" Content="Aggiorna" Command="{Binding RefreshStepCommand}"/>
                                    <Button Style="{StaticResource ToolButton}" Content="Esporta PDF…" Command="{Binding ExportStepPdfCommand}"/>
                                    <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#5A6672"
                                               Text="Tempi arrotondati a 0,5 s per eccesso solo in questo ciclogramma. Livelli: fermo / lento o transizione / attivo."/>
                                </WrapPanel>
                            </Border>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <ctl:StepCyclogramControl Rows="{Binding StepRows}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Ciclogramma e risultati">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0">
                <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="3">
<WrapPanel>
                <Button Style="{StaticResource ToolButton}" Content="▶ Play" Command="{Binding PlayCommand}" Click="Play_Click" FontWeight="SemiBold" Foreground="#1E8449"/>
                <Button Style="{StaticResource ToolButton}" Content="❚❚ Pausa" Command="{Binding PauseCommand}"/>
                <Button Style="{StaticResource ToolButton}" Content="■ Stop" Command="{Binding StopCommand}"/>
                <Button Style="{StaticResource ToolButton}" Content="⟲ Reset" Command="{Binding ResetCommand}"/>
                <Button Style="{StaticResource ToolButton}" Content="Passo" Command="{Binding StepCommand}" ToolTip="Avanza di un passo di integrazione"/>
                <Button Style="{StaticResource ToolButton}" Content="Evento ▸" Command="{Binding NextEventCommand}" ToolTip="Avanza fino al prossimo evento"/>
                <Button Style="{StaticResource ToolButton}" Content="Fino al termine ▸▸" Command="{Binding RunToEndCommand}"/>
                <TextBlock Text="Velocità:" VerticalAlignment="Center" Margin="10,0,4,0"/>
                <ComboBox Width="70" ItemsSource="{Binding Speeds}" SelectedItem="{Binding SpeedFactor}" VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StringFormat={}{0}x}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                
</WrapPanel>
                </Border>
                            <DockPanel DockPanel.Dock="Top" Margin="4,2">
                                <Button DockPanel.Dock="Right" Content="Mostra tutto" Click="CycloFit_Click" Padding="6,1" Margin="2"/>
                                <Button DockPanel.Dock="Right" Content="Segui cursore" Click="CycloFollow_Click" Padding="6,1" Margin="2"/>
                                <ItemsControl x:Name="LegendList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                                                <Rectangle Width="12" Height="10" Fill="{Binding Brush}" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Label}" FontSize="10" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ctl:CyclogramControl x:Name="Cyclogram" Recorder="{Binding Recorder}" CursorTime="{Binding DisplayTime, Mode=TwoWay}"
                                                      MaxTime="{Binding MaxTime}" Version="{Binding CyclogramVersion}"/>
                            </ScrollViewer>
            </DockPanel>
