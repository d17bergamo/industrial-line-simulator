<Window x:Class="LineSimulator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="http://helix-toolkit.org/wpf"
        xmlns:vm="clr-namespace:LineSimulator.App.ViewModels"
        xmlns:mvvm="clr-namespace:LineSimulator.App.Mvvm"
        xmlns:ctl="clr-namespace:LineSimulator.App.Controls"
        Icon="Assets/app.ico" Title="{Binding Title}" Height="900" Width="1500" WindowState="Maximized"
        FontFamily="Segoe UI" FontSize="12" Background="{StaticResource PanelBg}">
    <Window.Resources>
        <mvvm:EqualsToVisibilityConverter x:Key="EqVis"/>
        <mvvm:NullToCollapsedConverter x:Key="NullVis"/>
        <mvvm:RatioToWidthConverter x:Key="RatioWidth"/>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
                                    <DataTemplate x:Key="PropEditor" DataType="{x:Type vm:PropertyItemViewModel}">
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.55*"/>
                                            <ColumnDefinition Width="0.45*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="{Binding Name}"/>
                                        <TextBox Grid.Column="1" Text="{Binding TextValue, UpdateSourceTrigger=LostFocus}" IsReadOnly="{Binding IsReadOnly}"
                                                 Visibility="{Binding Kind, Converter={StaticResource EqVis}, ConverterParameter=Text}" KeyDown="PropertyBox_KeyDown"/>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding BoolValue}" IsEnabled="{Binding IsEditable}" VerticalAlignment="Center"
                                                  Visibility="{Binding Kind, Converter={StaticResource EqVis}, ConverterParameter=Bool}"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedItem="{Binding ChoiceValue}" IsEnabled="{Binding IsEditable}"
                                                  Visibility="{Binding Kind, Converter={StaticResource EqVis}, ConverterParameter=Choice}"/>
                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Error}" Foreground="#C0392B" TextWrapping="Wrap"
                                                   Visibility="{Binding Error, Converter={StaticResource NullVis}}"/>
                                    </Grid>
                                </DataTemplate>
        <Style x:Key="HomeTile" TargetType="Button">
            <Setter Property="Width" Value="330"/>
            <Setter Property="Height" Value="250"/>
            <Setter Property="Margin" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Tile" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="2" CornerRadius="10" Padding="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Tile" Property="Background" Value="#F0F6FC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Menu -->
        <Menu DockPanel.Dock="Top" Background="White">
            <MenuItem Header="_Home" Command="{Binding GoHomeCommand}"/>
            <MenuItem Header="_File">
                <MenuItem Header="_Nuovo progetto" Command="{Binding NewCommand}"/>
                <MenuItem Header="_Apri..." Command="{Binding OpenCommand}" InputGestureText="Ctrl+O"/>
                <MenuItem Header="_Salva" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S"/>
                <MenuItem Header="Salva _con nome..." Command="{Binding SaveAsCommand}"/>
                <MenuItem Header="_Duplica progetto" Command="{Binding DuplicateCommand}"/>
                <Separator/>
                <MenuItem Header="Salva _layout..." Command="{Binding SaveLayoutCommand}"/>
                <MenuItem Header="Apri l_ayout..." Command="{Binding OpenLayoutCommand}"/>
                <MenuItem Header="Salva tipologie _pacchi..." Command="{Binding SavePackagesCommand}"/>
                <MenuItem Header="Apri tipologie pa_cchi..." Command="{Binding OpenPackagesCommand}"/>
                <Separator/>
                <MenuItem Header="_Esempi" ItemsSource="{Binding Examples}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding Name}"/>
                            <Setter Property="Command" Value="{Binding DataContext.LoadExampleCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <Setter Property="CommandParameter" Value="{Binding}"/>
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Esporta risultati _CSV..." Command="{Binding ExportCsvCommand}"/>
                <MenuItem Header="Esporta risultati _Excel..." Command="{Binding ExportExcelCommand}"/>
                <MenuItem Header="Esporta _logica di controllo (JSON/CSV)..." Command="{Binding ExportControlLogicCommand}"/>
                <MenuItem Header="Esporta specifica _funzionale (Word)..." Command="{Binding ExportFunctionalSpecCommand}"/>
                <Separator/>
                <MenuItem Header="_Esci" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Vista">
                <MenuItem Header="Dall'_alto" Click="ViewTop_Click"/>
                <MenuItem Header="_Laterale" Click="ViewSide_Click"/>
                <MenuItem Header="_Isometrica" Click="ViewIso_Click"/>
                <MenuItem Header="_Adatta alla linea" Click="ViewFit_Click"/>
            </MenuItem>
            <MenuItem Header="_Simulazione">
                <MenuItem Header="Avvia" Command="{Binding PlayCommand}" InputGestureText="F5"/>
                <MenuItem Header="Pausa" Command="{Binding PauseCommand}"/>
                <MenuItem Header="Stop (risultati parziali)" Command="{Binding StopCommand}"/>
                <MenuItem Header="Reset" Command="{Binding ResetCommand}"/>
                <Separator/>
                <MenuItem Header="Passo singolo" Command="{Binding StepCommand}" InputGestureText="F10"/>
                <MenuItem Header="Evento successivo" Command="{Binding NextEventCommand}" InputGestureText="F11"/>
                <MenuItem Header="Esegui fino al termine" Command="{Binding RunToEndCommand}"/>
            </MenuItem>
            <MenuItem Header="_Ottimizzazione">
                <MenuItem Header="Ottimizza zone di comando (minimo numero di inverter)..." Command="{Binding OptimizeCommandZonesCommand}"/>
            </MenuItem>
        </Menu>
        <!-- Barra di stato -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource HeaderBg}">
            <DockPanel Margin="8,3">
                <TextBlock DockPanel.Dock="Right" Foreground="#BDC3C7" Text="Strumento di progettazione - non è un sistema di sicurezza certificato"/>
                <TextBlock Foreground="White" Text="{Binding Status}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
        <Grid>
            <Grid Background="{StaticResource PanelBg}" Visibility="{Binding CurrentSection, Converter={StaticResource EqVis}, ConverterParameter=Home}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Industrial Line Simulator" FontSize="34" FontWeight="SemiBold" Foreground="#26323D" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Project.Name}" FontSize="15" Foreground="#5A6672" HorizontalAlignment="Center" Margin="0,4,0,24"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource HomeTile}" Command="{Binding GoSectionCommand}" CommandParameter="Layout">
                        <StackPanel>
                            <Path Data="M4,52 L92,52 L92,64 L4,64 Z M18,52 L18,64 M34,52 L34,64 M50,52 L50,64 M66,52 L66,64 M80,52 L80,64 M28,10 L68,10 L68,44 L28,44 Z" Stroke="{StaticResource Accent}" StrokeThickness="3" StrokeLineJoin="Round" Width="96" Height="72" Stretch="Uniform" HorizontalAlignment="Center"/>
                            <TextBlock Text="IMPOSTA LAYOUT" FontSize="22" FontWeight="SemiBold" Foreground="#26323D" HorizontalAlignment="Center" Margin="0,16,0,6"/>
                            <TextBlock Text="Progettazione geometrica della linea industriale." TextWrapping="Wrap" TextAlignment="Center" Foreground="#5A6672" FontSize="14" MaxWidth="260"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource HomeTile}" Command="{Binding GoSectionCommand}" CommandParameter="Packages">
                        <StackPanel>
                            <Path Data="M8,20 L48,4 L88,20 L88,52 L48,68 L8,52 Z M8,20 L48,36 L88,20 M48,36 L48,68" Stroke="{StaticResource Accent}" StrokeThickness="3" StrokeLineJoin="Round" Width="96" Height="72" Stretch="Uniform" HorizontalAlignment="Center"/>
                            <TextBlock Text="CARATTERISTICHE PACCHI" FontSize="22" FontWeight="SemiBold" Foreground="#26323D" HorizontalAlignment="Center" Margin="0,16,0,6"/>
                            <TextBlock Text="Definizione delle tipologie di pacchi da utilizzare nelle simulazioni." TextWrapping="Wrap" TextAlignment="Center" Foreground="#5A6672" FontSize="14" MaxWidth="260"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource HomeTile}" Command="{Binding GoSectionCommand}" CommandParameter="Simulations">
                        <StackPanel>
                            <Path Data="M48,4 A32,32 0 1 0 48.01,4 Z M38,22 L68,36 L38,50 Z" Stroke="{StaticResource Accent}" StrokeThickness="3" StrokeLineJoin="Round" Width="96" Height="72" Stretch="Uniform" HorizontalAlignment="Center"/>
                            <TextBlock Text="SIMULAZIONI" FontSize="22" FontWeight="SemiBold" Foreground="#26323D" HorizontalAlignment="Center" Margin="0,16,0,6"/>
                            <TextBlock Text="Visualizzazione 3D ed esecuzione delle simulazioni." TextWrapping="Wrap" TextAlignment="Center" Foreground="#5A6672" FontSize="14" MaxWidth="260"/>
                        </StackPanel>
                    </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
            <DockPanel Visibility="{Binding CurrentSection, Converter={StaticResource EqVis}, ConverterParameter=Layout}">
        <!-- Barra strumenti -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <WrapPanel Margin="4,2">
                <Button Style="{StaticResource ToolButton}" Content="⌂ Home" Command="{Binding GoHomeCommand}" FontWeight="SemiBold" ToolTip="Torna alla schermata iniziale"/>
                <TextBlock Text="IMPOSTA LAYOUT" FontWeight="SemiBold" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="6,0,12,0"/>
                <TextBlock Text="Aggiungi:" VerticalAlignment="Center" Margin="4,0" Foreground="#5A6672"/>
                <Button Style="{StaticResource ToolButton}" Content="Modulo rulli" Command="{Binding AddSectionCommand}" ToolTip="Aggiungi un modulo di via a rulli (con il proprio inverter) in coda alla linea"/>
                <Button Style="{StaticResource ToolButton}" Content="Fotocellula" Command="{Binding AddPhotocellCommand}"/>
                <Button Style="{StaticResource ToolButton}" Content="Legatrice" Command="{Binding AddStrapperCommand}" ToolTip="Massimo 3 legatrici"/>
                <Button Style="{StaticResource ToolButton}" Content="Tipologia pacco" Command="{Binding AddPackageTypeCommand}"/>
                <Button Style="{StaticResource ToolButton}" Content="Regola" Command="{Binding AddRuleCommand}"/>
                <Button Style="{StaticResource ToolButton}" Content="Fermo" Command="{Binding AddStopCommand}" ToolTip="Fermo intermedio nella zona dello stopper (intestatura di testa o di coda)"/>
                <Button Style="{StaticResource ToolButton}" Content="Bilico" Command="{Binding AddScaleCommand}" ToolTip="Bilico di pesatura sul lato di deposito del trasferitore"/>
                <Button Style="{StaticResource ToolButton}" Content="Elimina" Command="{Binding DeleteCommand}" Foreground="#C0392B"/>
                <Button Style="{StaticResource ToolButton}" Content="Duplica" Command="{Binding DuplicateSelectedCommand}" ToolTip="Duplica il componente selezionato"/>
                <Button Style="{StaticResource ToolButton}" Content="Ruota 180°" Command="{Binding RotateSelectedCommand}" ToolTip="Porta il dispositivo sul lato opposto della linea"/>
                <CheckBox Content="MOSTRA DISTANZE DALL'ORIGINE" IsChecked="{Binding ShowDistances}" VerticalAlignment="Center" Margin="12,0,6,0" FontWeight="SemiBold"/>
                <Button Style="{StaticResource ToolButton}" Content="Libreria ⇄" Click="ToggleLibrary_Click" ToolTip="Comprimi o espandi la libreria macchine"/>
            </WrapPanel>
        </Border>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" MinWidth="220"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition x:Name="LibrarySplitterColumn" Width="5"/>
                        <ColumnDefinition x:Name="LibraryColumn" Width="290" MinWidth="0"/>
                    </Grid.ColumnDefinitions>
            <!-- Pannello laterale: albero + proprietà -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="3*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="Struttura della linea"/>
                    <TreeView x:Name="LineTree" ItemsSource="{Binding Tree}" SelectedItemChanged="LineTree_SelectedItemChanged" BorderThickness="0">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type vm:TreeNodeViewModel}" ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding Header}" Margin="2,1"/>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
                <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="{StaticResource Border}"/>
                <DockPanel Grid.Row="2" Background="White">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="Proprietà del componente selezionato"/>
                    <StackPanel DockPanel.Dock="Top" Margin="4,0,4,4" Visibility="{Binding TransferSectionsVisible, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="Sezioni del trasferitore (numero, nome, lunghezza)" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,4,0,2"/>
                        <DataGrid ItemsSource="{Binding TransferSections}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column" MaxHeight="150" x:Name="TransferSectionsGrid">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nome" Binding="{Binding Name, UpdateSourceTrigger=LostFocus}" Width="*"/>
                                <DataGridTextColumn Header="Lunghezza [mm]" Binding="{Binding LengthMm, UpdateSourceTrigger=LostFocus}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <Button Content="+ Sezione" Padding="8,1" Command="{Binding AddTransferSectionCommand}"/>
                            <Button Content="− Elimina" Padding="8,1" Margin="6,0,0,0" Command="{Binding RemoveTransferSectionCommand}"
                                    CommandParameter="{Binding SelectedItem, ElementName=TransferSectionsGrid}"/>
                        </StackPanel>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding PropertiesView}" Margin="4,0,4,8">
                            <ItemsControl.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,8,0,2"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ItemsControl.GroupStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PropertyItemViewModel}">
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.55*"/>
                                            <ColumnDefinition Width="0.45*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="{Binding Name}"/>
                                        <TextBox Grid.Column="1" Text="{Binding TextValue, UpdateSourceTrigger=LostFocus}" IsReadOnly="{Binding IsReadOnly}"
                                                 Visibility="{Binding Kind, Converter={StaticResource EqVis}, ConverterParameter=Text}" KeyDown="PropertyBox_KeyDown"/>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding BoolValue}" IsEnabled="{Binding IsEditable}" VerticalAlignment="Center"
                                                  Visibility="{Binding Kind, Converter={StaticResource EqVis}, ConverterParameter=Bool}"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedItem="{Binding ChoiceValue}" IsEnabled="{Binding IsEditable}"
                                                  Visibility="{Binding Kind, Converter={StaticResource EqVis}, ConverterParameter=Choice}"/>
                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Error}" Foreground="#C0392B" TextWrapping="Wrap"
                                                   Visibility="{Binding Error, Converter={StaticResource NullVis}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{StaticResource Border}"/>
                    <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="1">
                        <Grid>
                            <h:HelixViewport3D x:Name="LayoutViewport" ShowCoordinateSystem="True" ShowViewCube="True" ZoomExtentsWhenLoaded="True"
                                               PreviewMouseLeftButtonDown="LayoutViewport_PreviewMouseLeftButtonDown" PreviewMouseMove="LayoutViewport_PreviewMouseMove"
                                               PreviewMouseLeftButtonUp="LayoutViewport_PreviewMouseLeftButtonUp"
                                               AllowDrop="True" DragEnter="LayoutViewport_DragOver" DragOver="LayoutViewport_DragOver"
                                               DragLeave="LayoutViewport_DragLeave" Drop="LayoutViewport_Drop" Background="White">
                                <h:DefaultLights/>
                            </h:HelixViewport3D>
                        <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,8,70,0" Background="#E6FFFFFF" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="3">
                            <WrapPanel>
                                <Button Style="{StaticResource ToolButton}" Content="Alto" Click="ViewTop_Click"/>
                                <Button Style="{StaticResource ToolButton}" Content="Frontale" Click="ViewFront_Click"/>
                                <Button Style="{StaticResource ToolButton}" Content="Laterale" Click="ViewSide_Click"/>
                                <Button Style="{StaticResource ToolButton}" Content="Isometrica" Click="ViewIso_Click"/>
                                <Button Style="{StaticResource ToolButton}" Content="Adatta" Click="ViewFit_Click"/>
                            </WrapPanel>
                        </Border>
                        </Grid>
                    </Border>
                    <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="{StaticResource Border}" x:Name="LibrarySplitter"/>
                    <DockPanel Grid.Column="4" Background="White" x:Name="LibraryPanel">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="Libreria macchine"/>
                        <TextBlock DockPanel.Dock="Top" Foreground="#5A6672" Margin="6,0,6,6" TextWrapping="Wrap" Text="Trascina una macchina nell'area 3D per inserirla."/>
                        <ListBox x:Name="LibraryList" ItemsSource="{Binding LibraryView}" BorderThickness="0" HorizontalContentAlignment="Stretch"
                                 PreviewMouseLeftButtonDown="Library_PreviewMouseLeftButtonDown" PreviewMouseMove="Library_PreviewMouseMove"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="2,8,0,2"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2" ToolTip="{Binding Description}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#F0F3F6" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="3" Width="38" Height="32">
                                            <Path Data="{Binding Icon}" Stroke="#4A5560" StrokeThickness="1.6" Stretch="Uniform" Margin="4"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Category}" Foreground="#5A6672" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </DockPanel>
            <DockPanel Visibility="{Binding CurrentSection, Converter={StaticResource EqVis}, ConverterParameter=Packages}">
                <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                    <DockPanel Margin="4,2">
                        <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="＋ Crea pacco" Command="{Binding NewPackageCommand}"
                                FontWeight="SemiBold" Foreground="#1E8449" Padding="14,3" Margin="4,2,10,2" ToolTip="Crea una nuova tipologia di pacco"/>
                        <Button DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Content="⌂ Home" Command="{Binding GoHomeCommand}" FontWeight="SemiBold" ToolTip="Torna alla schermata iniziale"/>
                        <TextBlock DockPanel.Dock="Left" Text="CARATTERISTICHE PACCHI" FontWeight="SemiBold" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="6,0,12,0"/>
                        <Button DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Content="Duplica" Command="{Binding DuplicatePackageCommand}"/>
                        <TextBlock Text="Le tipologie sono indipendenti dal layout della linea." Foreground="#5A6672" VerticalAlignment="Center" Margin="12,0"/>
                    </DockPanel>
                </Border>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" MinWidth="180"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Sinistra: elenco dei pacchi creati -->
                    <DockPanel Grid.Column="0" Background="White">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="Elenco pacchi"/>
                        <ListBox ItemsSource="{Binding PackageTypes}" SelectedItem="{Binding SelectedPackageType, Mode=TwoWay}" BorderThickness="0" FontSize="14"/>
                    </DockPanel>
                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{StaticResource Border}"/>
                    <!-- Centro: vista 3D del pacco, sotto le caratteristiche; in basso a destra Salva e Cestino -->
                    <Grid Grid.Column="2" Background="White">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*" MinHeight="180"/>
                            <RowDefinition Height="5"/>
                            <RowDefinition Height="3*" MinHeight="160"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                            <Grid>
                                <h:HelixViewport3D x:Name="PackageViewport" ShowCoordinateSystem="False" ShowViewCube="True" Background="White">
                                    <h:DefaultLights/>
                                </h:HelixViewport3D>
                                <TextBlock Margin="8" VerticalAlignment="Top" HorizontalAlignment="Left" Foreground="#5A6672" Background="#CCFFFFFF" Padding="4"
                                           Text="Vista 3D del pacco · legature in verde (rosse se fuori dalle distanze minime) · testa a destra"/>
                            </Grid>
                        </Border>
                        <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="{StaticResource Border}"/>
                        <DockPanel Grid.Row="2">
                            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Background="#F7F8F9" Padding="8,6">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="✔ OK, salva" Command="{Binding SavePackagesCommand}" Padding="18,6" FontWeight="SemiBold" Foreground="#1E8449"
                                            ToolTip="Salva le tipologie di pacco in un file"/>
                                    <Button Content="🗑" Command="{Binding DeletePackageCommand}" Padding="14,6" Margin="8,0,0,0" FontSize="16" Foreground="#C0392B"
                                            ToolTip="Cestino: elimina la tipologia selezionata"/>
                                </StackPanel>
                            </Border>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="Caratteristiche del pacco selezionato"/>
                            <Border DockPanel.Dock="Top" BorderBrush="#D0D4D9" BorderThickness="0,0,0,1" Margin="8,0,8,4" MaxHeight="160">
                                <ctl:PackagePreviewControl x:Name="PackagePreview" Package="{Binding SelectedPackageType}" Version="{Binding PackagePreviewVersion}"
                                    ToolTip="Legature: trascina per spostare, doppio clic per aggiungere, clic destro per togliere (posizioni dalla testa)"/>
                            </Border>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding PackagePropertiesView}" ItemTemplate="{StaticResource PropEditor}" Margin="8,0,8,8" MaxWidth="640" HorizontalAlignment="Left">
                                    <ItemsControl.GroupStyle>
                                        <GroupStyle>
                                            <GroupStyle.HeaderTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,10,0,2"/>
                                                </DataTemplate>
                                            </GroupStyle.HeaderTemplate>
                                        </GroupStyle>
                                    </ItemsControl.GroupStyle>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>
                </Grid>
            </DockPanel>
            <DockPanel Visibility="{Binding CurrentSection, Converter={StaticResource EqVis}, ConverterParameter=Simulations}">
                <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                    <WrapPanel Margin="4,2" VerticalAlignment="Center">
                        <Button Style="{StaticResource ToolButton}" Content="⌂ Home" Command="{Binding GoHomeCommand}" FontWeight="SemiBold" ToolTip="Torna alla schermata iniziale"/>
                        <TextBlock Text="SIMULAZIONI" FontWeight="SemiBold" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="6,0,16,0"/>
                        <TextBlock Text="Tipologia di pacco:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Width="260" ItemsSource="{Binding PackageTypes}" SelectedItem="{Binding SimPackageType, Mode=TwoWay}" VerticalAlignment="Center"/>
                        <TextBlock Text="Banking:" VerticalAlignment="Center" Margin="14,0,6,0"/>
                        <ComboBox Width="130" ItemsSource="{Binding BankingModes}" SelectedItem="{Binding SimBanking, Mode=TwoWay}" VerticalAlignment="Center" ToolTip="Single banking: un pacco per sezione. Double banking: due pacchi."/>
                        <TextBlock Text="Intestatura:" VerticalAlignment="Center" Margin="14,0,6,0"/>
