                                                  Visibility="{Binding Kind, Converter={StaticResource EqVis}, ConverterParameter=Bool}"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedItem="{Binding ChoiceValue}" IsEnabled="{Binding IsEditable}"
                                                  Visibility="{Binding Kind, Converter={StaticResource EqVis}, ConverterParameter=Choice}"/>
                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Error}" Foreground="#C0392B" TextWrapping="Wrap"
                                                   Visibility="{Binding Error, Converter={StaticResource NullVis}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel></TabItem>
                        <TabItem Header="Struttura"><DockPanel>
                    <TextBlock DockPanel.Dock="Top" Foreground="#5B6673" Margin="12,8,12,4" TextWrapping="Wrap" Text="Ctrl + clic: selezione multipla."/>
                    <TreeView x:Name="LineTree" ItemsSource="{Binding Tree}" SelectedItemChanged="LineTree_SelectedItemChanged" BorderThickness="0">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="TreeItem_PreviewMouseLeftButtonDown"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type vm:TreeNodeViewModel}" ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding Header}" Margin="2,1" Padding="2,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMultiSelected}" Value="True">
                                                    <Setter Property="Background" Value="#CFE3F7"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel></TabItem>
                        <TabItem Header="Controllo">
                            <DockPanel Background="White">
                                <StackPanel DockPanel.Dock="Top" Margin="12,10,12,4">
                                    <TextBlock Text="Controllo equipaggiamenti" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="{Binding CheckSummary}" Foreground="#5B6573" Margin="0,2,0,8"/>
                                    <Button Style="{StaticResource PrimaryButton}" Content="🛠  Sistema automaticamente" Command="{Binding CheckEquipmentCommand}"
                                            HorizontalAlignment="Left" ToolTip="Applica le correzioni sicure agli errori elencati (le anomalie senza correzione automatica restano nell'elenco)"/>
                                </StackPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding CheckItems}" Margin="12,6">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Icon}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Stato">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding EquipmentStatus}" Margin="12,8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Text="{Binding State}" FontWeight="SemiBold" Margin="8,0,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#1B2430"/>
                                                            <Style.Triggers><DataTrigger Binding="{Binding Alarm}" Value="True"><Setter Property="Foreground" Value="#B42318"/></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>
        </Grid>
        </Grid>
    </DockPanel>
            <DockPanel Background="#F4F5F7" Visibility="{Binding CurrentSection, Converter={StaticResource EqVis}, ConverterParameter=Packages}">
                <!-- Barra superiore -->
                <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Height="56">
                    <DockPanel Margin="12,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="＋ Crea pacco" Command="{Binding NewPackageCommand}" Margin="8,0,0,0" ToolTip="Crea una nuova tipologia di pacco"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="⧉ Duplica" Command="{Binding DuplicatePackageCommand}" ToolTip="Duplica la tipologia selezionata"/>
                        <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="⌂" FontSize="18" Command="{Binding GoHomeCommand}" ToolTip="Torna alla schermata iniziale"/>
                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="Tipologie di pacco" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="Indipendenti dal layout della linea" Foreground="#5B6673" FontSize="12"/>
                        </StackPanel>
                        <Border DockPanel.Dock="Left" VerticalAlignment="Center" Margin="24,0,12,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource StepButton}" Content="1  Pacchi" Command="{Binding GoStepCommand}" CommandParameter="Packages" Tag="True"/><TextBlock Text="›" Foreground="#B6BEC8" FontSize="16" VerticalAlignment="Center"/><Button Style="{StaticResource StepButton}" Content="2  Dati area" Command="{Binding GoStepCommand}" CommandParameter="Area"/><TextBlock Text="›" Foreground="#B6BEC8" FontSize="16" VerticalAlignment="Center"/><Button Style="{StaticResource StepButton}" Content="3  Layout e simulazione" Command="{Binding GoStepCommand}" CommandParameter="Layout"/></StackPanel></Border>
                        <Grid/>
                    </DockPanel>
                </Border>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="PackageListColumn" Width="270" MinWidth="200"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Sinistra: elenco dei pacchi come schede -->
                    <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Elenco pacchi" FontSize="16" FontWeight="Bold" Margin="14,14,14,10"/>
                            <Border DockPanel.Dock="Top" Margin="14,0,14,10" Height="34" BorderBrush="#D5DAE0" BorderThickness="1" CornerRadius="8" Background="White">
                                <Grid>
                                    <TextBlock x:Name="PackageSearchHint" Text="🔍  Cerca tipologia" Foreground="#7B8794" VerticalAlignment="Center" Margin="10,0" IsHitTestVisible="False"/>
                                    <TextBox x:Name="PackageSearch" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Margin="6,0" TextChanged="PackageSearch_TextChanged" ToolTip="Cerca tipologia"/>
                                </Grid>
                            </Border>
                            <ListBox ItemsSource="{Binding PackageTypes}" SelectedItem="{Binding SelectedPackageType, Mode=TwoWay}" BorderThickness="0" Background="Transparent"
                                     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="10,0,10,10">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Margin" Value="0,0,0,8"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Padding="12,9">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#F7F9FB"/></Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#F1F7FE"/>
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Id}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Foreground="#5B6673" FontSize="12" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding LengthMm, Mode=OneWay, StringFormat={}{0:0}}"/><Run Text=" × "/><Run Text="{Binding GraphicWidthMm, Mode=OneWay, StringFormat={}{0:0}}"/><Run Text=" × "/><Run Text="{Binding GraphicHeightMm, Mode=OneWay, StringFormat={}{0:0}}"/><Run Text=" · "/><Run Text="{Binding StrapPositionsMm.Count, Mode=OneWay}"/><Run Text=" legature"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                    <Thumb Grid.Column="0" Width="6" HorizontalAlignment="Right" Cursor="SizeWE" Background="Transparent" Panel.ZIndex="20"
                           DragDelta="PackageListThumb_DragDelta" ToolTip="Trascina per allargare o stringere l'elenco pacchi"/>
                    <Thumb Grid.Column="1" Width="6" HorizontalAlignment="Right" Cursor="SizeWE" Background="Transparent" Panel.ZIndex="20"
                           DragDelta="PackagePropsThumb_DragDelta" ToolTip="Trascina per allargare o stringere le caratteristiche"
                           Visibility="{Binding ShowPackageProps, Converter={StaticResource BoolVis}}"/>
                    <!-- Colonna delle caratteristiche: si chiude e si riapre -->
                    <Grid Grid.Column="1">
                        <Border Width="{Binding PackagePropsWidth}" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0" Visibility="{Binding ShowPackageProps, Converter={StaticResource BoolVis}}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="14,12,8,4">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="«" FontSize="16" Command="{Binding TogglePackagePropsCommand}" ToolTip="Chiudi le caratteristiche"/>
                                    <TextBlock Text="Caratteristiche" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                </DockPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding PackagePropertiesView}" ItemTemplate="{StaticResource PropEditor}" Margin="16,0,16,14">
                                        <ItemsControl.GroupStyle>
                                            <GroupStyle>
                                                <GroupStyle.ContainerStyle>
                                                    <Style TargetType="GroupItem">
                                                        <Setter Property="Margin" Value="0,10,0,6"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="GroupItem">
                                                                    <StackPanel>
                                                                        <ContentPresenter/>
                                                                        <ItemsPresenter/>
                                                                    </StackPanel>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </GroupStyle.ContainerStyle>
                                                <GroupStyle.HeaderTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="#5B6673" Margin="0,0,0,4"/>
                                                    </DataTemplate>
                                                </GroupStyle.HeaderTemplate>
                                            </GroupStyle>
                                        </ItemsControl.GroupStyle>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                        <Border Width="52" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowPackageProps}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Margin="0,10,0,0">
                                <Button Style="{StaticResource IconButton}" Content="»" FontSize="16" Command="{Binding TogglePackagePropsCommand}" ToolTip="Apri le caratteristiche del pacco" HorizontalAlignment="Center"/>
                                <TextBlock Text="CARATTERISTICHE DEL PACCO" FontWeight="SemiBold" Foreground="#5B6673" Margin="0,14,0,0" HorizontalAlignment="Center">
                                    <TextBlock.LayoutTransform><RotateTransform Angle="-90"/></TextBlock.LayoutTransform>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <!-- Resto dello schermo: 3D del pacco sopra, righello 2D sotto -->
                    <Grid Grid.Column="2" Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Margin="0,0,0,14">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" BorderBrush="#EEF0F3" BorderThickness="0,0,0,1" Padding="16,10">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="🗑" Foreground="#B3261E" FontSize="16" Command="{Binding DeletePackageCommand}"
                                                ToolTip="Cestino: elimina la tipologia selezionata"/>
                                        <CheckBox DockPanel.Dock="Right" Content="Quote" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0" Checked="StrapDims_Changed" Unchecked="StrapDims_Changed" ToolTip="Mostra le distanze tra le legature"/>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="－ Togli legatura" Command="{Binding RemoveStrapCommand}" Foreground="#B3261E" Margin="0,0,8,0"
                                                ToolTip="Toglie una legatura e rimette le altre in posizione simmetrica"/>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="＋ Aggiungi legatura" Command="{Binding AddStrapCommand}" Foreground="#1E7A45" Margin="0,0,8,0"
                                                ToolTip="Aggiunge una legatura e rimette tutte in posizione simmetrica (passi di 100 mm)"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding SelectedPackageType.Id}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <Border Background="#E6F0FC" CornerRadius="12" Padding="9,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="StrapCountChip" Foreground="{StaticResource Accent}" FontWeight="SemiBold" FontSize="12"/>
                                            </Border>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <TextBlock DockPanel.Dock="Bottom" Margin="16,2,16,10" Foreground="#5B6673" FontSize="12" TextWrapping="Wrap"
                                           Text="Tieni premuto il tasto sinistro o destro sullo sfondo per ruotare · clic su una legatura (nel 3D o sul righello) e trascinala per spostarla a passi di 100 mm"/>
                                <h:HelixViewport3D x:Name="PackageViewport" ShowCoordinateSystem="False" ShowViewCube="True" Background="#F7F9FB" Margin="8,0" RotateGesture2="LeftClick"
                                                   PreviewMouseLeftButtonDown="PackageViewport_MouseDown" PreviewMouseMove="PackageViewport_MouseMove"
                                                   PreviewMouseLeftButtonUp="PackageViewport_MouseUp">
                                    <h:DefaultLights/>
                                </h:HelixViewport3D>
                            </DockPanel>
                        </Border>
                        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="16,10,16,4">
                            <StackPanel>
                                <TextBlock Text="POSIZIONE DELLE LEGATURE DALLA TESTA DEL PACCO (TRASCINA I SEGNI)" FontSize="11" FontWeight="SemiBold" Foreground="#5B6673"/>
                                <Canvas x:Name="StrapRuler" Height="62" Background="Transparent" Cursor="Hand" SizeChanged="StrapRuler_SizeChanged" ClipToBounds="True" ToolTip="Clic su una legatura e trascinala per spostarla (passi di 100 mm)"
                                        MouseLeftButtonDown="StrapRuler_MouseDown" MouseMove="StrapRuler_MouseMove" MouseLeftButtonUp="StrapRuler_MouseUp"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>