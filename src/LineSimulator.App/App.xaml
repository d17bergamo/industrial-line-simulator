<Application x:Class="LineSimulator.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Accent" Color="#1F6FB2"/>
        <SolidColorBrush x:Key="PanelBg" Color="#F4F6F8"/>
        <SolidColorBrush x:Key="Border" Color="#D0D5DB"/>
        <SolidColorBrush x:Key="HeaderBg" Color="#26323D"/>

        <Style TargetType="Button" x:Key="ToolButton">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="MinWidth" Value="28"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="SectionTitle">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#26323D"/>
            <Setter Property="Margin" Value="4,8,4,4"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="KpiValue">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="KpiLabel">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#5A6672"/>
        </Style>
    </Application.Resources>
</Application>
