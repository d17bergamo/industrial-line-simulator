<Window x:Class="LineSimulator.App.SpeedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Velocità di linea e produttività" Width="400" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" WindowStartupLocation="Manual" Background="White">
    <StackPanel Margin="14">
        <TextBlock Text="Velocità di trasporto" FontWeight="SemiBold" FontSize="14"/>
        <TextBlock Foreground="#5A6672" TextWrapping="Wrap" Margin="0,2,0,8"
                   Text="Valore libero tra 0,5 e 1,5 m/s. La modifica vale subito, anche con la simulazione in corso."/>
        <DockPanel>
            <TextBox DockPanel.Dock="Right" Width="64" Margin="10,0,0,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Right"
                     Text="{Binding LineSpeedMps, StringFormat={}{0:0.00}, UpdateSourceTrigger=LostFocus, Mode=TwoWay}"
                     KeyDown="Box_KeyDown"/>
            <TextBlock DockPanel.Dock="Right" Text="m/s" VerticalAlignment="Center" Margin="4,0,0,0"/>
            <Slider Minimum="{Binding MinLineSpeed, Mode=OneWay}" Maximum="{Binding MaxLineSpeed, Mode=OneWay}"
                    Value="{Binding LineSpeedMps, Mode=TwoWay}" TickFrequency="0.1" IsSnapToTickEnabled="False"
                    SmallChange="0.01" LargeChange="0.1" TickPlacement="BottomRight" VerticalAlignment="Center"/>
        </DockPanel>
        <Border Margin="0,12,0,0" Padding="10" Background="#F2F5F8" BorderBrush="#D0D4D9" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Produttività oraria" FontWeight="SemiBold"/>
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding ProductivityText}"/>
            </StackPanel>
        </Border>
        <Button Content="Chiudi" HorizontalAlignment="Right" Padding="16,3" Margin="0,12,0,0" IsCancel="True" IsDefault="True" Click="Close_Click"/>
    </StackPanel>
</Window>
